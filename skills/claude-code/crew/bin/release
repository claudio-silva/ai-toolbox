#!/usr/bin/env bash
# Cut a Crew release: notes in RELEASES.md, a release commit, an annotated tag. Never pushes.
#
#   bin/release <version | major | minor | patch> [--dry-run] [--no-ai] [--yes]
#
# The release holds every commit that touched this directory since the previous release: the
# commit that added the previous version's heading to RELEASES.md (found with git log -S, so it
# survives moving Crew to its own repository). Haiku drafts the notes from those commit messages,
# rewritten for users; you accept, edit, regenerate or quit before anything is written.
#
#   --dry-run  print the commits and the draft; change nothing
#   --no-ai    start from an empty draft in $EDITOR, with the commits listed for reference
#   --yes      accept the draft without asking (needed when stdin is not a terminal)
#
# Tags are crew-v<version> while Crew lives inside another repository, v<version> once it is the
# repository's root (CREW_TAG_PREFIX overrides). Needs git, and the claude CLI unless --no-ai.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NOTES="$HERE/RELEASES.md"
cd "$HERE"

die() { printf 'release: %s\n' "$*" >&2; exit 1; }

want="" dry=0 ai=1 yes=0
for a in "$@"; do
  case "$a" in
    --dry-run) dry=1 ;;
    --no-ai) ai=0 ;;
    --yes|-y) yes=1 ;;
    -h|--help) sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $a" ;;
    *) [[ -z "$want" ]] || die "one version only"; want="$a" ;;
  esac
done
[[ -n "$want" ]] || die "usage: bin/release <version | major | minor | patch> [--dry-run] [--no-ai] [--yes]"

git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"
prefix="$(git rev-parse --show-prefix)"        # "skills/claude-code/crew/", or "" when standalone
if [[ -n "$prefix" ]]; then
  tag_prefix="${CREW_TAG_PREFIX:-crew-v}" subject="crew: release"
else
  tag_prefix="${CREW_TAG_PREFIX:-v}" subject="Release"
fi

# --- versions ---------------------------------------------------------------

current="$(grep -m1 -E '^## +v?[0-9]+\.[0-9]+\.[0-9]+' "$NOTES" 2>/dev/null | sed -E 's/^## +v?([^ ]+).*/\1/' || true)"
IFS=. read -r ma mi pa <<<"${current:-0.0.0}"
pa="${pa%%-*}"
case "$want" in
  major) next="$((ma + 1)).0.0" ;;
  minor) next="$ma.$((mi + 1)).0" ;;
  patch) next="$ma.$mi.$((pa + 1))" ;;
  *) next="${want#v}" ;;
esac
[[ "$next" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || die "not a version: $want"
if [[ -n "$current" ]]; then
  newest="$(printf '%s\n%s\n' "$current" "$next" | sort -V | tail -1)"
  [[ "$next" != "$current" && "$newest" == "$next" ]] || die "$next is not newer than $current"
fi
tag="$tag_prefix$next"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "tag $tag already exists"

# --- the commits in this release --------------------------------------------

since=""
if [[ -n "$current" ]]; then
  since="$(git rev-parse -q --verify "refs/tags/$tag_prefix$current^{commit}" 2>/dev/null || true)"
  [[ -n "$since" ]] || since="$(git log -1 --format=%H -S"## $current " -- RELEASES.md)"
  [[ -n "$since" ]] || die "can't find the commit of release $current: commit RELEASES.md first"
fi
range="${since:+$since..}HEAD"
log="$(git log --reverse --no-merges --format='--- %h %ad%n%s%n%n%b' --date=short "$range" -- .)"
count="$(git rev-list --count --no-merges "$range" -- .)"
[[ "$count" -gt 0 ]] || die "no commits since ${current:-the start}"

if [[ $dry -eq 0 ]]; then
  [[ -z "$(git status --porcelain -- .)" ]] || die "uncommitted changes here; commit or stash them first"
  [[ -t 0 || $yes -eq 1 ]] || die "stdin is not a terminal: pass --yes, or --dry-run"
fi

printf 'Crew %s → %s (%s commit%s since %s)\n' "${current:-none}" "$next" "$count" "$([[ $count == 1 ]] || echo s)" "$([[ -n "$since" ]] && echo "${since:0:7}" || echo "the start")"
[[ $dry -eq 1 ]] && printf '\n%s\n' "$(git log --reverse --no-merges --format='  %h %s' "$range" -- .)"

# --- the draft ----------------------------------------------------------------

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
draft="$tmp/draft.md"

read -r -d '' BRIEF <<'TXT' || true
You write the release notes for Crew, a Claude Code skill that runs a software team for a founder: the main session leads, and subagents (planner, builders, reviewers, QA and others) do the work, with a live dashboard in the browser.

You get the commit messages of one release, oldest first. Write what changed for the people who use Crew, not for the people who develop it:
- Rewrite everything at a higher level: what users can now do, or what now behaves differently, and why it matters. Never copy commit subjects, never list commits, and leave out files, functions, internal scripts, tests and refactors that users can't see.
- Group related changes into a few themes, 2 to 6, most important first. Each theme is one bullet: a short bold name, then one or two plain sentences.
- Plain, concrete and calm: no marketing words, no emoji, no exclamation marks.
- After updating, users already run /crew setup in each project. Only if they must do something more (restart Claude Code, change a setting, migrate a file), end with one line starting "**After updating:**".
- Output only the Markdown bullets and that optional line: no heading, version, date or preamble.
TXT

PLACEHOLDER="- **Theme.** What users can now do, and why it matters."

generate() {
  if [[ $ai -eq 0 ]]; then
    { echo "$PLACEHOLDER"; echo
      echo "<!-- The commits in this release (lines in comments are dropped):"; echo "$log" | sed 's/-->/—>/g'; echo "-->"; } >"$draft"
    return
  fi
  command -v claude >/dev/null || die "the claude CLI is not on PATH (or pass --no-ai)"
  printf 'Asking Haiku for a draft…\n' >&2
  # From an empty directory, so no project's CLAUDE.md, hooks or settings load.
  (cd "$tmp" && printf 'The commits:\n\n%s\n' "$log" |
    claude -p --model haiku --effort high --tools "" --no-session-persistence --system-prompt "$BRIEF") >"$draft" ||
    die "claude failed; try again, or pass --no-ai"
}

clean() { perl -0pe 's/<!--.*?-->//gs; s/\A\s+//; s/\s+\z/\n/' "$draft"; }

generate
while :; do
  printf '\n%s\n' "$(clean)"
  [[ $dry -eq 1 ]] && { printf '\n(dry run: nothing written)\n'; exit 0; }
  [[ $yes -eq 1 ]] && break
  read -r -p $'\n[a]ccept, [e]dit, [r]egenerate, [q]uit? ' ans
  case "$ans" in
    a|A) break ;;
    e|E) ${VISUAL:-${EDITOR:-vi}} "$draft" ;;
    r|R) generate ;;
    q|Q) echo "Nothing written."; exit 0 ;;
  esac
done
body="$(clean)"
[[ -n "$body" ]] || die "empty notes; nothing written"
[[ "$body" != *"$PLACEHOLDER"* ]] || die "the draft still has the placeholder; nothing written"

# --- write, commit, tag ---------------------------------------------------------

entry="$tmp/entry.md"
printf '## %s — %s\n\n%s\n\n' "$next" "$(date +%F)" "$body" >"$entry"
if [[ -f "$NOTES" ]] && grep -q '^## ' "$NOTES"; then
  awk -v f="$entry" '!done && /^## / { while ((getline l < f) > 0) print l; done = 1 } { print }' "$NOTES" >"$tmp/new"
elif [[ -f "$NOTES" ]]; then
  { cat "$NOTES"; echo; cat "$entry"; } >"$tmp/new"
else
  { printf '# Crew releases\n\nWhat changed in each release, newest first.\n\n'; cat "$entry"; } >"$tmp/new"
fi
mv "$tmp/new" "$NOTES"

git add -- RELEASES.md
git commit -q -m "$subject $next" -- RELEASES.md
{ printf 'Crew %s\n\n' "$next"; printf '%s\n' "$body"; } | git tag -a "$tag" -F -

printf '\nReleased %s: committed RELEASES.md and tagged %s (nothing pushed).\n' "$next" "$tag"
printf 'Publish it with:\n  git push && git push origin %s\n' "$tag"
printf 'The dashboards of projects on an older Crew show the notice within a day of the push.\n'
