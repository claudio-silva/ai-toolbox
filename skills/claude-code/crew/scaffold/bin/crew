#!/usr/bin/env bash
# crew: journal, hook handler, dashboard launcher and worktree helper for the crew skill.
#
# Installed by `/crew setup` as <project>/.crew/bin/crew. Compatible with bash 3.2
# (macOS /bin/bash): no associative arrays, no ${var,,}, no mapfile.
#
# Modes
#   crew journal <text...>              Log a lead action: "- HH:MM · lead · <text>".
#   crew request "<text>" [--affects <x>] [--slot <y>] [--urgent] [--backlog] [--dry-run]
#                                       Queue a founder request as the next R<n> (numbers are
#                                       project-wide) in the queue of the task set open in this
#                                       checkout (.crew/tasks/<slug>/queue.md), or in the backlog
#                                       (.crew/queue.md) when none is open or with --backlog, and
#                                       journal it.
#   crew request R<n> --status queued|scheduled|done|dropped [--slot <y>] [--affects <x>] [--note <t>]
#                                       Move a request along; journals the transition.
#   crew defect "<symptom>" --where <surface> [--from <x>] [--severity low|medium] [--slot <y>] [--backlog] [--dry-run]
#                                       Defer a leaf defect as the next D<n> in the set's defect log
#                                       (.crew/tasks/<slug>/defects.md; else .crew/defects.md), and
#                                       journal it.
#   crew defect D<n> --status deferred|scheduled|fixed|dropped [--promote] [--slot <y>] [--note <t>]
#                                       Move a defect along; --promote marks one that bit other
#                                       work (status scheduled). The note stays on the line
#                                       ("note: as T13"). Journals the transition.
#   crew carry                          Closing a set: move its open requests, questions and
#                                       defects to the backlog (.crew/queue.md, .crew/defects.md).
#   crew where                          This checkout: its branch, the task set open in it, the
#                                       files of that set (queue, defects, handoff) and the other
#                                       leads and open sets.
#   crew session start [<session-id>] [--take-over]
#                                       Register this session as the lead of its checkout (empty
#                                       id: wildcard "any"), record its Claude Code process, close
#                                       the runs of subagents whose process has ended, mark the
#                                       lead as working, keep the computer awake while Claude Code
#                                       runs (macOS caffeinate; CREW_KEEP_AWAKE=0 turns it off),
#                                       start the dashboard and print `crew where`. Prints "Open
#                                       the dashboard at <url>" when this session started it, here
#                                       or through its SessionStart hook. Exit status 4, and
#                                       nothing registered, when another session's Claude Code
#                                       still leads this checkout; --take-over makes this session
#                                       the lead instead (refused while that one has agents
#                                       running).
#   crew session stop [<session-id>]    Mark this session's crew as stopped by the founder
#                                       (/crew stop) and let the computer sleep again, as far as
#                                       this session is concerned.
#   crew running [--all]                List this session's running subagents (kept by the hooks);
#                                       --all: every session's.
#   crew status                         Settle pending compaction records, sample the clock,
#                                       make sure the dashboard runs and print its URL.
#   crew dashboard [start|stop|restart|url]
#                                       The dashboard: a local web page served by
#                                       .crew/dashboard/server.mjs (Node.js 20+), live over
#                                       Server-Sent Events. `start` (the default) prints its URL,
#                                       or nothing and exit status 3 when one already runs for
#                                       this project. The URL is for other devices too: the
#                                       local network address and the project's key.
#                                       CREW_DASHBOARD=0 keeps session start, status and the
#                                       SessionStart hook from starting it; CREW_DASHBOARD_LAN=0
#                                       keeps it on 127.0.0.1.
#   crew dashboard updates [--check] [--simulate | --reset]
#                                       This copy's version and the latest release. --check asks
#                                       now; --simulate makes the latest release count as new, so
#                                       the page shows its update notice (testing); --reset ends it.
#   crew worktree setup [<path>] [--dry-run]
#                                       Prepare a worktree: .worktreeinclude copies,
#                                       .crew/tmp/, .crew/task-data/, worktree.json,
#                                       then .crew/worktree/setup.sh.
#   crew worktree teardown <path> [--dry-run]
#                                       Harvest task data and journal lines into the main
#                                       checkout, run .crew/worktree/teardown.sh, remove
#                                       the worktree and its branch.
#   crew hook <mode>                    Claude Code hook handler; reads the hook JSON on
#                                       stdin. Modes: agent-start (PreToolUse Agent),
#                                       agent-resume (PreToolUse SendMessage), agent-id
#                                       (SubagentStart), agent-stop (SubagentStop),
#                                       file-changed (PostToolUse Edit|Write), lead-busy
#                                       (UserPromptSubmit), lead-idle (Stop), session-start
#                                       (SessionStart startup|resume|clear|fork), pre-compact
#                                       (PreCompact), compact (SessionStart compact).
#
# Rules that matter
#   - Every `crew hook` mode exits 0, whatever happens: exit 2 from a PreToolUse hook
#     would block the tool call, and from a Stop hook would keep the lead from stopping.
#     A hook that fails a guard prints nothing and changes no file.
#   - Hook modes need jq. Everything else works without it.
#   - The journal and the state under tmp/ live in the main checkout of the repository (root
#     resolution below), so hooks running in worktrees write one journal and one state per
#     repository. A task set's files live in the checkout where its branch is checked out.
#   - Hooks never read a whole transcript: tail, grep and jq on bounded ranges only.
#   - Set CREW_DEBUG=1 to see stderr from hook modes.
#
# Compactions (Claude Code 2.1.303, verified 2026-10-20)
#   - PreCompact, SessionStart(compact) and PostCompact fire inside subagents too, but their
#     input carries the parent's session id and the MAIN transcript path, and no agent_id or
#     agent_type. The input cannot say who compacted. `pre-compact` guesses it from the
#     transcripts (the agent whose newest API response carried the largest context is the one
#     that hit its window) and `compact` cross-checks the input's `model` against the lead's
#     model recorded by `session-start`. When unsure, the reminder is phrased for both roles;
#     a subagent never receives the lead's instructions.
#   - The compact_boundary record (preTokens, postTokens, durationMs, trigger) is written to
#     the transcript AFTER the compaction hooks have run, so the detailed journal line and the
#     compaction log are written by the next crew event ("settling"), with the compaction's
#     own local time.
#
# Timing and sleep (read by the dashboard's Timing tab)
#   - Every subagent run (a start or a resume, to its stop) is one line in
#     tmp/journal-state/runs.tsv: start, end, agent id, type, task number (from the
#     description's leading T<NN>), first|resume, status keyword, the lead's session, the task
#     set (its folder name; empty when none).
#   - The leads' state changes (working at a prompt, idle at its Stop, stopped) are lines in
#     tmp/journal-state/lead.tsv: epoch, state, session, task set. Time with a lead working and
#     no subagent running is the lead's own time.
#   - Each session's Claude Code process id and its start time are kept in
#     tmp/journal-state/claude/<session>, and
#     each running subagent's session in running/<id>. Subagents run inside that process: when
#     it is gone (Claude Code quit or crashed), its subagents are no longer running. The next
#     `crew session start`, or the session's next SessionStart in a new process, records their
#     runs as "interrupted", ending at their transcript's last write.
#   - Every crew event samples two clocks: the wall clock and the awake-time clock (macOS: the
#     mach absolute clock, which stops while the computer sleeps). Wall time minus awake time
#     between two samples is time asleep; 2 min or more is journaled and kept in
#     tmp/journal-state/sleep.tsv. Runs start and end at crew events, so each sleep interval
#     lies wholly inside or wholly outside any run. Elsewhere sleep is not measured.
#
# Leads (one per checkout)
#   - A lead is a session that ran `crew session start`; sessions/<session> holds its checkout
#     (the main checkout or a linked worktree). A task set's branch can be checked out in one
#     place only, so one lead per checkout is also one lead per set. Another session starting in
#     a checkout whose lead's Claude Code still runs is refused unless it takes over; the session
#     it replaces (and any whose Claude Code is gone) moves to superseded/<session>, and its next
#     prompt tells it it is no longer the lead.
#   - Per lead: leads/<session> (its state: working, idle or stopped, with when), awake/<session>
#     (its caffeinate). Each subagent's agents/<id> record names its session and task set.
#
# The dashboard
#   - This script records state (journal, runs, sleeps, agents, the lead, compactions);
#     .crew/dashboard/model.mjs reads it and computes everything the page shows. Nothing here
#     renders. The server watches .crew/ and git, so no hook needs to tell it anything; it waits
#     while journal.lock is held, so it never reads a half-written state.
#   - The founder can message the lead from the dashboard. Each session's way in is kept in
#     tmp/journal-state/reach/<session> (owner-only): its Paseo agent id when Paseo runs it, else
#     its cross-session inbox socket and token. Hooks and `crew session start` record it from
#     the environment Claude Code gives them.

# Make sure git acts on the directories we name, not on an inherited repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

US=$'\037'   # field separator for internal records (never collapses empty fields)
TAB=$'\t'
NL=$'\n'

# ---------------------------------------------------------------------------
# Paths and root resolution
# ---------------------------------------------------------------------------

# Print the main worktree (main checkout) of the repository containing $1.
main_worktree_of() {
  local common
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ -n "$common" ] || return 1
  case $common in
    */.git) dirname "$common" ;;
    # A bare repository or a submodule (.git/modules/<name>): use the checkout itself.
    *) git -C "$1" rev-parse --show-toplevel 2>/dev/null ;;
  esac
}

# Root resolution (D-H6): CLAUDE_PROJECT_DIR's main worktree, else the main worktree of
# the repository containing this script, else two directories above the script.
resolve_root() {
  local script_dir r=""
  script_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P) || script_dir=$(dirname "$0")
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    r=$(main_worktree_of "$CLAUDE_PROJECT_DIR") || r=""
    [ -n "$r" ] || r=$CLAUDE_PROJECT_DIR
  else
    r=$(main_worktree_of "$script_dir") || r=""
    [ -n "$r" ] || r="$script_dir/../.."
  fi
  ROOT=$(cd "$r" 2>/dev/null && pwd -P) || ROOT=$r
}

set_paths() {
  CREW_DIR="$ROOT/.crew"
  TMP_DIR="$CREW_DIR/tmp"
  STATE="$TMP_DIR/journal-state"
  JOURNAL="$CREW_DIR/journal.md"
  LOCK="$TMP_DIR/journal.lock"
  RUNS="$STATE/runs.tsv"
  SLEEPS="$STATE/sleep.tsv"
}

ensure_dirs() {
  mkdir -p "$TMP_DIR" "$CREW_DIR/task-data" "$STATE/sessions" "$STATE/pending" \
    "$STATE/agents" "$STATE/running" "$STATE/transcripts" "$STATE/lead-model" \
    "$STATE/compact/scan" "$STATE/index-rows" "$STATE/set-start" "$STATE/claude" \
    "$STATE/leads" "$STATE/awake" "$STATE/superseded" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Small text helpers
# ---------------------------------------------------------------------------

# A UTF-8 locale for character-accurate truncation (hooks may run with LANG unset).
UTF8_LOCALE=""
UTF8_PICKED=0
pick_utf8() {
  local l
  UTF8_PICKED=1
  for l in C.UTF-8 en_US.UTF-8 C.utf8 en_US.utf8; do
    # shellcheck disable=SC2030,SC2031  # the subshell only probes whether the locale works
    if (LC_ALL=$l; t='→'; [ ${#t} -eq 1 ]) 2>/dev/null; then UTF8_LOCALE=$l; return; fi
  done
}

# oneline TEXT -> sets REPLY to TEXT with newlines, CRs and tabs replaced by spaces.
oneline() {
  REPLY=${1//$'\r'/ }
  REPLY=${REPLY//$NL/ }
  REPLY=${REPLY//$TAB/ }
}

# trunc TEXT MAX -> sets REPLY to TEXT cut to MAX characters (ending in an ellipsis).
trunc() {
  [ "$UTF8_PICKED" = 1 ] || pick_utf8
  if [ -n "$UTF8_LOCALE" ]; then local LC_ALL=$UTF8_LOCALE; fi
  REPLY=$1
  if [ ${#REPLY} -gt "$2" ]; then REPLY="${REPLY:0:$(($2 - 1))}…"; fi
}

# safe_name TEXT -> sets REPLY to TEXT usable as a file name.
safe_name() {
  REPLY=$(printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_')
  case $REPLY in ''|.|..) REPLY="_$REPLY" ;; esac
}

now_parts() {  # sets NOW_DAY (YYYY-MM-DD), NOW_HM (HH:MM), NOW_EPOCH
  local d
  d=$(date '+%Y-%m-%d %H:%M %s')
  NOW_DAY=${d%% *}; d=${d#* }
  NOW_HM=${d%% *}; NOW_EPOCH=${d#* }
}

# iso_to_epoch "2026-10-20T07:30:54.318Z" -> REPLY epoch seconds (empty when unparsable).
# The system's date does the conversion (BSD form first, then GNU), never arithmetic by hand.
iso_to_epoch() {
  local t=${1%%.*}
  t=${t%Z}
  REPLY=$(date -u -j -f '%Y-%m-%dT%H:%M:%S' "$t" '+%s' 2>/dev/null) ||
    REPLY=$(date -u -d "${t}Z" '+%s' 2>/dev/null) || REPLY=""
  case $REPLY in ''|*[!0-9]*) REPLY="" ;; esac
}

# epoch_to_hm EPOCH -> REPLY local HH:MM; epoch_to_day EPOCH -> REPLY local YYYY-MM-DD.
epoch_to_hm() { REPLY=$(date -r "$1" '+%H:%M' 2>/dev/null || date -d "@$1" '+%H:%M' 2>/dev/null); }
epoch_to_day() { REPLY=$(date -r "$1" '+%Y-%m-%d' 2>/dev/null || date -d "@$1" '+%Y-%m-%d' 2>/dev/null); }

# file_size PATH -> prints the size in bytes (fails when the file is missing).
file_size() { stat -f %z "$1" 2>/dev/null || stat -c %s "$1" 2>/dev/null; }
file_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }

# fmt_k 166954 -> REPLY "167k"; fmt_secs 6600 -> REPLY "1 h 50 min".
fmt_k() { REPLY=$(awk -v n="${1:-0}" 'BEGIN { if (n >= 1000) printf "%dk", int(n / 1000 + 0.5); else printf "%d", n }'); }
fmt_secs() {
  local s=${1:-0}
  case $s in ''|*[!0-9]*) s=0 ;; esac
  if [ "$s" -lt 100 ]; then REPLY="$s s"
  elif [ "$s" -lt 3600 ]; then REPLY="$((s / 60)) min"
  else REPLY="$((s / 3600)) h $(((s % 3600) / 60)) min"; fi
}

# ---------------------------------------------------------------------------
# Lock (mkdir is atomic). Re-entrant within one process.
# ---------------------------------------------------------------------------

LOCK_HELD=0
lock_take() {
  local i=0
  [ "$LOCK_HELD" = 1 ] && return 0
  mkdir -p "$TMP_DIR" 2>/dev/null
  while ! mkdir "$LOCK" 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -ge 50 ]; then
      # Could not get the lock: carry on without it. A lock older than a minute was
      # left by a killed process; clear it so later writers do not wait again.
      if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "$LOCK" 2>/dev/null; fi
      return 1
    fi
    sleep 0.1
  done
  LOCK_HELD=1
}
lock_release() {
  if [ "$LOCK_HELD" = 1 ]; then rmdir "$LOCK" 2>/dev/null; LOCK_HELD=0; fi
}
trap lock_release EXIT
trap 'lock_release; exit 0' HUP INT TERM

# ---------------------------------------------------------------------------
# Journal
# ---------------------------------------------------------------------------

# The writer's branch suffix " [<branch>]" when WRITER_CWD is in a linked worktree of
# this repository; empty otherwise. Sets SUFFIX.
writer_suffix() {
  local out gd cd br
  SUFFIX=""
  [ -n "${WRITER_CWD:-}" ] && [ -d "$WRITER_CWD" ] || return 0
  out=$(git -C "$WRITER_CWD" rev-parse --path-format=absolute --git-dir --git-common-dir \
    --abbrev-ref HEAD 2>/dev/null) || return 0
  gd=$(printf '%s\n' "$out" | sed -n 1p)
  cd=$(printf '%s\n' "$out" | sed -n 2p)
  br=$(printf '%s\n' "$out" | sed -n 3p)
  [ -n "$gd" ] && [ "$gd" != "$cd" ] || return 0
  [ "$(dirname "$cd")" = "$ROOT" ] || return 0
  if [ "$br" = HEAD ] || [ -z "$br" ]; then
    br=$(git -C "$WRITER_CWD" rev-parse --short HEAD 2>/dev/null) || br=detached
  fi
  SUFFIX=" [$br]"
}

# Create the journal if missing and add today's heading if the last one is another day.
# Call with the lock held (or after failing to get it).
journal_open_today() {
  if [ ! -s "$JOURNAL" ]; then
    printf '%s\n\n%s\n' "# Crew journal" \
      "Informational history of crew activity, newest at the bottom. Not committed." > "$JOURNAL"
  fi
  local last
  last=$(grep -E '^## [0-9]{4}-[0-9]{2}-[0-9]{2}' "$JOURNAL" 2>/dev/null | tail -n 1)
  if [ "$last" != "## $NOW_DAY" ]; then printf '\n## %s\n' "$NOW_DAY" >> "$JOURNAL"; fi
}

# journal_append HEAD TEXT: append "- HH:MM · HEAD[ [branch]] · TEXT".
# JOURNAL_AT=<epoch> in the environment dates the line at that moment instead of now (used
# for compactions, which are logged when their record becomes readable). An earlier day is
# written as "YYYY-MM-DD HH:MM".
journal_append() {
  local head text when
  oneline "$1"; head=$REPLY
  oneline "$2"; text=$REPLY
  ensure_dirs
  lock_take
  now_parts
  writer_suffix
  journal_open_today
  when=$NOW_HM
  if [ -n "${JOURNAL_AT:-}" ]; then
    epoch_to_hm "$JOURNAL_AT"; when=$REPLY
    epoch_to_day "$JOURNAL_AT"
    [ "$REPLY" = "$NOW_DAY" ] || when="$REPLY $when"
  fi
  if [ -n "$text" ]; then
    printf '%s\n' "- $when · $head$SUFFIX · $text" >> "$JOURNAL"
  else
    printf '%s\n' "- $when · $head$SUFFIX" >> "$JOURNAL"
  fi
}

# ---------------------------------------------------------------------------
# Clocks: sleep detection and keep-awake (see "Timing and sleep" in the header)
# ---------------------------------------------------------------------------

# awake_secs -> REPLY: seconds of awake time since boot, from the mach absolute clock (the
# second field of kern.monotonicclock_usecs, in ticks of hw.tbfrequency); "" where unknown.
awake_secs() {
  local out freq ticks
  REPLY=""
  out=$(sysctl -n hw.tbfrequency kern.monotonicclock_usecs 2>/dev/null) || return 0
  freq=$(printf '%s\n' "$out" | sed -n 1p)
  ticks=$(printf '%s\n' "$out" | sed -n 2p | awk '{ print $2 }')
  case "$freq" in ''|*[!0-9]*) return 0 ;; esac
  case "$ticks" in ''|*[!0-9]*) return 0 ;; esac
  [ "$freq" -gt 0 ] || return 0
  REPLY=$((ticks / freq))
}

# clock_sample: compare the wall clock and the awake-time clock with the previous crew event's
# sample; 2 min or more of difference is time asleep: log it in sleep.tsv and the journal.
clock_sample() {
  local awake pwall="" pawake="" slept from to
  awake_secs
  [ -n "$REPLY" ] || return 0
  awake=$REPLY
  ensure_dirs
  lock_take
  now_parts
  { read -r pwall pawake < "$STATE/clock"; } 2>/dev/null
  printf '%s %s\n' "$NOW_EPOCH" "$awake" > "$STATE/clock" 2>/dev/null
  case "$pwall" in ''|*[!0-9]*) return 0 ;; esac
  case "$pawake" in ''|*[!0-9]*) return 0 ;; esac
  # The awake clock went back: a reboot since the last sample; nothing to measure.
  [ "$awake" -ge "$pawake" ] || return 0
  slept=$(( (NOW_EPOCH - pwall) - (awake - pawake) ))
  [ "$slept" -ge 120 ] || return 0
  printf '%s\t%s\t%s\n' "$pwall" "$NOW_EPOCH" "$slept" >> "$SLEEPS"
  epoch_to_hm "$pwall"; from=$REPLY
  epoch_to_day "$pwall"
  [ "$REPLY" = "$NOW_DAY" ] || from="$REPLY $from"
  to=$NOW_HM
  fmt_secs "$slept"
  journal_append "system" "The computer slept $REPLY between $from and $to (crew events stop while it sleeps)"
}

# keep_awake_stop SESSION: end the caffeinate that SESSION started, if it is still running.
# Without SESSION: the one an older crew kept for the whole project (tmp/journal-state/keep-awake).
keep_awake_stop() {
  local pid _rest f="$STATE/keep-awake"
  if [ -n "${1:-}" ]; then safe_name "$1"; f="$STATE/awake/$REPLY"; fi
  [ -f "$f" ] || return 0
  read -r pid _rest < "$f" 2>/dev/null
  rm -f "$f"
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac
  case $(ps -o args= -p "$pid" 2>/dev/null) in *caffeinate*) kill "$pid" 2>/dev/null ;; esac
  return 0
}

# claude_pid -> REPLY: the Claude Code process this command runs under, found by walking up
# the process tree; empty when there is none. CREW_CLAUDE_PID overrides it (tests).
claude_pid() {
  local pid=$PPID comm args i
  REPLY=${CREW_CLAUDE_PID:-}
  [ -z "$REPLY" ] || return 0
  for i in 1 2 3 4 5 6 7 8; do
    case "$pid" in ''|*[!0-9]*) break ;; esac
    [ "$pid" -gt 1 ] || break
    comm=$(ps -o comm= -p "$pid" 2>/dev/null)
    args=$(ps -o args= -p "$pid" 2>/dev/null)
    case "${comm##*/} $args" in
      'claude '*|*claude-code*|*@anthropic-ai/claude*) REPLY=$pid; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
}

# claude_alive PID [START]: the process runs and is Claude Code; with START (the epoch it
# started, as recorded), the same process, not a later one that reused its pid.
claude_alive() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$1" 2>/dev/null || return 1
  case $(ps -o args= -p "$1" 2>/dev/null) in *claude*) ;; *) return 1 ;; esac
  case "${2:-}" in ''|*[!0-9]*) return 0 ;; esac
  proc_start "$1"
  case "$REPLY" in ''|*[!0-9]*) return 0 ;; esac
  [ $((REPLY - $2)) -le 3 ] && [ $(($2 - REPLY)) -le 3 ]
}

# proc_start PID -> REPLY: the epoch at which the process started (from its elapsed time,
# [[dd-]hh:]mm:ss, so to the second); "" when unknown.
proc_start() {
  local e
  REPLY=""
  e=$(ps -o etime= -p "$1" 2>/dev/null | tr -d ' ')
  [ -n "$e" ] || return 0
  REPLY=$(printf '%s\n' "$e" | awk -v now="$(date +%s)" '{
    d = 0; t = $0; i = index(t, "-")
    if (i) { d = substr(t, 1, i - 1); t = substr(t, i + 1) }
    n = split(t, p, ":"); s = 0
    for (k = 1; k <= n; k++) s = s * 60 + p[k]
    print now - (d * 86400 + s) }')
  case "$REPLY" in ''|*[!0-9]*) REPLY="" ;; esac
}

# session_alive SESSION: the Claude Code process recorded for SESSION still runs.
session_alive() {
  local pid start
  safe_name "$1"
  read -r pid start < "$STATE/claude/$REPLY" 2>/dev/null
  claude_alive "$pid" "$start"
}

# keep_awake_start SESSION: hold a caffeinate assertion (-i: no idle sleep; -s: no system sleep
# on AC power) for as long as the Claude Code process that runs SESSION lives; 12 hours when it
# cannot be found. Closing the lid on battery still sleeps a Mac. Writes "<caffeinate pid>
# <watched pid | 12h>" to $STATE/awake/<SESSION>.
keep_awake_start() {
  local target
  keep_awake_stop "$1"
  keep_awake_stop
  [ "${CREW_KEEP_AWAKE:-1}" != 0 ] || return 0
  command -v caffeinate >/dev/null 2>&1 || return 0
  claude_pid; target=$REPLY
  if [ -n "$target" ]; then
    nohup caffeinate -i -s -w "$target" >/dev/null 2>&1 &
  else
    nohup caffeinate -i -s -t 43200 >/dev/null 2>&1 &
  fi
  safe_name "$1"
  printf '%s %s\n' "$!" "${target:-12h}" > "$STATE/awake/$REPLY"
}

# note_claude SESSION: record the Claude Code process running SESSION in $STATE/claude/<SESSION>,
# so the dashboard can tell a crew that stopped with it from one at work. When the session had
# another process before (a restart or --resume), the subagents it was running ended with it.
note_claude() {
  local f="$STATE/claude/$1" old="" _rest pid
  [ -n "$1" ] || return 0
  claude_pid
  pid=$REPLY
  [ -n "$pid" ] || return 0
  read -r old _rest < "$f" 2>/dev/null
  [ "$old" != "$pid" ] || return 0
  proc_start "$pid"
  printf '%s %s\n' "$pid" "$REPLY" > "$f"
  [ -z "$old" ] || reap_orphans "$1"
}

# note_reach SESSION: how the dashboard can send the founder's messages to this session, from
# the environment Claude Code gives hooks and the commands it runs: in Paseo, its agent id (the
# `paseo send` route); otherwise the session's cross-session inbox socket and its token (Claude
# Code 2.1.224+). One line, tab-separated: socket, token, Paseo agent id, Paseo CLI. Owner-only:
# the token is what lets a message reach a session that runs without permission prompts.
note_reach() {
  local f="$STATE/reach/$1" line paseo=${PASEO_AGENT_ID:-} parent
  [ -n "$1" ] || return 0
  # A Claude Code started by hand in a Paseo agent's terminal inherits that agent's id: the id
  # is this session's only when Paseo's daemon itself runs this Claude Code.
  if [ -n "$paseo" ]; then
    claude_pid
    parent=$(ps -o ppid= -p "${REPLY:-0}" 2>/dev/null | tr -d ' ')
    case $(ps -o comm= -p "${parent:-0}" 2>/dev/null) in *[Pp]aseo*) ;; *) paseo="" ;; esac
  fi
  [ -n "${CLAUDE_CODE_MESSAGING_SOCKET:-}$paseo" ] || return 0
  line="${CLAUDE_CODE_MESSAGING_SOCKET:-}$TAB${CLAUDE_CODE_MESSAGING_TOKEN:-}$TAB$paseo$TAB${paseo:+${PASEO_CLI:-}}"
  [ "$(cat "$f" 2>/dev/null)" != "$line" ] || return 0
  mkdir -p "$STATE/reach" 2>/dev/null && chmod 700 "$STATE/reach" 2>/dev/null
  (umask 077; printf '%s\n' "$line" > "$f.new" && mv -f "$f.new" "$f") 2>/dev/null
}

# reap_orphans [SESSION]: close the runs of subagents whose Claude Code process has ended
# (subagents run inside it, so they ended too): recorded as "interrupted" at their transcript's
# last write, and journaled. With SESSION, that session's subagents; without, those of every
# session whose recorded process is gone.
reap_orphans() {
  local f id sess pid tp at start
  for f in "$STATE/running"/*; do
    [ -e "$f" ] || continue
    id=${f##*/}
    sess=$(cat "$f" 2>/dev/null)
    [ -n "$sess" ] || continue
    if [ -n "${1:-}" ]; then
      [ "$sess" = "$1" ] || continue
    else
      pid=""; read -r pid _ < "$STATE/claude/$sess" 2>/dev/null
      [ -n "$pid" ] || continue
      session_alive "$sess" && continue
    fi
    load_agent "$id" || A_TYPE=unknown
    start=${A_RUN_START:-$A_STARTED}
    tp=$(cat "$STATE/transcripts/$sess" 2>/dev/null)
    at=""
    [ -z "$tp" ] || at=$(file_mtime "${tp%.jsonl}/subagents/agent-$id.jsonl")
    [ -n "$at" ] || [ -z "$tp" ] || at=$(file_mtime "$tp")
    # No transcript to date it: the lead's last state change, while that process still ran
    # (never now: the gap since may be hours with nothing running).
    case "$at" in ''|*[!0-9]*) at=$(tail -n 1 "$STATE/lead.tsv" 2>/dev/null | cut -f 1) ;; esac
    case "$at" in ''|*[!0-9]*) at=${start:-} ;; esac
    case "$at" in ''|*[!0-9]*) now_parts; at=$NOW_EPOCH ;; esac
    case "$start" in ''|*[!0-9]*) ;; *) [ "$at" -ge "$start" ] || at=$start ;; esac
    record_run "$id" "$start" "${A_TYPE:-unknown}" "$A_DESC" interrupted "$at"
    rm -f "$f"
    JOURNAL_AT=$at journal_append "← ${A_TYPE:-unknown}" "interrupted${A_DESC:+ · $A_DESC} (its Claude Code session ended)"
  done
}

# lead_set STATE SESSION: record the lead's state in leads/<SESSION> ("<state> HH:MM <epoch>"),
# and, when it changed, append "<epoch>\t<state>\t<session>\t<set>" to lead.tsv for the
# dashboard's lead time. "stopped" (crew session stop) sticks until `crew session start` runs
# again (/crew resume): the hooks pass "keep-stopped" to respect it.
lead_set() {
  local f prev="" st=$1
  safe_name "$2"; f="$STATE/leads/$REPLY"
  read -r prev _ < "$f" 2>/dev/null
  if [ "${3:-}" = keep-stopped ] && [ "$prev" = stopped ]; then return 0; fi
  now_parts
  printf '%s %s %s\n' "$st" "$NOW_HM" "$NOW_EPOCH" > "$f"
  [ "$prev" != "$st" ] || return 0
  session_set "$2"
  printf '%s\t%s\t%s\t%s\n' "$NOW_EPOCH" "$st" "$2" "$SET_SLUG" >> "$STATE/lead.tsv"
}

# ---------------------------------------------------------------------------
# Checkouts, task sets and leads (see "Leads" in the header)
# ---------------------------------------------------------------------------

# checkout_of DIR -> REPLY: the top of the checkout (the main one or a linked worktree) that
# contains DIR, as a physical path; ROOT when DIR is in none.
checkout_of() {
  local d
  d=$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$d" ] && d=$(cd "$d" 2>/dev/null && pwd -P); then REPLY=$d; else REPLY=$ROOT; fi
}

# session_checkout SESSION -> REPLY: the checkout SESSION leads (from sessions/<SESSION>; ROOT for
# a session registered by an older crew, or the wildcard).
session_checkout() {
  local line
  safe_name "$1"
  line=$(grep -m 1 '^checkout=' "$STATE/sessions/$REPLY" 2>/dev/null)
  REPLY=${line#checkout=}
  [ -n "$REPLY" ] && [ -d "$REPLY" ] || REPLY=$ROOT
}

# set_here CHECKOUT -> SET_SLUG and SET_DIR (absolute; both empty when none): the task set open
# in CHECKOUT. An open index (no Closed: line) whose Branch: is the branch checked out there, else
# the folder of a crew/<slug> branch; off a crew/ branch, the only open index there.
set_here() {
  local co=$1 br f rec closed branch d open="" n=0
  SET_SLUG=""; SET_DIR=""
  br=$(git -C "$co" symbolic-ref --short -q HEAD 2>/dev/null)
  for f in "$co"/.crew/tasks/*/index.md; do
    [ -f "$f" ] || continue
    rec=$(parse_index summary "$f" 2>/dev/null)
    IFS=$US read -r _ _ _ closed _ branch <<< "$rec"
    [ -z "$closed" ] || continue
    d=${f%/index.md}
    if [ -n "$br" ] && { [ "${branch%% *}" = "$br" ] || [ "$br" = "crew/${d##*/}" ]; }; then
      SET_DIR=$d; break
    fi
    n=$((n + 1)); open=$d
  done
  if [ -z "$SET_DIR" ] && [ "$n" = 1 ]; then
    case $br in crew/*) ;; *) SET_DIR=$open ;; esac
  fi
  [ -z "$SET_DIR" ] || SET_SLUG=${SET_DIR##*/}
}

# session_set SESSION -> SET_SLUG, SET_DIR: the task set open in the checkout SESSION leads.
session_set() {
  session_checkout "$1"
  set_here "$REPLY"
}

# caller_session -> REPLY: the registered session whose Claude Code runs this command (the
# process up the tree is the one recorded for it; after /clear one process has had several
# sessions: the newest registration wins); "" when none.
caller_session() {
  local pid f s best="" bt=-1 t p
  claude_pid; pid=$REPLY; REPLY=""
  [ -n "$pid" ] || return 0
  for f in "$STATE/claude"/*; do
    [ -f "$f" ] || continue
    s=${f##*/}
    [ -e "$STATE/sessions/$s" ] || continue
    p=""; read -r p _ < "$f" 2>/dev/null
    [ "$p" = "$pid" ] || continue
    t=$(file_mtime "$STATE/sessions/$s"); case $t in ''|*[!0-9]*) t=0 ;; esac
    if [ "$t" -gt "$bt" ]; then bt=$t; best=$s; fi
  done
  REPLY=$best
}

# session_agents SESSION -> REPLY: how many subagents SESSION runs now.
session_agents() {
  local f n=0
  for f in "$STATE/running"/*; do
    [ -f "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null)" = "$1" ] && n=$((n + 1))
  done
  REPLY=$n
}

# other_lead CHECKOUT SESSION -> REPLY: another registered session that leads CHECKOUT and whose
# Claude Code still runs, not in this command's process (after /clear, the same process starts a
# new session: that one is not another lead); "" when none.
other_lead() {
  local f s co pid mine
  claude_pid; mine=$REPLY
  for f in "$STATE/sessions"/*; do
    [ -f "$f" ] || continue
    s=${f##*/}
    [ "$s" != any ] && [ "$s" != "$2" ] || continue
    session_checkout "$s"; co=$REPLY
    [ "$co" = "$1" ] || continue
    pid=""; read -r pid _ < "$STATE/claude/$s" 2>/dev/null
    [ -n "$pid" ] && [ "$pid" != "$mine" ] || continue
    session_alive "$s" || continue
    REPLY=$s; return 0
  done
  REPLY=""
}

# supersede SESSION BY: SESSION no longer leads: its registration moves to superseded/ (its next
# prompt is told who took over) and its keep-awake ends.
supersede() {
  safe_name "$1"
  [ -e "$STATE/sessions/$REPLY" ] || return 0
  now_parts
  printf '%s %s %s\n' "$2" "$NOW_HM" "$NOW_EPOCH" > "$STATE/superseded/$REPLY"
  rm -f "$STATE/sessions/$REPLY"
  keep_awake_stop "$1"
}

# lead_line SESSION -> REPLY: "working since 14:03", "stopped since 09:12" (from leads/<SESSION>).
lead_line() {
  local st hm
  safe_name "$1"
  read -r st hm _ < "$STATE/leads/$REPLY" 2>/dev/null
  REPLY="${st:-registered}${hm:+ since $hm}"
}

# ---------------------------------------------------------------------------
# Agent state
# ---------------------------------------------------------------------------

# Read model: or effort: from the frontmatter of <root>/.claude/agents/<type>.md.
agent_frontmatter() {
  local f="$ROOT/.claude/agents/$1.md"
  case $1 in */*|'') return 0 ;; esac
  [ -f "$f" ] || return 0
  awk -v k="$2" '
    NR == 1 { if ($0 !~ /^---[ \t\r]*$/) exit; next }
    /^---[ \t\r]*$/ { exit }
    index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      sub(/[ \t]+#.*$/, "", v); gsub(/^[ \t]+|[ \t\r]+$/, "", v)
      gsub(/^["\047]|["\047]$/, "", v)
      print v; exit
    }' "$f" 2>/dev/null
}

# load_agent ID: sets A_TYPE A_DESC A_MODEL A_EFFORT A_NAME A_SINCE A_STARTED A_RUN_START
# A_SESSION A_SET from agents/<id> (A_RUN_START: the start of its current run, a resume
# included; the last line wins).
load_agent() {
  local line
  A_TYPE=""; A_DESC=""; A_MODEL=""; A_EFFORT=""; A_NAME=""; A_SINCE=""; A_STARTED=""; A_RUN_START=""
  A_SESSION=""; A_SET=""
  [ -f "$STATE/agents/$1" ] || return 1
  while IFS= read -r line; do
    case $line in
      run_start=*) A_RUN_START=${line#run_start=} ;;
      type=*) A_TYPE=${line#type=} ;;
      description=*) A_DESC=${line#description=} ;;
      model=*) A_MODEL=${line#model=} ;;
      effort=*) A_EFFORT=${line#effort=} ;;
      name=*) A_NAME=${line#name=} ;;
      since=*) A_SINCE=${line#since=} ;;
      started=*) A_STARTED=${line#started=} ;;
      session=*) A_SESSION=${line#session=} ;;
      set=*) A_SET=${line#set=} ;;
    esac
  done < "$STATE/agents/$1"
  return 0
}

# ---------------------------------------------------------------------------
# Compactions: who compacted, reminders, journal lines, economics
# ---------------------------------------------------------------------------

# Prices in USD per million tokens: Anthropic list prices as read on 2026-10-20 from
# https://platform.claude.com/docs/en/about-claude/pricing (the one place prices live;
# update the date with the numbers). Haiku 5.5 has a second tier for prompts over 100K.
# price_for MODEL PRE_TOKENS -> sets P_ALIAS and P_READ P_OUT P_IN P_WRITE5M (empty: unknown).
price_for() {
  model_alias "$1"; P_ALIAS=$REPLY
  P_READ=""; P_OUT=""; P_IN=""; P_WRITE5M=""
  case $P_ALIAS in
    fable)  P_READ=0.25; P_OUT=50;   P_IN=10;   P_WRITE5M=12.50 ;;
    opus)   P_READ=0.20; P_OUT=20;   P_IN=4;    P_WRITE5M=5 ;;
    sonnet) P_READ=0.10; P_OUT=10;   P_IN=2;    P_WRITE5M=2.50 ;;
    haiku)
      if [ "${2:-0}" -gt 100000 ] 2>/dev/null; then P_READ=0.05; P_OUT=2.50; P_IN=0.50; P_WRITE5M=0.625
      else P_READ=0.01; P_OUT=0.50; P_IN=0.10; P_WRITE5M=0.125; fi ;;
  esac
}

# model_alias MODEL -> REPLY: fable | opus | sonnet | haiku | "" (unknown or "default").
model_alias() {
  case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    *fable*|*mythos*) REPLY=fable ;;
    *opus*) REPLY=opus ;;
    *sonnet*) REPLY=sonnet ;;
    *haiku*) REPLY=haiku ;;
    *) REPLY="" ;;
  esac
}

# compact_cost PRE POST MODEL -> REPLY: estimated USD as a number ("" when the model is unknown).
# The summarization request re-reads the context at the cache-read price and writes the
# summary at the output price. After an idle gap longer than the cache TTL the re-read costs
# the full input price instead (up to 10x more); a hook cannot tell, so this is the warm case.
compact_cost() {
  price_for "$3" "$1"
  REPLY=""
  [ -n "$P_READ" ] || return 0
  REPLY=$(awk -v pre="$1" -v post="$2" -v r="$P_READ" -v o="$P_OUT" 'BEGIN { printf "%.4f", (pre * r + post * o) / 1000000 }')
}

# fmt_usd 0.3312 -> REPLY "≈$0.33" ("" for empty, "<$0.01" for tiny).
fmt_usd() {
  REPLY=""
  [ -n "$1" ] || return 0
  REPLY=$(awk -v c="$1" 'BEGIN { if (c < 0.005) printf "<$0.01"; else printf "≈$%.2f", c }')
}

# transcript_kind PATH -> T_KIND (lead | sub) and T_ID (the agent id for a subagent).
# A subagent's transcript is <project>/<session>/subagents/agent-<id>.jsonl.
transcript_kind() {
  T_KIND=lead; T_ID=""
  case $1 in
    */subagents/agent-*.jsonl) T_ID=${1##*/agent-}; T_ID=${T_ID%.jsonl}; T_KIND=sub ;;
  esac
}

# describe_agent ID META_DIR: sets D_LABEL D_TYPE D_NAME D_DESC D_MODEL D_EFFORT D_STARTED from the
# crew agent record, completed from the transcript's agent-<id>.meta.json and the agent
# definition's frontmatter. Label: "s2a-t07-builder (builder · sonnet · high)".
describe_agent() {
  local id=$1 meta="$2/agent-$1.meta.json" m mt mn mm me md
  D_TYPE=""; D_NAME=""; D_DESC=""; D_MODEL=""; D_EFFORT=""; D_STARTED=""
  safe_name "$id"
  if load_agent "$REPLY"; then
    D_TYPE=$A_TYPE; D_NAME=$A_NAME; D_DESC=$A_DESC; D_MODEL=$A_MODEL; D_EFFORT=$A_EFFORT; D_STARTED=$A_STARTED
  fi
  [ "$D_MODEL" != default ] || D_MODEL=""
  [ "$D_EFFORT" != default ] || D_EFFORT=""
  if [ -f "$meta" ]; then
    m=$(jq -r '[.agentType // "", .name // "", .model // "", .effort // "", .description // ""] | join("\u001f")' "$meta" 2>/dev/null)
    IFS=$US read -r mt mn mm me md <<< "$m"
    [ -n "$D_TYPE" ] || D_TYPE=$mt
    [ -n "$D_NAME" ] || D_NAME=$mn
    [ -n "$D_MODEL" ] || D_MODEL=$mm
    [ -n "$D_EFFORT" ] || D_EFFORT=$me
    [ -n "$D_DESC" ] || D_DESC=$md
  fi
  [ -n "$D_MODEL" ] || D_MODEL=$(agent_frontmatter "$D_TYPE" model)
  [ -n "$D_EFFORT" ] || D_EFFORT=$(agent_frontmatter "$D_TYPE" effort)
  oneline "$D_NAME"; D_NAME=$REPLY
  oneline "$D_TYPE"; D_TYPE=$REPLY
  model_alias "$D_MODEL"; m=${REPLY:-$D_MODEL}
  if [ -n "$D_NAME" ]; then D_LABEL="$D_NAME (${D_TYPE:-subagent} · ${m:-?} · ${D_EFFORT:-?})"
  else D_LABEL="${D_TYPE:-subagent} (${m:-?} · ${D_EFFORT:-?})"; fi
}

# lead_model SID: sets LM_MODEL LM_ALIAS LM_EFFORT LM_LABEL from what session-start recorded.
lead_model() {
  LM_MODEL=""; LM_ALIAS=""; LM_EFFORT=""; LM_LABEL=lead
  safe_name "$1"
  { read -r LM_MODEL LM_EFFORT < "$STATE/lead-model/$REPLY"; } 2>/dev/null || return 0
  model_alias "$LM_MODEL"; LM_ALIAS=${REPLY:-$LM_MODEL}
  [ -z "$LM_MODEL" ] || LM_LABEL="lead ($LM_ALIAS${LM_EFFORT:+ · $LM_EFFORT})"
}

# remember_transcript SID PATH: keep the main transcript path per session, so commands run
# by the lead (no hook input) can settle compactions too.
remember_transcript() {
  [ -n "$1" ] && [ -n "$2" ] || return 0
  safe_name "$1"
  local f="$STATE/transcripts/$REPLY"
  [ "$(cat "$f" 2>/dev/null)" = "$2" ] || printf '%s\n' "$2" > "$f" 2>/dev/null
}

# last_context PATH -> REPLY: context size (input + cache read + cache write tokens) of the
# newest API response in the transcript, read from its last 400 KB; 0 when none.
last_context() {
  REPLY=$(tail -c 400000 "$1" 2>/dev/null | grep '"type":"assistant"' | grep '"usage":{' | tail -n 1 |
    jq -r '.message.usage | ((.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0))' 2>/dev/null)
  case $REPLY in ''|*[!0-9]*) REPLY=0 ;; esac
}

# running_any SESSION: SESSION runs at least one subagent now.
running_any() {
  local f
  for f in "$STATE/running"/*; do
    [ -f "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null)" = "$1" ] && return 0
  done
  return 1
}

# guess_compacting_agent: the compaction hooks do not say which agent is compacting (see the
# header). Pick the transcript whose newest API response carried the largest context: that
# is the one that reached its window. Sets G_KIND (lead | sub | unknown), G_ID, G_LABEL, G_MODEL.
guess_compacting_agent() {
  local f id best=0 second=0 best_kind=lead best_id="" c dir
  G_KIND=lead; G_ID=""; G_LABEL=lead; G_MODEL=""
  lead_model "$J_SESSION"; G_LABEL=$LM_LABEL; G_MODEL=$LM_MODEL
  running_any "$J_SESSION" || return 0
  [ -n "$J_TRANSCRIPT" ] && [ -f "$J_TRANSCRIPT" ] || { G_KIND=unknown; return 0; }
  dir="${J_TRANSCRIPT%.jsonl}/subagents"
  last_context "$J_TRANSCRIPT"; best=$REPLY
  for f in "$STATE/running"/*; do
    [ -e "$f" ] || continue
    id=${f##*/}
    [ -f "$dir/agent-$id.jsonl" ] || continue
    last_context "$dir/agent-$id.jsonl"; c=$REPLY
    if [ "$c" -gt "$best" ]; then second=$best; best=$c; best_kind=sub; best_id=$id
    elif [ "$c" -gt "$second" ]; then second=$c; fi
  done
  # Ambiguous when the runner-up is within 15% of the best, or nothing was readable.
  if [ "$best" -le 0 ] || [ $((second * 100)) -gt $((best * 85)) ]; then G_KIND=unknown; return 0; fi
  G_KIND=$best_kind; G_ID=$best_id
  if [ "$G_KIND" = sub ]; then describe_agent "$G_ID" "$dir"; G_LABEL=$D_LABEL; G_MODEL=$D_MODEL; fi
}

# live_indexes [CHECKOUT]: prints the index files without a Closed: line in CHECKOUT (default:
# the main checkout).
live_indexes() {
  local f rec closed
  for f in "${1:-$ROOT}"/.crew/tasks/*/index.md; do
    [ -f "$f" ] || continue
    rec=$(parse_index summary "$f" 2>/dev/null)
    IFS=$US read -r _ _ _ closed _ _ <<< "$rec"
    [ -z "$closed" ] && printf '%s\n' "$f"
  done
}

# in_flight_rows INDEX -> REPLY: "T07 in progress, T08 in review" in that index; "" when none.
in_flight_rows() {
  local f id key
  REPLY=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    while IFS=$US read -r id key _; do
      case $key in
        progress|review|rework) status_look "$key"; REPLY="${REPLY:+$REPLY, }$id $WORD" ;;
      esac
    done <<EOF
$(parse_index rows "$f" 2>/dev/null)
EOF
  done <<EOF
${1:-}
EOF
}

# spec_path_for AGENT_ID -> REPLY: the spec of the task named by the agent's description
# ("T07 …") in its task set, relative to its lead's checkout; "" when unknown.
spec_path_for() {
  local f id spec tnum re='^[Tt]0*([0-9]+)([^0-9]|$)' want co idx
  REPLY=""
  [ -n "$1" ] || return 0
  safe_name "$1"
  load_agent "$REPLY" || return 0
  [[ $A_DESC =~ $re ]] || return 0
  want=${BASH_REMATCH[1]}
  session_checkout "${A_SESSION:-$J_SESSION}"; co=$REPLY
  if [ -n "$A_SET" ] && [ -f "$co/.crew/tasks/$A_SET/index.md" ]; then idx="$co/.crew/tasks/$A_SET/index.md"
  else idx=$(live_indexes "$co"); fi
  REPLY=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    while IFS=$US read -r id _ _ _ _ spec; do
      tnum=$(printf '%s' "$id" | tr -cd '0-9' | sed 's/^0*//')
      if [ "$tnum" = "$want" ] && [ -n "$spec" ]; then
        spec=${spec//\`/}
        REPLY="${f%/index.md}/$spec"; REPLY=${REPLY#"$co"/}
        return 0
      fi
    done <<EOF
$(parse_index rows "$f" 2>/dev/null)
EOF
  done <<EOF
$idx
EOF
}

# compact_instructions KIND ID: custom compaction instructions for the summarizer (PreCompact
# stdout). Phrased for the role when it is known, for both roles when it is not.
compact_instructions() {
  local lead sub agents="" f id idx co
  if [ "$1" != sub ]; then
    for f in "$STATE/running"/*; do
      [ -e "$f" ] || continue
      [ "$(cat "$f" 2>/dev/null)" = "$J_SESSION" ] || continue
      id=${f##*/}
      load_agent "$id" || continue
      agents="${agents:+$agents; }${A_NAME:-$A_TYPE} [$id]: ${A_DESC:-?}"
    done
    session_set "$J_SESSION"; co=$REPLY
    idx=${SET_DIR:+${SET_DIR#"$co"/}/index.md}
  fi
  lead="You are the lead of a crew of subagents, working under the crew skill. Keep in the summary: 1) the crew rules in force, above all that every founder request becomes a queue entry (.crew/bin/crew request) before anything else and is never added to a running agent; 2) the active task set and each task's status${idx:+ (index: $idx)}; 3) every live subagent with its name, id, task and what you are waiting for from it${agents:+ (now: $agents)}; 4) founder requests or questions not yet in the queue, and decisions not yet in the decisions log; 5) the exact next step. Keep file paths verbatim."
  sub="You are a subagent of a crew. Keep in the summary: your task id and the spec path, each acceptance criterion with whether it is verified and the evidence, every file you changed, the report format your brief requires (its first line is the status keyword), decisions and deviations so far, and your exact next step. Keep file paths verbatim."
  case $1 in
    lead) printf '%s\n' "Crew: $lead" ;;
    sub) printf '%s\n' "Crew: $sub" ;;
    *) printf '%s\n' "Crew: if you are the main session: $lead If you are a subagent: $sub" ;;
  esac
}

# compact_reminder KIND SPEC: the post-compaction reminder (SessionStart compact stdout),
# conditional so that nothing already in context is re-read.
compact_reminder() {
  local lead sub
  lead="If any of these are no longer in your context, read them: CREW.md (path in the CLAUDE.md or AGENTS.md pointer), the queue, your task set's index, and the state file (\`.crew/bin/crew where\` names the set's files). Run ListAgents (or \`.crew/bin/crew running\`) if you are not sure which subagents are live. If the crew skill's rules are no longer in your context, invoke the crew skill again. Founder messages are still governed by the request rules: queue first (\`.crew/bin/crew request\`), never add scope to a running agent."
  sub="If your task spec or brief is no longer in your context, re-read it${2:+ (spec: $2)}, then continue from your last verified step and report in the format your brief asked for."
  case $1 in
    lead) printf '%s\n' "Crew: context was compacted. $lead" ;;
    sub) printf '%s\n' "Crew: context was compacted. $sub" ;;
    *) printf '%s\n' "Crew: context was compacted. If you are a subagent: $sub If you are the lead (the main session): $lead" ;;
  esac
}

# turns_in PATH FROM [TO] -> REPLY: distinct assistant message ids (API requests) in the byte range.
turns_in() {
  local from=$2 to=${3:-}
  if [ -n "$to" ] && [ "$to" -gt "$from" ]; then
    REPLY=$(tail -c +$((from + 1)) "$1" 2>/dev/null | head -c $((to - from)) | grep '"type":"assistant"' | grep -o '"id":"msg_[A-Za-z0-9]*"' | sort -u | wc -l | tr -d ' ')
  else
    REPLY=$(tail -c +$((from + 1)) "$1" 2>/dev/null | grep '"type":"assistant"' | grep -o '"id":"msg_[A-Za-z0-9]*"' | sort -u | wc -l | tr -d ' ')
  fi
  case $REPLY in ''|*[!0-9]*) REPLY=0 ;; esac
}

# The compaction log: one TAB-separated line per compaction in $STATE/compactions.tsv:
#   1 epoch  2 iso  3 kind  4 id  5 label  6 model  7 effort  8 pre  9 post  10 durationMs
#   11 trigger  12 cost_usd  13 transcript  14 boundary_offset  15 turns_after ("-" = open)
#   16 agent_started_epoch
COMPACTIONS=""
set_compactions_path() { COMPACTIONS="$STATE/compactions.tsv"; }

# freeze_previous PATH NEW_OFFSET: the previous compaction of this transcript is now closed;
# count the API requests made between the two boundaries.
freeze_previous() {
  local tmp="$COMPACTIONS.new" n
  [ -f "$COMPACTIONS" ] || return 0
  n=$(awk -F'\t' -v p="$1" '$13 == p && $15 == "-" { print NR ":" $14 }' "$COMPACTIONS" | tail -n 1)
  [ -n "$n" ] || return 0
  turns_in "$1" "${n#*:}" "$2"
  awk -F'\t' -v OFS='\t' -v line="${n%%:*}" -v t="$REPLY" 'NR == line { $15 = t } { print }' "$COMPACTIONS" > "$tmp" && mv -f "$tmp" "$COMPACTIONS"
}

# record_compaction PATH SID OFFSET RECORD: log one compact_boundary record (journal + tsv).
record_compaction() {
  local path=$1 sid=$2 boff=$3 ts="" trig="" pre=0 post=0 dur=0 epoch kind id label model effort started="" cost text prek postk durs
  eval "$(printf '%s' "$4" | jq -r '
    def s: if . == null then "" else tostring end;
    @sh "ts=\(.timestamp | s)",
    @sh "trig=\(.compactMetadata.trigger | s)",
    @sh "pre=\(.compactMetadata.preTokens | s)",
    @sh "post=\(.compactMetadata.postTokens | s)",
    @sh "dur=\(.compactMetadata.durationMs | s)"' 2>/dev/null)" || return 0
  case $pre in ''|*[!0-9]*) pre=0 ;; esac
  case $post in ''|*[!0-9]*) post=0 ;; esac
  case $dur in ''|*[!0-9]*) dur=0 ;; esac
  [ -n "$trig" ] || trig=auto
  now_parts
  iso_to_epoch "$ts"; epoch=${REPLY:-$NOW_EPOCH}
  transcript_kind "$path"; kind=$T_KIND
  if [ "$kind" = sub ]; then
    id=$T_ID
    describe_agent "$id" "$(dirname "$path")"
    label=$D_LABEL; model=$D_MODEL; effort=$D_EFFORT; started=$D_STARTED
  else
    id=lead
    lead_model "$sid"
    label=$LM_LABEL; model=$LM_MODEL; effort=$LM_EFFORT
  fi
  compact_cost "$pre" "$post" "$model"; cost=$REPLY
  freeze_previous "$path" "$boff"
  oneline "$label"; label=$REPLY
  printf '%s\n' "$epoch$TAB$ts$TAB$kind$TAB$id$TAB$label$TAB$model$TAB$effort$TAB$pre$TAB$post$TAB$dur$TAB$trig$TAB$cost$TAB$path$TAB$boff$TAB-$TAB$started" >> "$COMPACTIONS"
  fmt_k "$pre"; prek=$REPLY
  fmt_k "$post"; postk=$REPLY
  text="Context compacted · $label · $prek → $postk"
  if [ "$dur" -gt 0 ]; then fmt_secs $(((dur + 500) / 1000)); text="$text · $REPLY"; fi
  text="$text · $trig"
  fmt_usd "$cost"; [ -z "$REPLY" ] || text="$text · $REPLY"
  JOURNAL_AT=$epoch journal_append "system" "$text"
}

# settle_transcript PATH SID: log the compact_boundary records appended since the last scan.
# Only the new bytes are read; a partial last line is left for the next scan.
settle_transcript() {
  local path=$1 sid=$2 key off size out line start last_start end
  safe_name "$path"; key=$REPLY
  off=$(cat "$STATE/compact/scan/$key" 2>/dev/null)
  case $off in ''|*[!0-9]*) off=0 ;; esac
  size=$(file_size "$path") || return 0
  if [ "$size" -lt "$off" ]; then off=0; fi
  [ "$size" -gt "$off" ] || return 0
  out=$(tail -c +$((off + 1)) "$path" 2>/dev/null | LC_ALL=C awk -v base="$off" '
    { start = base + pos; pos += length($0) + 1; last = start
      if (index($0, "\"compact_boundary\"") && index($0, "\"type\":\"system\"")) print start "\t" $0 }
    END { print "END\t" last "\t" base + pos }')
  last_start=""; end=""
  while IFS=$TAB read -r start line; do
    case $start in
      END) last_start=${line%%$TAB*}; end=${line#*$TAB} ;;
      *[!0-9]*|'') ;;
      *) record_compaction "$path" "$sid" "$start" "$line" ;;
    esac
  done <<EOF
$out
EOF
  [ -n "$end" ] || return 0
  # A file not ending in a newline has a partial last line: rescan it next time.
  if [ "$(tail -c 1 "$path" 2>/dev/null | wc -l | tr -d ' ')" = 1 ]; then off=$end; else off=$last_start; fi
  printf '%s\n' "$off" > "$STATE/compact/scan/$key" 2>/dev/null
}

# freeze_open_rows: close the "turns after" count of compactions whose agent has stopped, or
# whose session is no longer registered, so the dashboard only counts turns for live transcripts.
freeze_open_rows() {
  local rows nr path boff kind id tmp="$COMPACTIONS.new"
  [ -s "$COMPACTIONS" ] || return 0
  rows=$(awk -F'\t' '$15 == "-" { print NR "\t" $13 "\t" $14 "\t" $3 "\t" $4 }' "$COMPACTIONS")
  [ -n "$rows" ] || return 0
  while IFS=$TAB read -r nr path boff kind id; do
    [ -n "$nr" ] || continue
    if [ "$kind" = sub ]; then
      [ -e "$STATE/running/$id" ] && continue
    else
      # The lead's row stays open while its transcript is alive (modified within the hour).
      [ -f "$path" ] && [ -z "$(find "$path" -mmin +60 2>/dev/null)" ] && continue
    fi
    if [ -f "$path" ]; then turns_in "$path" "$boff"; else REPLY=0; fi
    awk -F'\t' -v OFS='\t' -v line="$nr" -v t="$REPLY" 'NR == line { $15 = t } { print }' "$COMPACTIONS" > "$tmp" && mv -f "$tmp" "$COMPACTIONS"
  done <<EOF
$rows
EOF
}

# settle_compactions: scan the transcripts of every known session (main, then the subagent
# transcripts modified since the last scan) and log new compactions. Runs on every crew
# event and command, under the lock.
settle_compactions() {
  local f sid main dir sub mark="$STATE/compact/last-scan" newmark="$STATE/compact/last-scan.new"
  command -v jq >/dev/null 2>&1 || return 0
  set_compactions_path
  lock_take
  freeze_open_rows
  for f in "$STATE/transcripts"/*; do
    [ -f "$f" ] || continue
    sid=${f##*/}
    session_registered "$sid" || continue
    main=$(cat "$f" 2>/dev/null)
    [ -n "$main" ] && [ -f "$main" ] || continue
    settle_transcript "$main" "$sid"
    dir="${main%.jsonl}/subagents"
    [ -d "$dir" ] || continue
    : > "$newmark"
    if [ -f "$mark" ]; then
      while IFS= read -r sub; do
        [ -n "$sub" ] || continue
        settle_transcript "$sub" "$sid"
      done <<EOF
$(find "$dir" -maxdepth 1 -name 'agent-*.jsonl' -newer "$mark" 2>/dev/null)
EOF
    else
      for sub in "$dir"/agent-*.jsonl; do
        [ -f "$sub" ] || continue
        settle_transcript "$sub" "$sid"
      done
    fi
    mv -f "$newmark" "$mark" 2>/dev/null
  done
}

# check_index_additions PATH: when the lead adds task rows to an index that already had rows,
# flag any new row whose spec has no "Requests:" line (scope added without a queue entry).
# Sets REPLY to the note for the lead ("" when nothing to flag).
check_index_additions() {
  local path=$1 rel key stored now id spec dir flagged="" line
  REPLY=""
  rel=.crew/${path##*/.crew/}
  # Keyed by the path from the main checkout: each worktree's copy of an index has its own rows.
  safe_name "${path#"$ROOT"/.crew/}"; key=$REPLY
  now=$(parse_index rows "$path" 2>/dev/null | cut -d"$US" -f1,6)
  stored=$(cat "$STATE/index-rows/$key" 2>/dev/null)
  if [ -n "$stored" ] && [ -z "$J_AGENT_TYPE" ]; then
    dir=$(dirname "$path")
    while IFS=$US read -r id spec; do
      [ -n "$id" ] || continue
      printf '%s\n' "$stored" | grep -q -x -F "$id" && continue
      spec=${spec//\`/}
      if [ -n "$spec" ] && [ -f "$dir/$spec" ] && ! grep -q -i -E '(^[[:space:]]*(-[[:space:]]*)?|· )(\*\*)?Requests:' "$dir/$spec"; then
        flagged="${flagged:+$flagged, }$id"
      fi
    done <<EOF
$now
EOF
  fi
  printf '%s\n' "$now" | cut -d"$US" -f1 > "$STATE/index-rows/$key" 2>/dev/null
  [ -n "$flagged" ] || return 0
  line="$flagged added to $rel without a Requests: line in the spec. If it comes from a founder request, queue it first (.crew/bin/crew request) and add \"Requests: R<n>\" to the spec; if it is planned work, add \"Requests: none\"."
  journal_append "system" "$line"
  REPLY=$line
}

# ---------------------------------------------------------------------------
# Task indexes (D-J2 to D-J5)
# ---------------------------------------------------------------------------

# status_look KEY: sets GLYPH and WORD for a canonical status key.
status_look() {
  case $1 in
    accepted) GLYPH='☑'; WORD='accepted' ;;
    progress) GLYPH='◔'; WORD='in progress' ;;
    review) GLYPH='◑'; WORD='in review' ;;
    rework) GLYPH='↻'; WORD='rework' ;;
    blocked) GLYPH='⊘'; WORD='blocked' ;;
    *) GLYPH='☐'; WORD='pending' ;;
  esac
}

# Parse an index file. mode=summary prints one record:
#   title US total US accepted US closed US stage US branch
# mode=rows prints one record per task:
#   id US status-key US title US flags US deps (space-separated ids) US spec
# Column order fixed by the scaffold template: #, Status, Task, Flags, Depends on, Spec.
parse_index() {
  awk -v mode="$1" '
    function trim(s) { gsub(/^[ \t]+|[ \t\r]+$/, "", s); return s }
    function key(s,  l) {
      l = tolower(s)
      if (l ~ /accept/) return "accepted"
      if (l ~ /review/) return "review"
      if (l ~ /rework/) return "rework"
      if (l ~ /block/) return "blocked"
      if (l ~ /progress/) return "progress"
      return "pending"
    }
    function field(s, label) {
      sub("^.*" label ":[ \t]*", "", s); gsub(/\*\*/, "", s); gsub(/`/, "", s)
      return trim(s)
    }
    BEGIN { FS = "|"; OFS = "\037" }
    title == "" && /^# / {
      title = substr($0, 3); sub(/[ \t]+(—|-)[ \t]+tasks[ \t]*$/, "", title); title = trim(title)
    }
    /^[ \t]*(-[ \t]+)?(\*\*)?Closed:/ { closed = field($0, "Closed"); if (closed == "") closed = "yes" }
    /^[ \t]*(-[ \t]+)?(\*\*)?Stage:/ { stage = field($0, "Stage"); if (stage ~ /^</) stage = "" }
    /^[ \t]*(-[ \t]+)?(\*\*)?Branch:/ { branch = field($0, "Branch") }
    /^[ \t]*\|/ {
      if (NF < 8) next
      id = trim($2)
      if (id !~ /^[A-Za-z]*[0-9]+$/) next
      n++; ids[n] = id; st[n] = key(trim($3)); ti[n] = trim($4); fl[n] = trim($5)
      dp[n] = trim($6); sp[n] = trim($7)
      num[n] = id; gsub(/[^0-9]/, "", num[n]); num[n] += 0
    }
    END {
      if (mode == "summary") {
        acc = 0
        for (i = 1; i <= n; i++) if (st[i] == "accepted") acc++
        print title, n + 0, acc, closed, stage, branch
        exit
      }
      for (i = 1; i <= n; i++) {
        deps = ""; d = dp[i]
        # Dependencies may be written T01, 01 or 1: match them by number.
        while (match(d, /[0-9]+/)) {
          k = substr(d, RSTART, RLENGTH) + 0; d = substr(d, RSTART + RLENGTH)
          for (j = 1; j <= n; j++) if (num[j] == k && j != i) { deps = deps (deps == "" ? "" : " ") ids[j]; break }
        }
        f = fl[i]; if (f == "—" || f == "-" || tolower(f) == "none") f = ""
        gsub(/\t/, " ", ti[i])
        print ids[i], st[i], ti[i], f, deps, sp[i]
      }
    }' "$2"
}

# List worktrees: "path US branch" per line, main checkout first.
list_worktrees() {
  git -C "$ROOT" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { if (p != "") print p "\037" b; p = substr($0, 10); b = ""; next }
    /^branch / { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    END { if (p != "") print p "\037" b }'
}

# ---------------------------------------------------------------------------
# Hook modes
# ---------------------------------------------------------------------------

session_registered() {
  [ -e "$STATE/sessions/any" ] && return 0
  [ -n "$1" ] || return 1
  safe_name "$1"
  [ -e "$STATE/sessions/$REPLY" ]
}

# Parse the hook input with one jq call; sets the J_* variables.
read_hook_json() {
  local out
  J_SESSION=""; J_CWD=""; J_TOOL=""; J_AGENT_TYPE=""; J_AGENT_ID=""; J_SUBTYPE=""; J_DESC=""
  J_MODEL=""; J_EFFORT=""; J_NAME=""; J_ISO=""; J_TO=""; J_SUMMARY=""; J_MESSAGE=""; J_FILE=""
  J_LAST=""; J_TRANSCRIPT=""; J_SOURCE=""; J_TRIGGER=""; J_HOOK_MODEL=""; J_EFFORT_LVL=""
  out=$(printf '%s' "$INPUT" | jq -r '
    def s: if . == null then "" elif type == "string" then . else tostring end;
    ((.tool_input | objects) // {}) as $t |
    @sh "J_SESSION=\(.session_id | s)",
    @sh "J_CWD=\(.cwd | s)",
    @sh "J_TOOL=\(.tool_name | s)",
    @sh "J_AGENT_TYPE=\(.agent_type | s)",
    @sh "J_AGENT_ID=\(.agent_id | s)",
    @sh "J_TRANSCRIPT=\(.transcript_path | s)",
    @sh "J_SOURCE=\(.source | s)",
    @sh "J_TRIGGER=\(.trigger | s)",
    @sh "J_HOOK_MODEL=\(.model | s)",
    @sh "J_EFFORT_LVL=\((.effort | if type == "object" then .level else . end) | s)",
    @sh "J_SUBTYPE=\($t.subagent_type | s)",
    @sh "J_DESC=\($t.description | s)",
    @sh "J_MODEL=\($t.model | s)",
    @sh "J_EFFORT=\($t.effort | s)",
    @sh "J_NAME=\($t.name | s)",
    @sh "J_ISO=\($t.isolation | s)",
    @sh "J_TO=\($t.to | s)",
    @sh "J_SUMMARY=\($t.summary | s)",
    @sh "J_MESSAGE=\($t.message | s)",
    @sh "J_FILE=\($t.file_path | s)",
    @sh "J_LAST=\(.last_assistant_message | s | split("\n")[0:5] | join("\n"))"
  ' 2>/dev/null) || return 1
  [ -n "$out" ] || return 1
  eval "$out"
}

# Without jq: warn once per day in the journal (only for a registered session).
hook_without_jq() {
  local sid
  sid=$(printf '%s' "$INPUT" | tr '\n' ' ' | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  session_registered "$sid" || return 0
  now_parts
  if [ "$(cat "$STATE/jq-warned" 2>/dev/null)" = "$NOW_DAY" ]; then return 0; fi
  ensure_dirs
  lock_take
  printf '%s\n' "$NOW_DAY" > "$STATE/jq-warned"
  WRITER_CWD=$PWD
  journal_append "system" "jq not found; subagent logging is off. Run /crew setup."
}

# task_num TEXT -> REPLY: the task number of a description that starts with T<NN> ("7" for
# "T07 autosave"), "" otherwise.
task_num() {
  local re='^[Tt]0*([0-9]+)([^0-9]|$)'
  REPLY=""
  if [[ $1 =~ $re ]]; then REPLY=${BASH_REMATCH[1]}; fi
}

# record_run ID START TYPE DESC STATUS [END]: append one finished run to runs.tsv (see the
# header), ending at END (default now). The session and the set are the agent's, from the
# load_agent just before (A_SESSION, A_SET).
record_run() {
  local kind=first end
  case "$2" in ''|*[!0-9]*) return 0 ;; esac
  now_parts
  end=${6:-$NOW_EPOCH}
  if [ -f "$RUNS" ] && awk -F'\t' -v id="$1" '$3 == id { f = 1 } END { exit !f }' "$RUNS"; then kind=resume; fi
  task_num "$4"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$2" "$end" "$1" "${3:-unknown}" "$REPLY" "$kind" "$5" \
    "${A_SESSION:-}" "${A_SET:-}" >> "$RUNS"
}

hook_agent_start() {
  local type model effort desc head text
  [ "$J_TOOL" = Agent ] || return 0
  type=${J_SUBTYPE:-general-purpose}
  model=$J_MODEL; effort=$J_EFFORT
  [ -n "$model" ] || model=$(agent_frontmatter "$type" model)
  [ -n "$effort" ] || effort=$(agent_frontmatter "$type" effort)
  oneline "${model:-default}"; model=$REPLY
  oneline "${effort:-default}"; effort=$REPLY
  oneline "$J_DESC"; trunc "$REPLY" 120; desc=$REPLY
  oneline "$J_NAME"; local name=$REPLY

  head="→ $type ($model · $effort)"
  [ -z "$J_AGENT_TYPE" ] || head="$J_AGENT_TYPE $head"
  text=$desc
  [ -z "$name" ] || text="$text [$name]"
  [ -z "$J_ISO" ] || text="$text ($J_ISO)"

  ensure_dirs
  lock_take
  now_parts
  safe_name "$type"
  printf '%s\n' "$NOW_EPOCH$TAB$desc$TAB$model$TAB$effort$TAB$name" >> "$STATE/pending/$REPLY"
  journal_append "$head" "$text"
}

hook_agent_resume() {
  local text
  [ "$J_TOOL" = SendMessage ] || return 0
  if [ -n "$J_SUMMARY" ]; then oneline "$J_SUMMARY"; else oneline "$J_MESSAGE"; fi
  trunc "$REPLY" 120; text=$REPLY
  oneline "${J_TO:-?}"
  journal_append "↺ $REPLY" "$text"
}

hook_agent_id() {
  local id pfile rec desc model effort name sess=""
  [ -n "$J_AGENT_TYPE" ] && [ -n "$J_AGENT_ID" ] || return 0
  ensure_dirs
  lock_take
  # running/<id> holds the session whose Claude Code process runs the agent.
  [ -z "$J_SESSION" ] || { safe_name "$J_SESSION"; sess=$REPLY; }
  safe_name "$J_AGENT_ID"; id=$REPLY
  if [ -f "$STATE/agents/$id" ]; then
    # A resume: the agent is already known; it is running again, in a new run.
    now_parts
    printf 'run_start=%s\n' "$NOW_EPOCH" >> "$STATE/agents/$id"
    printf '%s\n' "$sess" > "$STATE/running/$id"
    return 0
  fi
  now_parts
  safe_name "$J_AGENT_TYPE"; pfile="$STATE/pending/$REPLY"
  rec=""
  if [ -f "$pfile" ]; then
    # Drop stale entries (older than 120 s: spawns that never started), pop the oldest
    # fresh one, keep the rest in order.
    rec=$(awk -F'\t' -v now="$NOW_EPOCH" -v out="$pfile.new" '
      ($1 + 0) < now - 120 { next }
      !done { done = 1; print $1 "\037" $2 "\037" $3 "\037" $4 "\037" $5; next }
      { print > out }' "$pfile")
    if [ -s "$pfile.new" ]; then mv -f "$pfile.new" "$pfile"; else rm -f "$pfile" "$pfile.new"; fi
  fi
  desc=""; model=""; effort=""; name=""
  [ -z "$rec" ] || IFS=$US read -r _ desc model effort name <<< "$rec"
  [ -n "$model" ] || model=$(agent_frontmatter "$J_AGENT_TYPE" model)
  [ -n "$effort" ] || effort=$(agent_frontmatter "$J_AGENT_TYPE" effort)
  oneline "$J_AGENT_TYPE"
  local type=$REPLY
  session_set "$J_SESSION"
  {
    printf 'type=%s\n' "$type"
    printf 'description=%s\n' "$desc"
    printf 'model=%s\n' "${model:-default}"
    printf 'effort=%s\n' "${effort:-default}"
    printf 'name=%s\n' "$name"
    printf 'started=%s\n' "$NOW_EPOCH"
    printf 'since=%s\n' "$NOW_HM"
    printf 'run_start=%s\n' "$NOW_EPOCH"
    printf 'session=%s\n' "$sess"
    printf 'set=%s\n' "$SET_SLUG"
  } > "$STATE/agents/$id"
  printf '%s\n' "$sess" > "$STATE/running/$id"
}

hook_agent_stop() {
  local status desc="" id
  [ -n "$J_AGENT_TYPE" ] || return 0
  status=$(printf '%s\n' "$J_LAST" | grep -o -w -E 'DONE|PARTIAL|BLOCKED|ACCEPT|CHANGES|RECOMMENDATION' | head -n 1)
  [ -n "$status" ] || status=finished
  ensure_dirs
  lock_take
  if [ -n "$J_AGENT_ID" ]; then
    safe_name "$J_AGENT_ID"; id=$REPLY
    if load_agent "$id"; then
      desc=$A_DESC
      record_run "$id" "${A_RUN_START:-$A_STARTED}" "$A_TYPE" "$A_DESC" "$status"
    fi
    rm -f "$STATE/running/$id"
  fi
  oneline "$J_AGENT_TYPE"
  journal_append "← $REPLY" "$status${desc:+ · $desc}"
}

hook_file_changed() {
  local path dir base pdir note=""
  path=$J_FILE
  [ -n "$path" ] || return 0
  case $path in /*) ;; *) path="$WRITER_CWD/$path" ;; esac
  base=${path##*/}
  [ "$base" = index.md ] || return 0
  dir=$(dirname "$path")
  pdir=$(cd "$dir" 2>/dev/null && pwd -P) || return 0
  case "$pdir/" in */.crew/tasks/*) ;; *) return 0 ;; esac
  ensure_dirs
  lock_take
  check_index_additions "$pdir/$base"
  note=$REPLY
  # PostToolUse: the note reaches the lead as additional context.
  [ -z "$note" ] || jq -nc --arg c "Crew: $note" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $c}}'
}

hook_lead() {  # $1 = working | idle
  local sess
  [ -z "$J_AGENT_TYPE" ] || return 0
  ensure_dirs
  safe_name "$J_SESSION"; sess=$REPLY
  note_reach "$sess"
  lock_take
  lead_set "$1" "$sess" keep-stopped
  [ "$1" = working ] || return 0
  # UserPromptSubmit: while work is in flight, one line keeps founder requests out of running agents.
  session_set "$sess"
  in_flight_rows "${SET_DIR:+$SET_DIR/index.md}"
  local flight=$REPLY n
  session_agents "$sess"; n=$REPLY
  [ -n "$flight" ] || [ "$n" -gt 0 ] || return 0
  printf '%s\n' "Crew: work is in flight (${flight:-no index row in progress}${flight:+; }${n} agent(s) running). Queue any request in this message first (.crew/bin/crew request \"<text>\"), then act on it; never add it to a running agent or edit a spec an agent is working from."
}

# UserPromptSubmit in a session another took the lead from: say so, every time (the founder may
# have forgotten this session was the lead). True when it did.
hook_superseded() {
  local by hm
  [ -n "$J_SESSION" ] || return 1
  safe_name "$J_SESSION"
  [ -f "$STATE/superseded/$REPLY" ] && [ ! -e "$STATE/sessions/$REPLY" ] || return 1
  read -r by hm _ < "$STATE/superseded/$REPLY" 2>/dev/null
  printf '%s\n' "Crew: this session is no longer the crew's lead: session ${by:-another} took over this checkout at ${hm:-?}. Do no crew work here (no subagents, crew files or commits for the task set). If the founder asks for crew work, tell them; running /crew here asks to take the lead back."
  return 0
}

# SessionStart startup|resume|clear|fork: remember the lead's model (and effort when given) for
# this session, so a compaction's model can be checked against it. Runs before the session is
# registered, so it has no session guard and writes nothing else.
hook_session_start() {
  [ -n "$J_SESSION" ] && [ -n "$J_HOOK_MODEL" ] || return 0
  ensure_dirs
  safe_name "$J_SESSION"
  printf '%s %s\n' "$J_HOOK_MODEL" "$J_EFFORT_LVL" > "$STATE/lead-model/$REPLY" 2>/dev/null
  local sess=$REPLY
  remember_transcript "$J_SESSION" "$J_TRANSCRIPT"
  note_reach "$sess"
  lock_take
  note_claude "$sess"
  lock_release
  dashboard_autostart "$sess"
}

# PreCompact: guess who is compacting, leave a note for the SessionStart(compact) hook that
# follows, and print custom compaction instructions for that role.
hook_pre_compact() {
  ensure_dirs
  guess_compacting_agent
  now_parts
  printf '%s\n' "$NOW_EPOCH$TAB$G_KIND$TAB$G_ID$TAB$G_LABEL$TAB$G_MODEL$TAB${J_TRIGGER:-auto}" > "$STATE/compact/pending" 2>/dev/null
  compact_instructions "$G_KIND" "$G_ID"
}

# SessionStart compact: the post-compaction reminder, addressed to the role when it is known.
# The journal line and the compaction log follow at the next crew event (see the header).
hook_compact() {
  local kind=unknown id="" pe pk pid _rest alias spec=""
  ensure_dirs
  if [ -f "$STATE/compact/pending" ]; then
    now_parts
    IFS=$TAB read -r pe pk pid _rest < "$STATE/compact/pending"
    rm -f "$STATE/compact/pending"
    case $pe in *[!0-9]*|'') pe=0 ;; esac
    if [ $((NOW_EPOCH - pe)) -le 600 ]; then kind=$pk; id=$pid; fi
  fi
  if [ "$kind" = unknown ] && ! running_any "$J_SESSION"; then kind=lead; fi
  # The compacting agent's model differs from the lead's: a subagent for sure.
  lead_model "$J_SESSION"
  if [ -n "$J_HOOK_MODEL" ] && [ -n "$LM_ALIAS" ]; then
    model_alias "$J_HOOK_MODEL"; alias=$REPLY
    if [ -n "$alias" ] && [ "$alias" != "$LM_ALIAS" ] && [ "$kind" != sub ]; then kind=sub; id=""; fi
  fi
  if [ "$kind" = lead ] && [ -z "$LM_MODEL" ] && [ -n "$J_HOOK_MODEL" ] && ! running_any "$J_SESSION"; then
    safe_name "$J_SESSION"
    printf '%s %s\n' "$J_HOOK_MODEL" "$J_EFFORT_LVL" > "$STATE/lead-model/$REPLY" 2>/dev/null
  fi
  [ "$kind" != sub ] || { spec_path_for "$id"; spec=$REPLY; }
  compact_reminder "$kind" "$spec"
}

run_hook() {
  local mode=${1:-}
  case $mode in
    agent-start|agent-resume|agent-id|agent-stop|file-changed|lead-busy|lead-idle|compact|pre-compact|session-start) ;;
    *) return 0 ;;
  esac
  # Guard 1: this root is a crew project.
  [ -f "$ROOT/.crew/bin/crew" ] || return 0
  INPUT=""
  [ -t 0 ] || INPUT=$(cat 2>/dev/null)
  if ! command -v jq >/dev/null 2>&1; then
    hook_without_jq
    return 0
  fi
  read_hook_json || return 0
  if [ "$mode" = session-start ]; then hook_session_start; return 0; fi
  if [ "$mode" = lead-busy ] && [ -z "$J_AGENT_TYPE" ]; then hook_superseded && return 0; fi
  # Guard 2: a registered crew session (or the wildcard).
  session_registered "$J_SESSION" || return 0
  WRITER_CWD=$PWD
  if [ -n "$J_CWD" ] && [ -d "$J_CWD" ]; then WRITER_CWD=$J_CWD; fi
  remember_transcript "$J_SESSION" "$J_TRANSCRIPT"
  clock_sample
  # Guard 3: per-mode checks live at the top of each handler.
  case $mode in
    agent-start) hook_agent_start ;;
    agent-resume) hook_agent_resume ;;
    agent-id) hook_agent_id ;;
    agent-stop) hook_agent_stop ;;
    file-changed) hook_file_changed ;;
    lead-busy) hook_lead working ;;
    lead-idle) hook_lead idle ;;
    pre-compact) hook_pre_compact ;;
    compact) hook_compact ;;
  esac
  # Compactions whose record has appeared since the last event get their journal line now.
  settle_compactions
  return 0
}

# ---------------------------------------------------------------------------
# Other subcommands
# ---------------------------------------------------------------------------

cmd_journal() {
  if [ $# -eq 0 ] || [ -z "$*" ]; then
    printf 'usage: crew journal <one line, past tense>\n' >&2
    return 1
  fi
  WRITER_CWD=$PWD
  settle_compactions
  clock_sample
  journal_append "lead" "$*"
}

# queue_field TEXT -> REPLY: one line, with the " · " separator the queue format uses replaced.
queue_field() {
  oneline "$1"
  REPLY=${REPLY// · / - }
  REPLY=${REPLY//|/\/}
}

# Where this command's queue and defect log are: QF_HERE (the caller's checkout), QF_SET (the
# task set open there, or ""), QF_QUEUE and QF_DEFECTS (the set's files; the backlog's,
# .crew/queue.md and .crew/defects.md, when no set is open or with BACKLOG=1), QF_BQUEUE and
# QF_BDEFECTS (the backlog's).
queue_files() {
  checkout_of "$PWD"; QF_HERE=$REPLY
  set_here "$QF_HERE"
  QF_SET=$SET_SLUG
  QF_BQUEUE="$QF_HERE/.crew/queue.md"; QF_BDEFECTS="$QF_HERE/.crew/defects.md"
  if [ -n "$SET_DIR" ] && [ "${1:-0}" = 0 ]; then
    QF_QUEUE="$SET_DIR/queue.md"; QF_DEFECTS="$SET_DIR/defects.md"
  else
    QF_QUEUE=$QF_BQUEUE; QF_DEFECTS=$QF_BDEFECTS
  fi
}

# new_queue FILE [SLUG]: create a queue file (a task set's when SLUG is given).
new_queue() {
  [ -f "$1" ] && return 0
  mkdir -p "$(dirname "$1")" 2>/dev/null
  if [ -n "${2:-}" ]; then
    printf '# Crew queue — %s\n\nFounder requests and questions for task set %s; the backlog for later work is .crew/queue.md.\n\n## Requests from the founder\n\n## Questions for the founder\n' "$2" "$2" > "$1"
  else
    printf '# Crew queue\n\n## Requests from the founder\n\n## Questions for the founder\n' > "$1"
  fi
}

# new_defects FILE [SLUG]: create a defect log (a task set's when SLUG is given).
new_defects() {
  [ -f "$1" ] && return 0
  mkdir -p "$(dirname "$1")" 2>/dev/null
  if [ -n "${2:-}" ]; then
    printf '# Crew defects — %s\n\nLeaf defects deferred from the reviews and QA of task set %s (`reference/execution.md` in the crew skill, "Findings: fix now or defer"); the backlog for later work is .crew/defects.md. Kept by `.crew/bin/crew defect`.\n\n## Defects\n' "$2" "$2" > "$1"
  else
    printf '# Crew defects\n\nLeaf defects deferred from reviews and QA (`reference/execution.md` in the crew skill, "Findings: fix now or defer"). Kept by `.crew/bin/crew defect`.\n\n## Defects\n' > "$1"
  fi
}

# entry_file ID FILE... -> REPLY: the first FILE with the entry "- [ID]"; "" when none has it.
entry_file() {
  local id=$1 f
  shift
  REPLY=""
  for f in "$@"; do
    [ -f "$f" ] || continue
    if grep -q -E "^[[:space:]]*- \[$id\]" "$f"; then REPLY=$f; return 0; fi
  done
}

# next_number R|D [DRY] -> REPLY: the next request or defect number, project-wide: one more than
# the highest in any queue or defect log (the backlog's and every task set's, in every checkout)
# and than the last one given (tmp/journal-state/last-R, last-D: a set whose branch is checked out
# nowhere still holds its numbers). With DRY=1 nothing is recorded.
next_number() {
  local k=$1 name n max wt
  case $k in R) name=queue.md ;; *) name=defects.md ;; esac
  max=$(cat "$STATE/last-$k" 2>/dev/null); case $max in ''|*[!0-9]*) max=0 ;; esac
  while IFS= read -r wt; do
    [ -n "$wt" ] && [ -d "$wt/.crew" ] || continue
    n=$(cat "$wt/.crew/$name" "$wt"/.crew/tasks/*/"$name" 2>/dev/null | grep -E "^[[:space:]]*- \[$k[0-9]+\]" |
      grep -o -E "\[$k[0-9]+\]" | tr -cd '0-9\n' | sort -n | tail -n 1)
    case $n in ''|*[!0-9]*) n=0 ;; esac
    [ "$n" -le "$max" ] || max=$n
  done <<EOF
$ROOT
${QF_HERE:-}
$(list_worktrees | cut -d"$US" -f1)
EOF
  REPLY=$((max + 1))
  [ "${2:-0}" = 1 ] || printf '%s\n' "$REPLY" > "$STATE/last-$k"
}

# queue_insert FILE SECTION ENTRY URGENT: put ENTRY in the "## SECTION" of a queue file (created
# when missing): urgent entries first in the section, others after its last entry; an empty
# section gets it after its heading (and after the format comment, when present).
queue_insert() {
  local tmp="$1.new"
  awk -v entry="$3" -v urgent="$4" -v head="## $2" '
    { line[NR] = $0 }
    END {
      sec = 0; send = NR; first = 0; last = 0
      for (i = 1; i <= NR; i++) {
        if (!sec) { if (index(line[i], head) == 1) sec = i; continue }
        if (line[i] ~ /^## /) { send = i - 1; break }
        if (line[i] ~ /^[ \t]*- \[[A-Z][0-9]+\]/) { if (!first) first = i; last = i }
      }
      if (!sec) {
        for (i = 1; i <= NR; i++) print line[i]
        print ""; print head; print ""; print entry
        exit
      }
      if (urgent && first) { at = first - 1; before = 0 }
      else if (last) { at = last; before = 0 }
      else {
        at = sec
        while (at < send && line[at + 1] ~ /^<!--/) { at++; while (at < send && line[at] !~ /-->/) at++ }
        if (at < send && line[at + 1] ~ /^[ \t]*$/) at++
        before = 1
      }
      for (i = 1; i <= NR; i++) {
        print line[i]
        if (i == at) {
          if (before && line[i] !~ /^[ \t]*$/) print ""
          print entry
          if (before && (i == NR || line[i + 1] !~ /^[ \t]*$/)) print ""
        }
      }
      if (at == 0) { print entry }
    }' "$1" > "$tmp" && mv -f "$tmp" "$1"
}

# defects_append FILE ENTRY: add ENTRY at the end of a defect log.
defects_append() {
  local last
  last=$(tail -n 1 "$1")
  case $last in ''|'- [D'*) ;; *) printf '\n' >> "$1" ;; esac
  printf '%s\n' "$2" >> "$1"
}

cmd_request() {
  local text="" affects="" slot="" status="" note="" urgent=0 dry=0 backlog=0 queue n entry tmp line verb where=""
  while [ $# -gt 0 ]; do
    case $1 in
      --affects) affects=${2:-}; shift ;;
      --slot) slot=${2:-}; shift ;;
      --status) status=${2:-}; shift ;;
      --note) note=${2:-}; shift ;;
      --urgent) urgent=1 ;;
      --backlog) backlog=1 ;;
      --dry-run) dry=1 ;;
      --*) printf 'crew request: unknown option %s\n' "$1" >&2; return 1 ;;
      *) text="${text:+$text }$1" ;;
    esac
    shift
  done
  WRITER_CWD=$PWD
  settle_compactions
  clock_sample
  ensure_dirs
  lock_take
  now_parts
  queue_files "$backlog"
  case $text in
    R[0-9]*)
      # A transition: crew request R<n> --status <status> [--slot …] [--affects …] [--note …]
      case $status in queued|scheduled|done|dropped) ;; *) printf 'usage: crew request R<n> --status queued|scheduled|done|dropped [--slot <y>] [--affects <x>] [--note <text>]\n' >&2; return 1 ;; esac
      entry_file "$text" "$QF_QUEUE" "$QF_BQUEUE"; queue=$REPLY
      [ -n "$queue" ] || { printf 'crew request: no entry %s in %s\n' "$text" "${QF_QUEUE#"$QF_HERE"/}${QF_SET:+ or ${QF_BQUEUE#"$QF_HERE"/}}" >&2; return 1; }
      queue_field "$slot"; slot=$REPLY
      queue_field "$affects"; affects=$REPLY
      tmp="$queue.new"
      awk -v id="$text" -v st="$status" -v slot="$slot" -v aff="$affects" '
        !done && $0 ~ ("^[ \t]*- \\[" id "\\]") {
          if ($0 !~ /· status: /) $0 = $0 " · status: queued"
          sub(/· status: [A-Za-z]+/, "· status: " st)
          if (slot != "") {
            if ($0 ~ /· slot: /) sub(/· slot: [^·]*/, "· slot: " slot " "); else sub(/· status: /, "· slot: " slot " · status: ")
          }
          if (aff != "") {
            if ($0 ~ /· affects: /) sub(/· affects: [^·]*/, "· affects: " aff " "); else sub(/· slot: /, "· affects: " aff " · slot: ")
          }
          gsub(/  +·/, " ·"); done = 1
        }
        { print }' "$queue" > "$tmp" && mv -f "$tmp" "$queue"
      line=$(grep -m 1 -E "^[[:space:]]*- \[$text\]" "$queue")
      entry=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*- \[R[0-9]+\] [^·]*· //; s/ · affects:.*$//; s/ · slot:.*$//; s/ · status:.*$//')
      trunc "$entry" 60; entry=$REPLY
      case $status in
        scheduled) verb="Scheduled $text ($entry)${note:+ $note}" ;;
        done) verb="Done $text ($entry)${note:+: $note}" ;;
        dropped) verb="Dropped $text ($entry)${note:+: $note}" ;;
        *) verb="Re-queued $text ($entry)${note:+: $note}" ;;
      esac
      [ "$dry" = 1 ] || journal_append "lead" "$verb"
      printf '%s\n' "$line"
      return 0 ;;
  esac
  [ -n "$text" ] || { printf 'usage: crew request "<request in the founder'"'"'s words>" [--affects <x>] [--slot <y>] [--urgent] [--backlog] [--dry-run]\n' >&2; return 1; }
  [ -z "$status" ] || { printf 'crew request: --status applies to an existing R<n>\n' >&2; return 1; }
  queue=$QF_QUEUE
  if [ "$queue" = "$QF_BQUEUE" ]; then new_queue "$queue"; else new_queue "$queue" "$QF_SET"; fi
  next_number R "$dry"; n=$REPLY
  queue_field "$text"; text=$REPLY
  queue_field "$affects"; affects=$REPLY
  queue_field "$slot"; slot=$REPLY
  if [ -z "$slot" ]; then if [ "$urgent" = 1 ]; then slot="now (urgent)"; else slot="tbd"; fi; fi
  entry="- [R$n] $NOW_DAY · $text · affects: ${affects:-—} · slot: $slot · status: queued"
  if [ "$dry" = 1 ]; then printf '%s\n' "$entry"; return 0; fi
  queue_insert "$queue" "Requests from the founder" "$entry" "$urgent"
  [ "$queue" = "$QF_BQUEUE" ] || where=" (set $QF_SET)"
  [ "$queue" != "$QF_BQUEUE" ] || [ -z "$QF_SET" ] || where=" (backlog)"
  journal_append "lead" "Queued R$n$where: $text${slot:+, slot: $slot}"
  printf '%s\n' "$entry"
}

defect_usage() {
  printf '%s\n' 'usage: crew defect "<symptom>" --where <surface or files> [--from <T07 review>] [--severity low|medium] [--slot <y>] [--backlog] [--dry-run]' \
    '       crew defect D<n> --status deferred|scheduled|fixed|dropped [--promote] [--slot <y>] [--note <text>]' >&2
}

cmd_defect() {
  local text="" where="" from="" severity="" slot="" status="" note="" promote=0 dry=0 backlog=0 n entry tmp line verb log
  while [ $# -gt 0 ]; do
    case $1 in
      --where) where=${2:-}; shift ;;
      --from) from=${2:-}; shift ;;
      --severity) severity=${2:-}; shift ;;
      --slot) slot=${2:-}; shift ;;
      --status) status=${2:-}; shift ;;
      --note) note=${2:-}; shift ;;
      --promote) promote=1 ;;
      --backlog) backlog=1 ;;
      --dry-run) dry=1 ;;
      --*) printf 'crew defect: unknown option %s\n' "$1" >&2; return 1 ;;
      *) text="${text:+$text }$1" ;;
    esac
    shift
  done
  WRITER_CWD=$PWD
  settle_compactions
  clock_sample
  ensure_dirs
  lock_take
  now_parts
  queue_files "$backlog"
  case $text in
    D[0-9]*)
      # A transition: crew defect D<n> --status <status> [--promote] [--slot …] [--note …]
      if [ "$promote" = 1 ] && [ -z "$status" ]; then status=scheduled; fi
      case $status in deferred|scheduled|fixed|dropped) ;; *) defect_usage; return 1 ;; esac
      if [ "$promote" = 1 ] && [ "$status" != scheduled ]; then
        printf 'crew defect: --promote goes with --status scheduled (a promoted defect is fixed now)\n' >&2; return 1
      fi
      entry_file "$text" "$QF_DEFECTS" "$QF_BDEFECTS"; log=$REPLY
      [ -n "$log" ] || { printf 'crew defect: no entry %s in %s\n' "$text" "${QF_DEFECTS#"$QF_HERE"/}${QF_SET:+ or ${QF_BDEFECTS#"$QF_HERE"/}}" >&2; return 1; }
      queue_field "$slot"; slot=$REPLY
      queue_field "$note"; note=$REPLY
      tmp="$log.new"
      # The note stays last on the line ("note: as T13"), and an older one stays until replaced.
      # It reaches awk through the environment: -v would read backslashes as escapes.
      CREW_NOTE=$note awk -v id="$text" -v st="$status" -v slot="$slot" -v prom="$promote" '
        !done && $0 ~ ("^[ \t]*- \\[" id "\\]") {
          note = ENVIRON["CREW_NOTE"]; at = index($0, " · note: ")
          if (at) { if (note == "") note = substr($0, at + length(" · note: ")); $0 = substr($0, 1, at - 1) }
          if ($0 !~ /· status: /) $0 = $0 " · status: deferred"
          sub(/· status: [A-Za-z]+/, "· status: " st)
          if (slot != "") {
            if ($0 ~ /· slot: /) sub(/· slot: [^·]*/, "· slot: " slot " "); else sub(/· status: /, "· slot: " slot " · status: ")
          }
          if (prom == 1 && $0 !~ /· promoted/) $0 = $0 " · promoted"
          gsub(/  +·/, " ·")
          if (note != "") $0 = $0 " · note: " note
          done = 1
        }
        { print }' "$log" > "$tmp" && mv -f "$tmp" "$log"
      line=$(grep -m 1 -E "^[[:space:]]*- \[$text\]" "$log")
      entry=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*- \[D[0-9]+\] [^·]*· //; s/ · where:.*$//')
      trunc "$entry" 60; entry=$REPLY
      if [ "$promote" = 1 ]; then verb="Promoted $text ($entry)${note:+: $note}"
      else
        case $status in
          scheduled) verb="Scheduled $text ($entry)${note:+ $note}" ;;
          fixed) verb="Fixed $text ($entry)${note:+: $note}" ;;
          dropped) verb="Dropped $text ($entry)${note:+: $note}" ;;
          *) verb="Deferred $text again ($entry)${note:+: $note}" ;;
        esac
      fi
      [ "$dry" = 1 ] || journal_append "lead" "$verb"
      printf '%s\n' "$line"
      return 0 ;;
  esac
  [ -n "$text" ] || { defect_usage; return 1; }
  if [ -n "$status" ] || [ "$promote" = 1 ]; then
    printf 'crew defect: --status and --promote apply to an existing D<n>\n' >&2; return 1
  fi
  severity=$(printf '%s' "${severity:-low}" | tr '[:upper:]' '[:lower:]')
  case $severity in
    low|medium) ;;
    high) printf 'crew defect: a high-severity finding is never deferred; fix it in the task\n' >&2; return 1 ;;
    *) printf 'crew defect: --severity is low or medium\n' >&2; return 1 ;;
  esac
  [ -n "$where" ] || { printf 'crew defect: --where is required (the surface or files), so briefs can match the defect to the tasks that touch it\n' >&2; return 1; }
  log=$QF_DEFECTS
  if [ "$log" = "$QF_BDEFECTS" ]; then new_defects "$log"; else new_defects "$log" "$QF_SET"; fi
  next_number D "$dry"; n=$REPLY
  queue_field "$text"; text=$REPLY
  queue_field "$where"; where=$REPLY
  queue_field "$from"; from=$REPLY
  queue_field "$slot"; slot=$REPLY
  [ -n "$slot" ] || slot="end of set"
  entry="- [D$n] $NOW_DAY · $text · where: $where${from:+ · from: $from} · severity: $severity · slot: $slot · status: deferred"
  if [ "$dry" = 1 ]; then printf '%s\n' "$entry"; return 0; fi
  defects_append "$log" "$entry"
  journal_append "lead" "Deferred D$n ($severity): $text, where: $where"
  printf '%s\n' "$entry"
}

# crew carry: closing a set, move its open entries to the backlog of this checkout (which the set's
# merge then brings to the base branch): requests queued or scheduled, questions open, defects
# deferred or scheduled.
cmd_carry() {
  local q d moved="" line id tmp ids="" f
  WRITER_CWD=$PWD
  ensure_dirs
  lock_take
  queue_files 0
  [ -n "$QF_SET" ] || { printf 'crew carry: no task set is open in this checkout\n' >&2; return 1; }
  q=$QF_QUEUE; d=$QF_DEFECTS
  if [ -f "$q" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      id=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*- \[([A-Z][0-9]+)\].*/\1/')
      new_queue "$QF_BQUEUE"
      case $id in
        R*) queue_insert "$QF_BQUEUE" "Requests from the founder" "$line" 0 ;;
        *) queue_insert "$QF_BQUEUE" "Questions for the founder" "$line" 0 ;;
      esac
      moved="${moved:+$moved, }$id"; ids="$ids|$id"
    done <<EOF
$(grep -E '^[[:space:]]*- \[R[0-9]+\].*· status: (queued|scheduled)|^[[:space:]]*- \[F[0-9]+\].*· status: open' "$q")
EOF
  fi
  if [ -f "$d" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      id=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*- \[(D[0-9]+)\].*/\1/')
      new_defects "$QF_BDEFECTS"
      defects_append "$QF_BDEFECTS" "$line"
      moved="${moved:+$moved, }$id"; ids="$ids|$id"
    done <<EOF
$(grep -E '^[[:space:]]*- \[D[0-9]+\].*· status: (deferred|scheduled)' "$d")
EOF
  fi
  if [ -z "$moved" ]; then printf 'Nothing open in task set %s.\n' "$QF_SET"; return 0; fi
  for f in "$q" "$d"; do
    [ -f "$f" ] || continue
    tmp="$f.new"
    awk -v ids="${ids#|}" 'BEGIN { n = split(ids, a, "|"); for (i = 1; i <= n; i++) skip["[" a[i] "]"] = 1 }
      { if (match($0, /^[ \t]*- \[[A-Z][0-9]+\]/)) { k = substr($0, RSTART, RLENGTH); sub(/^[ \t]*- /, "", k); if (k in skip) next } print }' "$f" > "$tmp" && mv -f "$tmp" "$f"
  done
  journal_append "lead" "Carried the open entries of task set $QF_SET to the backlog: $moved"
  printf 'Moved to the backlog (.crew/queue.md, .crew/defects.md): %s\n' "$moved"
}

# where_lines CHECKOUT [SESSION]: what `crew where` prints for CHECKOUT; SESSION is left out of the
# other leads.
where_lines() {
  local co=$1 me=${2:-} br kind f s co2 br2 others="" sets="" wt
  br=$(git -C "$co" symbolic-ref --short -q HEAD 2>/dev/null)
  [ -n "$br" ] || br="detached at $(git -C "$co" rev-parse --short HEAD 2>/dev/null)"
  if [ "$co" = "$ROOT" ]; then kind="main checkout"; else kind="worktree"; fi
  printf 'Checkout: %s (%s), branch %s\n' "$co" "$kind" "$br"
  set_here "$co"
  if [ -n "$SET_DIR" ]; then
    f=${SET_DIR#"$co"/}
    printf 'Task set: %s; its files: %s/index.md, queue.md, defects.md, handoff.md. Backlog: .crew/queue.md, .crew/defects.md\n' "$SET_SLUG" "$f"
    f="$SET_DIR/handoff.md"
  else
    printf 'Task set: none open in this checkout. Queue .crew/queue.md, defects .crew/defects.md, handoff .crew/handoff.md\n'
    f="$co/.crew/handoff.md"
  fi
  [ ! -f "$f" ] || printf 'Handoff: %s (%s)\n' "${f#"$co"/}" "$(sed -n '1s/^# Crew handoff[^0-9]*//p' "$f" | tr -d '\r')"
  for f in "$STATE/sessions"/*; do
    [ -f "$f" ] || continue
    s=${f##*/}
    [ "$s" != any ] && [ "$s" != "$me" ] || continue
    session_alive "$s" || continue
    session_checkout "$s"; co2=$REPLY
    br2=$(git -C "$co2" symbolic-ref --short -q HEAD 2>/dev/null)
    set_here "$co2"
    lead_line "$s"
    others="${others:+$others; }session $s in $co2 (${br2:-detached}${SET_SLUG:+, task set $SET_SLUG}), $REPLY"
  done
  [ -z "$others" ] || printf 'Other leads: %s\n' "$others"
  while IFS= read -r wt; do
    [ -n "$wt" ] && [ "$wt" != "$co" ] || continue
    case $wt in */.claude/worktrees/*) continue ;; esac
    set_here "$wt"
    [ -n "$SET_SLUG" ] || continue
    sets="${sets:+$sets; }$SET_SLUG in $wt"
  done <<EOF
$(list_worktrees | cut -d"$US" -f1)
EOF
  [ -z "$sets" ] || printf 'Open task sets in other checkouts: %s\n' "$sets"
}

cmd_where() {
  checkout_of "$PWD"
  local co=$REPLY
  caller_session
  where_lines "$co" "$REPLY"
}

# conflict_message OTHER CHECKOUT SESSION AGENTS TAKE: why `crew session start` registered nothing.
conflict_message() {
  local other=$1 co=$2 sid=$3 n=$4 label since="" pid start
  if [ "$co" = "$ROOT" ]; then label="the main checkout ($co)"; else label="this worktree ($co)"; fi
  safe_name "$other"
  read -r pid start < "$STATE/claude/$REPLY" 2>/dev/null
  case $start in ''|*[!0-9]*) ;; *) epoch_to_hm "$start"; since=$REPLY; epoch_to_day "$start"; now_parts; [ "$REPLY" = "$NOW_DAY" ] || since="$REPLY $since" ;; esac
  lead_line "$other"
  if [ "$5" = 1 ]; then
    printf '%s\n' "Not registered: session $other still leads $label and runs $n subagent(s). Stop them in that session first (/crew stop there, or its Stop button on the dashboard), then take over again."
    return 0
  fi
  printf '%s\n' "Not registered: another session already leads $label." \
    "  Session $other: Claude Code running${since:+ since $since}; lead $REPLY${n:+, $n subagent(s) running}." \
    "Two leads in one checkout would work on the same task set and files. Ask the founder which they want:" \
    "  1. Take over: .crew/bin/crew session start $sid --take-over (that session is told it no longer leads; refused while it runs subagents)." \
    "  2. Another task set beside it, from a separate checkout: a git worktree (git worktree add <path> -b crew/<slug>), with Claude Code started there and /crew." \
    "  3. Neither: this session does no crew work."
}

# replace_leads CHECKOUT SESSION: SESSION now leads CHECKOUT; every other session registered there
# is superseded (a lead taken over, one whose Claude Code is gone, an earlier session of the same
# process after /clear). Journals a take-over.
replace_leads() {
  local f s co mine pid
  claude_pid; mine=$REPLY
  for f in "$STATE/sessions"/*; do
    [ -f "$f" ] || continue
    s=${f##*/}
    [ "$s" != any ] && [ "$s" != "$2" ] || continue
    session_checkout "$s"; co=$REPLY
    [ "$co" = "$1" ] || continue
    pid=""; read -r pid _ < "$STATE/claude/$s" 2>/dev/null
    if [ -n "$pid" ] && [ "$pid" != "$mine" ] && session_alive "$s"; then
      journal_append "lead" "Took over the lead of this checkout from session $s"
    fi
    supersede "$s" "$2"
  done
}

# only_lead -> REPLY: the one registered session whose Claude Code runs (else the only registered
# session); "" when there are several or none.
only_lead() {
  local f s live="" all="" nl=0 na=0
  for f in "$STATE/sessions"/*; do
    [ -f "$f" ] || continue
    s=${f##*/}
    [ "$s" != any ] || continue
    na=$((na + 1)); all=$s
    if session_alive "$s"; then nl=$((nl + 1)); live=$s; fi
  done
  REPLY=""
  if [ "$nl" = 1 ]; then REPLY=$live; elif [ "$nl" = 0 ] && [ "$na" = 1 ]; then REPLY=$all; fi
}

cmd_session() {
  local sub=${1:-} sid="" take=0 a co other n
  [ $# -gt 0 ] && shift
  for a in "$@"; do
    case $a in
      --take-over) take=1 ;;
      -*) printf 'usage: crew session start [<session-id>] [--take-over] | crew session stop [<session-id>]\n' >&2; return 1 ;;
      *) sid=$a ;;
    esac
  done
  ensure_dirs
  case $sub in
    start)
      lock_take
      if [ -n "$sid" ]; then safe_name "$sid"; sid=$REPLY; else sid=any; fi
      checkout_of "$PWD"; co=$REPLY
      if [ "$sid" != any ]; then
        other_lead "$co" "$sid"; other=$REPLY
        if [ -n "$other" ]; then
          session_agents "$other"; n=$REPLY
          if [ "$take" = 0 ] || [ "$n" -gt 0 ]; then
            [ "$n" -gt 0 ] || n=""
            conflict_message "$other" "$co" "$sid" "$n" "$take"
            lock_release
            return 4
          fi
        fi
      fi
      printf 'checkout=%s\n' "$co" > "$STATE/sessions/$sid"
      rm -f "$STATE/superseded/$sid"
      WRITER_CWD=$PWD
      clock_sample
      note_claude "$sid"
      note_reach "$sid"
      [ "$sid" = any ] || replace_leads "$co" "$sid"
      reap_orphans
      keep_awake_start "$sid"
      # Prune registrations (and per-session notes) older than 30 days.
      find "$STATE/sessions" "$STATE/lead-model" "$STATE/transcripts" "$STATE/claude" "$STATE/reach" \
        "$STATE/leads" "$STATE/superseded" -type f -mtime +30 -exec rm -f {} + 2>/dev/null
      # The lead is at work: it is running this command (this also clears "stopped"). The single
      # lead file of older crews goes: leads/<session> replaces it.
      lead_set working "$sid"
      rm -f "$STATE/lead"
      lock_release
      settle_compactions
      lock_release
      printf 'Crew session registered: %s\n' "$sid"
      where_lines "$co" "$sid"
      dashboard_announce "$sid" ;;
    stop)
      if [ -z "$sid" ]; then caller_session; sid=$REPLY; fi
      if [ -z "$sid" ]; then only_lead; sid=$REPLY; fi
      if [ -z "$sid" ]; then
        printf 'crew session stop: which session? Give its id (several leads are registered, and none runs this command)\n' >&2
        return 1
      fi
      safe_name "$sid"; sid=$REPLY
      lock_take
      # Sticky until the next `crew session start`; the hooks leave it alone.
      lead_set stopped "$sid"
      keep_awake_stop "$sid"
      lock_release
      printf 'Crew marked as stopped at %s\n' "$NOW_HM" ;;
    *) printf 'usage: crew session start [<session-id>] [--take-over] | crew session stop [<session-id>]\n' >&2; return 1 ;;
  esac
}

cmd_running() {
  local f id n=0 all=0 me="" sess tail
  [ "${1:-}" = --all ] && all=1
  if [ "$all" = 0 ]; then caller_session; me=$REPLY; [ -n "$me" ] || all=1; fi
  for f in "$STATE/running"/*; do
    [ -e "$f" ] || continue
    sess=$(cat "$f" 2>/dev/null)
    [ "$all" = 1 ] || [ "$sess" = "$me" ] || continue
    id=${f##*/}
    load_agent "$id" || A_TYPE=unknown
    tail=""; [ -n "$me" ] || tail=" · session ${sess:-?}"
    printf '%s · %s (%s · %s) · %s · since %s%s\n' "$id" "$A_TYPE" "${A_MODEL:-default}" \
      "${A_EFFORT:-default}" "${A_DESC:-(no description)}" "${A_SINCE:-?}" "$tail"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || printf 'No subagent running.\n'
}

cmd_status() {
  settle_compactions
  clock_sample
  lock_release
  dashboard_ensure
}

# ---------------------------------------------------------------------------
# The dashboard (.crew/dashboard/, Node.js 20+)
# ---------------------------------------------------------------------------

DASHBOARD_SERVER=""

# dashboard_node: 0 when .crew/dashboard is installed and Node.js 20+ is on PATH; otherwise
# says why on stderr (unless $1 = quiet) and returns 1.
dashboard_node() {
  local v
  DASHBOARD_SERVER="$CREW_DIR/dashboard/server.mjs"
  if [ ! -f "$DASHBOARD_SERVER" ]; then
    [ "${1:-}" = quiet ] || printf 'crew dashboard: %s is missing; run /crew setup\n' "${DASHBOARD_SERVER#"$ROOT/"}" >&2
    return 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    [ "${1:-}" = quiet ] || printf 'crew dashboard: needs Node.js 20 or later (https://nodejs.org); none on PATH\n' >&2
    return 1
  fi
  v=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)
  case $v in ''|*[!0-9]*) v=0 ;; esac
  if [ "$v" -lt 20 ]; then
    [ "${1:-}" = quiet ] || printf 'crew dashboard: needs Node.js 20 or later (found %s)\n' "$(node -v 2>/dev/null)" >&2
    return 1
  fi
}

# dashboard_ensure: for `crew status`. Start the dashboard unless it runs (or CREW_DASHBOARD=0);
# print its URL either way. Never fails the caller: a missing Node.js is a warning.
dashboard_ensure() {
  local rc
  if [ "${CREW_DASHBOARD:-1}" = 0 ]; then
    printf 'Dashboard: off (CREW_DASHBOARD=0)\n'
    return 0
  fi
  dashboard_node || return 0
  node "$DASHBOARD_SERVER" start --root "$ROOT"
  rc=$?
  [ "$rc" = 3 ] && printf 'Dashboard: %s\n' "$(node "$DASHBOARD_SERVER" url --root "$ROOT")"
  return 0
}

# dashboard_announce SESSION: for `crew session start`. Start the dashboard and print
# "Open the dashboard at <url>" for the lead to pass on, but only when this session started it:
# just now, or through its SessionStart hook (which leaves the session's name in
# dashboard-announce). One already running (another session, the founder, an editor plugin)
# is the founder's already: say nothing.
dashboard_announce() {
  local rc out flag=$STATE/dashboard-announce mine=0
  [ "${CREW_DASHBOARD:-1}" != 0 ] || return 0
  [ "$(cat "$flag" 2>/dev/null)" = "$1" ] && mine=1
  rm -f "$flag"
  dashboard_node || return 0
  out=$(node "$DASHBOARD_SERVER" start --root "$ROOT")
  rc=$?
  if [ "$rc" = 3 ]; then
    [ "$mine" = 1 ] || return 0
    out=$(node "$DASHBOARD_SERVER" url --root "$ROOT") || return 0
  elif [ "$rc" != 0 ]; then
    return 0
  fi
  out=${out##*Dashboard: }
  [ -n "$out" ] && printf 'Open the dashboard at %s\n' "$out"
  return 0
}

# dashboard_autostart SESSION: for the SessionStart hook. Starts the server in the background
# when it is not running (after a reboot, say), and notes that SESSION started it so its
# `crew session start` announces the URL. Prints nothing and never waits.
dashboard_autostart() {
  local pid
  [ "${CREW_DASHBOARD:-1}" != 0 ] || return 0
  [ -f "$CREW_DIR/dashboard/server.mjs" ] && command -v node >/dev/null 2>&1 || return 0
  pid=$(jq -r '.pid // empty' "$TMP_DIR/dashboard.json" 2>/dev/null)
  case $pid in ''|*[!0-9]*) ;; *) kill -0 "$pid" 2>/dev/null && return 0 ;; esac
  printf '%s\n' "${1:-}" > "$STATE/dashboard-announce"
  (node "$CREW_DIR/dashboard/server.mjs" start --root "$ROOT" </dev/null >/dev/null 2>&1 &)
}

cmd_dashboard() {
  local sub=${1:-start}
  [ $# -gt 0 ] && shift
  case $sub in
    start|stop|restart|url) [ $# -eq 0 ] || { printf 'usage: crew dashboard %s\n' "$sub" >&2; return 1; } ;;
    updates)
      local a
      for a in "$@"; do
        case $a in --check|--simulate|--reset) ;; *) printf 'usage: crew dashboard updates [--check] [--simulate | --reset]\n' >&2; return 1 ;; esac
      done ;;
    *) printf 'usage: crew dashboard [start|stop|restart|url|updates]\n' >&2; return 1 ;;
  esac
  dashboard_node || return 1
  node "$DASHBOARD_SERVER" "$sub" --root "$ROOT" "$@"
}

# ---------------------------------------------------------------------------
# Worktrees (D-G5, D-G6)
# ---------------------------------------------------------------------------

DRY=0
# step DESCRIPTION COMMAND...: print the step, then run it (or only print on --dry-run).
step() {
  local d=$1
  shift
  if [ "$DRY" = 1 ]; then printf '  would: %s\n' "$d"; return 0; fi
  printf '  %s\n' "$d"
  "$@"
}

# shellcheck disable=SC2317  # invoked indirectly through step()
json_str() {
  REPLY=${1//\\/\\\\}
  REPLY=${REPLY//\"/\\\"}
}

# shellcheck disable=SC2317  # invoked indirectly through step()
write_worktree_json() {  # path main branch
  local p m b t
  json_str "$1"; p=$REPLY
  json_str "$2"; m=$REPLY
  json_str "$3"; b=$REPLY
  t=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  printf '{\n  "main_root": "%s",\n  "worktree": "%s",\n  "branch": "%s",\n  "started_at": "%s"\n}\n' \
    "$m" "$p" "$b" "$t" > "$1/.crew/tmp/worktree.json"
}

# shellcheck disable=SC2317  # invoked indirectly through step()
copy_missing() {  # src dest
  mkdir -p "$(dirname "$2")" && cp -Rp "$1" "$2"
}

# Expand the .worktreeinclude patterns in the main checkout; print matching relative paths.
worktreeinclude_matches() {  # main include-file
  local line pat m
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    pat=$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case $pat in ''|'#'*) continue ;; '!'*) printf 'skip-negation%s%s\n' "$US" "$pat"; continue ;; esac
    pat=${pat#/}; pat=${pat%/}
    [ -n "$pat" ] || continue
    (
      cd "$1" || exit 0
      IFS=$NL
      # Unquoted on purpose: the pattern may be a glob (for example .env*).
      # shellcheck disable=SC2086
      for m in $pat; do
        [ -e "$m" ] && printf 'match%s%s\n' "$US" "$m"
      done
    )
  done < "$2"
}

wt_setup() {
  local path=$1 main branch inc kind rel script rc=0 copied=0
  if [ -z "$path" ]; then
    path=$(git rev-parse --show-toplevel 2>/dev/null) || { printf 'crew worktree setup: not inside a git checkout; pass a path\n' >&2; return 1; }
  fi
  path=$(cd "$path" 2>/dev/null && pwd -P) || { printf 'crew worktree setup: no such directory: %s\n' "$1" >&2; return 1; }
  cd "$path" || return 1
  main=$(main_worktree_of "$path") || main=""
  branch=$(git -C "$path" symbolic-ref --short -q HEAD 2>/dev/null) || branch=$(git -C "$path" rev-parse --short HEAD 2>/dev/null)
  printf 'crew worktree setup%s: %s (branch %s; main checkout %s)\n' \
    "$([ "$DRY" = 1 ] && printf ' (dry run)')" "$path" "${branch:-none}" "${main:-unknown}"

  # 1. Copy the .worktreeinclude files that are missing here from the main checkout.
  if [ -n "$main" ] && [ "$main" != "$path" ]; then
    inc="$main/.worktreeinclude"; [ -f "$inc" ] || inc="$path/.worktreeinclude"
    if [ -f "$inc" ]; then
      while IFS=$US read -r kind rel; do
        [ -n "$kind" ] || continue
        if [ "$kind" = skip-negation ]; then printf '  skip %s (negated patterns are not supported)\n' "$rel"; continue; fi
        [ -e "$path/$rel" ] && continue
        step "copy $rel from the main checkout" copy_missing "$main/$rel" "$path/$rel" || rc=1
        copied=$((copied + 1))
      done <<EOF
$(worktreeinclude_matches "$main" "$inc")
EOF
      [ "$copied" -gt 0 ] || printf '  .worktreeinclude: nothing missing\n'
    else
      printf '  no .worktreeinclude; nothing to copy\n'
    fi
  else
    printf '  this is the main checkout; nothing to copy\n'
  fi

  # 2. Scratch and task-data directories.
  step "create .crew/tmp/ and .crew/task-data/" mkdir -p "$path/.crew/tmp" "$path/.crew/task-data" || rc=1

  # 3. worktree.json for scripts that need to know where they are.
  step "write .crew/tmp/worktree.json" write_worktree_json "$path" "${main:-$path}" "$branch" || rc=1

  # 4. The project's own setup.
  script="$path/.crew/worktree/setup.sh"
  [ -f "$script" ] || { [ -n "$main" ] && script="$main/.crew/worktree/setup.sh"; }
  if [ -f "$script" ]; then
    if ! step "run .crew/worktree/setup.sh $path" "${BASH:-bash}" "$script" "$path"; then
      printf 'crew worktree setup: .crew/worktree/setup.sh failed\n' >&2
      return 1
    fi
  else
    printf '  no .crew/worktree/setup.sh; skipping project setup\n'
  fi
  [ "$rc" = 0 ] && printf 'crew worktree setup: %s\n' "$([ "$DRY" = 1 ] && printf 'dry run, nothing changed' || printf 'ready')"
  return "$rc"
}

# Copy <wt>/.crew/task-data/ into the lead's checkout: merge per-task dirs, newer file wins.
# shellcheck disable=SC2317  # invoked indirectly through step()
harvest_task_data() {  # src dest
  local rel n=0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    rel=${rel#./}
    if [ ! -e "$2/$rel" ] || [ "$1/$rel" -nt "$2/$rel" ]; then
      mkdir -p "$(dirname "$2/$rel")" && cp -p "$1/$rel" "$2/$rel" && n=$((n + 1))
    fi
  done <<EOF
$(cd "$1" 2>/dev/null && find . -type f)
EOF
  printf '    %s file(s) copied\n' "$n"
}

# Append the event lines of a worktree-local journal to the main journal, with the actor
# suffixed [<branch>]; lines from earlier days carry their date.
# shellcheck disable=SC2317  # invoked indirectly through step()
harvest_journal() {  # wt-journal branch
  local lines
  ensure_dirs
  lock_take
  now_parts
  lines=$(awk -v today="$NOW_DAY" -v sfx=" [$2]" '
    /^## [0-9][0-9][0-9][0-9]-/ { d = substr($0, 4); next }
    /^- / {
      rest = substr($0, 3); i = index(rest, " · ")
      if (i == 0) { print $0 sfx; next }
      time = substr(rest, 1, i - 1); rest = substr(rest, i + 4)
      j = index(rest, " · ")
      if (j == 0) { actor = rest; text = "" } else { actor = substr(rest, 1, j - 1); text = substr(rest, j) }
      if (index(actor, sfx) == 0) actor = actor sfx
      if (d != "" && d != today) time = d " " time
      print "- " time " · " actor text
    }' "$1")
  if [ -n "$lines" ]; then
    journal_open_today
    printf '%s\n' "$lines" >> "$JOURNAL"
    printf '    %s line(s) appended\n' "$(printf '%s\n' "$lines" | wc -l | tr -d ' ')"
  else
    printf '    no journal lines\n'
  fi
  lock_release
}

wt_teardown() {
  local path=$1 abs wt wtb listed="" branch="" p rc=0 script
  if [ -z "$path" ]; then
    printf 'usage: crew worktree teardown <path> [--dry-run]\n' >&2
    return 1
  fi
  case $path in /*) abs=$path ;; *) abs="$PWD/$path" ;; esac
  [ -d "$abs" ] && abs=$(cd "$abs" && pwd -P)
  if [ "$abs" = "$ROOT" ]; then
    printf 'crew worktree teardown: refusing to remove the main checkout\n' >&2
    return 1
  fi
  while IFS=$US read -r wt wtb; do
    [ -n "$wt" ] || continue
    p=$wt; [ -d "$wt" ] && p=$(cd "$wt" && pwd -P)
    if [ "$p" = "$abs" ] || [ "$wt" = "$abs" ]; then listed=$wt; branch=$wtb; break; fi
  done <<EOF
$(list_worktrees)
EOF
  if [ -z "$listed" ]; then
    printf 'crew worktree teardown: %s is not a worktree of %s\n' "$path" "$ROOT" >&2
    return 1
  fi
  printf 'crew worktree teardown%s: %s (branch %s)\n' "$([ "$DRY" = 1 ] && printf ' (dry run)')" "$listed" "${branch:-none}"

  # 1. Harvest task data and worktree-local journal lines (D-G6).
  # Into the checkout this runs in: the lead's (the main one, or the worktree it leads from).
  checkout_of "$PWD"
  if [ -d "$abs/.crew/task-data" ]; then
    step "copy .crew/task-data/ into this checkout (newer file wins)" \
      harvest_task_data "$abs/.crew/task-data" "$REPLY/.crew/task-data" || rc=1
  else
    printf '  no task data in the worktree\n'
  fi
  if [ -f "$abs/.crew/journal.md" ] && [ "$abs/.crew/journal.md" != "$JOURNAL" ]; then
    step "append the worktree's journal lines to the main journal" \
      harvest_journal "$abs/.crew/journal.md" "${branch:-detached}" || rc=1
  fi

  # 2. The project's own teardown.
  script="$CREW_DIR/worktree/teardown.sh"
  if [ -f "$script" ] && [ -d "$abs" ]; then
    if ! step "run .crew/worktree/teardown.sh $listed" "${BASH:-bash}" "$script" "$abs"; then
      printf 'crew worktree teardown: teardown.sh failed; continuing with the removal\n' >&2
      rc=1
    fi
  fi

  # 3. Remove the worktree, unlocking it if git refuses, then delete its branch.
  if [ -d "$abs" ]; then
    if ! step "git worktree remove --force $listed" git -C "$ROOT" worktree remove --force "$listed" 2>/dev/null; then
      step "git worktree unlock $listed" git -C "$ROOT" worktree unlock "$listed" 2>/dev/null
      step "git worktree remove --force $listed" git -C "$ROOT" worktree remove --force "$listed" || rc=1
    fi
  else
    step "git worktree prune (the directory is already gone)" git -C "$ROOT" worktree prune || rc=1
  fi
  if [ -n "$branch" ]; then
    step "git branch -D $branch" git -C "$ROOT" branch -D "$branch" || rc=1
  fi
  if [ "$rc" = 0 ]; then
    printf 'crew worktree teardown: %s\n' "$([ "$DRY" = 1 ] && printf 'dry run, nothing changed' || printf 'done')"
  fi
  return "$rc"
}

cmd_worktree() {
  local sub=${1:-} path="" a
  [ $# -gt 0 ] && shift
  for a in "$@"; do
    case $a in
      --dry-run) DRY=1 ;;
      -*) printf 'crew worktree: unknown option %s\n' "$a" >&2; return 1 ;;
      *) path=$a ;;
    esac
  done
  case $sub in
    setup) wt_setup "$path" ;;
    teardown) wt_teardown "$path" ;;
    *) printf 'usage: crew worktree setup [<path>] [--dry-run] | crew worktree teardown <path> [--dry-run]\n' >&2; return 1 ;;
  esac
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

resolve_root
set_paths

case ${1:-} in
  hook)
    # Silent unless debugging; always exit 0.
    [ -n "${CREW_DEBUG:-}" ] || exec 2>/dev/null
    shift
    run_hook "$@"
    lock_release
    exit 0
    ;;
  journal) shift; cmd_journal "$@"; rc=$? ;;
  request) shift; cmd_request "$@"; rc=$? ;;
  defect) shift; cmd_defect "$@"; rc=$? ;;
  session) shift; cmd_session "$@"; rc=$? ;;
  running) shift; cmd_running "$@"; rc=$? ;;
  where) cmd_where; rc=$? ;;
  carry) cmd_carry; rc=$? ;;
  status) cmd_status; rc=$? ;;
  dashboard) shift; cmd_dashboard "$@"; rc=$? ;;
  worktree) shift; cmd_worktree "$@"; rc=$? ;;
  help|-h|--help) usage; rc=0 ;;
  *) usage >&2; rc=1 ;;
esac
lock_release
exit "$rc"
