#!/usr/bin/env bash
# crew: journal, dashboard, hook handler and worktree helper for the crew skill.
#
# Installed by `/crew setup` as <project>/.crew/bin/crew. Compatible with bash 3.2
# (macOS /bin/bash): no associative arrays, no ${var,,}, no mapfile.
#
# Modes
#   crew journal <text...>              Log a lead action: "- HH:MM · lead · <text>".
#   crew request "<text>" [--affects <x>] [--slot <y>] [--urgent] [--dry-run]
#                                       Queue a founder request as the next R<n> in
#                                       .crew/queue.md, journal it, refresh the dashboard.
#   crew request R<n> --status queued|scheduled|done|dropped [--slot <y>] [--affects <x>] [--note <t>]
#                                       Move a request along; journals the transition.
#   crew session start [<session-id>]   Register a crew session (empty id: wildcard "any").
#   crew session stop                   Mark the crew as stopped by the founder (/crew stop).
#   crew running                        List running subagents (kept by the hooks).
#   crew status                         Render the dashboard .crew/status.md now.
#   crew worktree setup [<path>] [--dry-run]
#                                       Prepare a worktree: .worktreeinclude copies,
#                                       .crew/tmp/, .crew/task-data/, worktree.json,
#                                       then .crew/worktree/setup.sh.
#   crew worktree teardown <path> [--dry-run]
#                                       Harvest task data and journal lines into the main
#                                       checkout, run .crew/worktree/teardown.sh, remove
#                                       the worktree and its branch.
#   crew hook <mode>                    Claude Code hook handler; reads the hook JSON on
#                                       stdin. Modes: agent-start (PreToolUse Agent),
#                                       agent-resume (PreToolUse SendMessage), agent-id
#                                       (SubagentStart), agent-stop (SubagentStop),
#                                       file-changed (PostToolUse Edit|Write), lead-busy
#                                       (UserPromptSubmit), lead-idle (Stop), session-start
#                                       (SessionStart startup|resume|clear|fork), pre-compact
#                                       (PreCompact), compact (SessionStart compact).
#
# Rules that matter
#   - Every `crew hook` mode exits 0, whatever happens: exit 2 from a PreToolUse hook
#     would block the tool call, and from a Stop hook would keep the lead from stopping.
#     A hook that fails a guard prints nothing and changes no file.
#   - Hook modes need jq. Everything else works without it.
#   - All files live in the main checkout of the repository (root resolution below), so
#     hooks running in worktrees write one journal and one dashboard per repository.
#   - Hooks never read a whole transcript: tail, grep and jq on bounded ranges only.
#   - Set CREW_DEBUG=1 to see stderr from hook modes.
#
# Compactions (Claude Code 2.1.303, verified 2026-10-20)
#   - PreCompact, SessionStart(compact) and PostCompact fire inside subagents too, but their
#     input carries the parent's session id and the MAIN transcript path, and no agent_id or
#     agent_type. The input cannot say who compacted. `pre-compact` guesses it from the
#     transcripts (the agent whose newest API response carried the largest context is the one
#     that hit its window) and `compact` cross-checks the input's `model` against the lead's
#     model recorded by `session-start`. When unsure, the reminder is phrased for both roles;
#     a subagent never receives the lead's instructions.
#   - The compact_boundary record (preTokens, postTokens, durationMs, trigger) is written to
#     the transcript AFTER the compaction hooks have run, so the detailed journal line and the
#     compaction log are written by the next crew event ("settling"), with the compaction's
#     own local time.

# Make sure git acts on the directories we name, not on an inherited repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

US=$'\037'   # field separator for internal records (never collapses empty fields)
TAB=$'\t'
NL=$'\n'

# ---------------------------------------------------------------------------
# Paths and root resolution
# ---------------------------------------------------------------------------

# Print the main worktree (main checkout) of the repository containing $1.
main_worktree_of() {
  local common
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ -n "$common" ] || return 1
  case $common in
    */.git) dirname "$common" ;;
    # A bare repository or a submodule (.git/modules/<name>): use the checkout itself.
    *) git -C "$1" rev-parse --show-toplevel 2>/dev/null ;;
  esac
}

# Root resolution (D-H6): CLAUDE_PROJECT_DIR's main worktree, else the main worktree of
# the repository containing this script, else two directories above the script.
resolve_root() {
  local script_dir r=""
  script_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P) || script_dir=$(dirname "$0")
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    r=$(main_worktree_of "$CLAUDE_PROJECT_DIR") || r=""
    [ -n "$r" ] || r=$CLAUDE_PROJECT_DIR
  else
    r=$(main_worktree_of "$script_dir") || r=""
    [ -n "$r" ] || r="$script_dir/../.."
  fi
  ROOT=$(cd "$r" 2>/dev/null && pwd -P) || ROOT=$r
}

set_paths() {
  CREW_DIR="$ROOT/.crew"
  TMP_DIR="$CREW_DIR/tmp"
  STATE="$TMP_DIR/journal-state"
  JOURNAL="$CREW_DIR/journal.md"
  STATUS="$CREW_DIR/status.md"
  LOCK="$TMP_DIR/journal.lock"
}

ensure_dirs() {
  mkdir -p "$TMP_DIR" "$CREW_DIR/task-data" "$STATE/sessions" "$STATE/pending" \
    "$STATE/agents" "$STATE/running" "$STATE/transcripts" "$STATE/lead-model" \
    "$STATE/compact/scan" "$STATE/index-rows" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Small text helpers
# ---------------------------------------------------------------------------

# A UTF-8 locale for character-accurate truncation (hooks may run with LANG unset).
UTF8_LOCALE=""
UTF8_PICKED=0
pick_utf8() {
  local l
  UTF8_PICKED=1
  for l in C.UTF-8 en_US.UTF-8 C.utf8 en_US.utf8; do
    # shellcheck disable=SC2030,SC2031  # the subshell only probes whether the locale works
    if (LC_ALL=$l; t='→'; [ ${#t} -eq 1 ]) 2>/dev/null; then UTF8_LOCALE=$l; return; fi
  done
}

# oneline TEXT -> sets REPLY to TEXT with newlines, CRs and tabs replaced by spaces.
oneline() {
  REPLY=${1//$'\r'/ }
  REPLY=${REPLY//$NL/ }
  REPLY=${REPLY//$TAB/ }
}

# trunc TEXT MAX -> sets REPLY to TEXT cut to MAX characters (ending in an ellipsis).
trunc() {
  [ "$UTF8_PICKED" = 1 ] || pick_utf8
  if [ -n "$UTF8_LOCALE" ]; then local LC_ALL=$UTF8_LOCALE; fi
  REPLY=$1
  if [ ${#REPLY} -gt "$2" ]; then REPLY="${REPLY:0:$(($2 - 1))}…"; fi
}

# safe_name TEXT -> sets REPLY to TEXT usable as a file name.
safe_name() {
  REPLY=$(printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_')
  case $REPLY in ''|.|..) REPLY="_$REPLY" ;; esac
}

now_parts() {  # sets NOW_DAY (YYYY-MM-DD), NOW_HM (HH:MM), NOW_EPOCH
  local d
  d=$(date '+%Y-%m-%d %H:%M %s')
  NOW_DAY=${d%% *}; d=${d#* }
  NOW_HM=${d%% *}; NOW_EPOCH=${d#* }
}

# iso_to_epoch "2026-10-20T07:30:54.318Z" -> REPLY epoch seconds (empty when unparsable).
# The system's date does the conversion (BSD form first, then GNU), never arithmetic by hand.
iso_to_epoch() {
  local t=${1%%.*}
  t=${t%Z}
  REPLY=$(date -u -j -f '%Y-%m-%dT%H:%M:%S' "$t" '+%s' 2>/dev/null) ||
    REPLY=$(date -u -d "${t}Z" '+%s' 2>/dev/null) || REPLY=""
  case $REPLY in ''|*[!0-9]*) REPLY="" ;; esac
}

# epoch_to_hm EPOCH -> REPLY local HH:MM; epoch_to_day EPOCH -> REPLY local YYYY-MM-DD.
epoch_to_hm() { REPLY=$(date -r "$1" '+%H:%M' 2>/dev/null || date -d "@$1" '+%H:%M' 2>/dev/null); }
epoch_to_day() { REPLY=$(date -r "$1" '+%Y-%m-%d' 2>/dev/null || date -d "@$1" '+%Y-%m-%d' 2>/dev/null); }

# file_size PATH -> prints the size in bytes (fails when the file is missing).
file_size() { stat -f %z "$1" 2>/dev/null || stat -c %s "$1" 2>/dev/null; }

# fmt_k 166954 -> REPLY "167k"; fmt_secs 6600 -> REPLY "1 h 50 min".
fmt_k() { REPLY=$(awk -v n="${1:-0}" 'BEGIN { if (n >= 1000) printf "%dk", int(n / 1000 + 0.5); else printf "%d", n }'); }
fmt_secs() {
  local s=${1:-0}
  case $s in ''|*[!0-9]*) s=0 ;; esac
  if [ "$s" -lt 100 ]; then REPLY="$s s"
  elif [ "$s" -lt 3600 ]; then REPLY="$((s / 60)) min"
  else REPLY="$((s / 3600)) h $(((s % 3600) / 60)) min"; fi
}

# ---------------------------------------------------------------------------
# Lock (mkdir is atomic). Re-entrant within one process.
# ---------------------------------------------------------------------------

LOCK_HELD=0
lock_take() {
  local i=0
  [ "$LOCK_HELD" = 1 ] && return 0
  mkdir -p "$TMP_DIR" 2>/dev/null
  while ! mkdir "$LOCK" 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -ge 50 ]; then
      # Could not get the lock: carry on without it. A lock older than a minute was
      # left by a killed process; clear it so later writers do not wait again.
      if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "$LOCK" 2>/dev/null; fi
      return 1
    fi
    sleep 0.1
  done
  LOCK_HELD=1
}
lock_release() {
  if [ "$LOCK_HELD" = 1 ]; then rmdir "$LOCK" 2>/dev/null; LOCK_HELD=0; fi
}
trap lock_release EXIT
trap 'lock_release; exit 0' HUP INT TERM

# ---------------------------------------------------------------------------
# Journal
# ---------------------------------------------------------------------------

# The writer's branch suffix " [<branch>]" when WRITER_CWD is in a linked worktree of
# this repository; empty otherwise. Sets SUFFIX.
writer_suffix() {
  local out gd cd br
  SUFFIX=""
  [ -n "${WRITER_CWD:-}" ] && [ -d "$WRITER_CWD" ] || return 0
  out=$(git -C "$WRITER_CWD" rev-parse --path-format=absolute --git-dir --git-common-dir \
    --abbrev-ref HEAD 2>/dev/null) || return 0
  gd=$(printf '%s\n' "$out" | sed -n 1p)
  cd=$(printf '%s\n' "$out" | sed -n 2p)
  br=$(printf '%s\n' "$out" | sed -n 3p)
  [ -n "$gd" ] && [ "$gd" != "$cd" ] || return 0
  [ "$(dirname "$cd")" = "$ROOT" ] || return 0
  if [ "$br" = HEAD ] || [ -z "$br" ]; then
    br=$(git -C "$WRITER_CWD" rev-parse --short HEAD 2>/dev/null) || br=detached
  fi
  SUFFIX=" [$br]"
}

# Create the journal if missing and add today's heading if the last one is another day.
# Call with the lock held (or after failing to get it).
journal_open_today() {
  if [ ! -s "$JOURNAL" ]; then
    printf '%s\n\n%s\n' "# Crew journal" \
      "Informational history of crew activity, newest at the bottom. Not committed." > "$JOURNAL"
  fi
  local last
  last=$(grep -E '^## [0-9]{4}-[0-9]{2}-[0-9]{2}' "$JOURNAL" 2>/dev/null | tail -n 1)
  if [ "$last" != "## $NOW_DAY" ]; then printf '\n## %s\n' "$NOW_DAY" >> "$JOURNAL"; fi
}

# journal_append HEAD TEXT: append "- HH:MM · HEAD[ [branch]] · TEXT", then render.
# JOURNAL_AT=<epoch> in the environment dates the line at that moment instead of now (used
# for compactions, which are logged when their record becomes readable). An earlier day is
# written as "YYYY-MM-DD HH:MM".
journal_append() {
  local head text when
  oneline "$1"; head=$REPLY
  oneline "$2"; text=$REPLY
  ensure_dirs
  lock_take
  now_parts
  writer_suffix
  journal_open_today
  when=$NOW_HM
  if [ -n "${JOURNAL_AT:-}" ]; then
    epoch_to_hm "$JOURNAL_AT"; when=$REPLY
    epoch_to_day "$JOURNAL_AT"
    [ "$REPLY" = "$NOW_DAY" ] || when="$REPLY $when"
  fi
  if [ -n "$text" ]; then
    printf '%s\n' "- $when · $head$SUFFIX · $text" >> "$JOURNAL"
  else
    printf '%s\n' "- $when · $head$SUFFIX" >> "$JOURNAL"
  fi
  render_locked
}

# ---------------------------------------------------------------------------
# Agent state
# ---------------------------------------------------------------------------

# Read model: or effort: from the frontmatter of <root>/.claude/agents/<type>.md.
agent_frontmatter() {
  local f="$ROOT/.claude/agents/$1.md"
  case $1 in */*|'') return 0 ;; esac
  [ -f "$f" ] || return 0
  awk -v k="$2" '
    NR == 1 { if ($0 !~ /^---[ \t\r]*$/) exit; next }
    /^---[ \t\r]*$/ { exit }
    index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      sub(/[ \t]+#.*$/, "", v); gsub(/^[ \t]+|[ \t\r]+$/, "", v)
      gsub(/^["\047]|["\047]$/, "", v)
      print v; exit
    }' "$f" 2>/dev/null
}

# load_agent ID: sets A_TYPE A_DESC A_MODEL A_EFFORT A_NAME A_SINCE A_STARTED from agents/<id>.
load_agent() {
  local line
  A_TYPE=""; A_DESC=""; A_MODEL=""; A_EFFORT=""; A_NAME=""; A_SINCE=""; A_STARTED=""
  [ -f "$STATE/agents/$1" ] || return 1
  while IFS= read -r line; do
    case $line in
      type=*) A_TYPE=${line#type=} ;;
      description=*) A_DESC=${line#description=} ;;
      model=*) A_MODEL=${line#model=} ;;
      effort=*) A_EFFORT=${line#effort=} ;;
      name=*) A_NAME=${line#name=} ;;
      since=*) A_SINCE=${line#since=} ;;
      started=*) A_STARTED=${line#started=} ;;
    esac
  done < "$STATE/agents/$1"
  return 0
}

# ---------------------------------------------------------------------------
# Compactions: who compacted, reminders, journal lines, economics
# ---------------------------------------------------------------------------

# Prices in USD per million tokens: Anthropic list prices as read on 2026-10-20 from
# https://platform.claude.com/docs/en/about-claude/pricing (the one place prices live;
# update the date with the numbers). Haiku 5.5 has a second tier for prompts over 100K.
# price_for MODEL PRE_TOKENS -> sets P_ALIAS and P_READ P_OUT P_IN P_WRITE5M (empty: unknown).
price_for() {
  model_alias "$1"; P_ALIAS=$REPLY
  P_READ=""; P_OUT=""; P_IN=""; P_WRITE5M=""
  case $P_ALIAS in
    fable)  P_READ=0.25; P_OUT=50;   P_IN=10;   P_WRITE5M=12.50 ;;
    opus)   P_READ=0.20; P_OUT=20;   P_IN=4;    P_WRITE5M=5 ;;
    sonnet) P_READ=0.10; P_OUT=10;   P_IN=2;    P_WRITE5M=2.50 ;;
    haiku)
      if [ "${2:-0}" -gt 100000 ] 2>/dev/null; then P_READ=0.05; P_OUT=2.50; P_IN=0.50; P_WRITE5M=0.625
      else P_READ=0.01; P_OUT=0.50; P_IN=0.10; P_WRITE5M=0.125; fi ;;
  esac
}

# model_alias MODEL -> REPLY: fable | opus | sonnet | haiku | "" (unknown or "default").
model_alias() {
  case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    *fable*|*mythos*) REPLY=fable ;;
    *opus*) REPLY=opus ;;
    *sonnet*) REPLY=sonnet ;;
    *haiku*) REPLY=haiku ;;
    *) REPLY="" ;;
  esac
}

# compact_cost PRE POST MODEL -> REPLY: estimated USD as a number ("" when the model is unknown).
# The summarization request re-reads the context at the cache-read price and writes the
# summary at the output price. After an idle gap longer than the cache TTL the re-read costs
# the full input price instead (up to 10x more); a hook cannot tell, so this is the warm case.
compact_cost() {
  price_for "$3" "$1"
  REPLY=""
  [ -n "$P_READ" ] || return 0
  REPLY=$(awk -v pre="$1" -v post="$2" -v r="$P_READ" -v o="$P_OUT" 'BEGIN { printf "%.4f", (pre * r + post * o) / 1000000 }')
}

# fmt_usd 0.3312 -> REPLY "≈$0.33" ("" for empty, "<$0.01" for tiny).
fmt_usd() {
  REPLY=""
  [ -n "$1" ] || return 0
  REPLY=$(awk -v c="$1" 'BEGIN { if (c < 0.005) printf "<$0.01"; else printf "≈$%.2f", c }')
}

# transcript_kind PATH -> T_KIND (lead | sub) and T_ID (the agent id for a subagent).
# A subagent's transcript is <project>/<session>/subagents/agent-<id>.jsonl.
transcript_kind() {
  T_KIND=lead; T_ID=""
  case $1 in
    */subagents/agent-*.jsonl) T_ID=${1##*/agent-}; T_ID=${T_ID%.jsonl}; T_KIND=sub ;;
  esac
}

# describe_agent ID META_DIR: sets D_LABEL D_TYPE D_NAME D_DESC D_MODEL D_EFFORT D_STARTED from the
# crew agent record, completed from the transcript's agent-<id>.meta.json and the agent
# definition's frontmatter. Label: "s2a-t07-builder (builder · sonnet · high)".
describe_agent() {
  local id=$1 meta="$2/agent-$1.meta.json" m mt mn mm me md
  D_TYPE=""; D_NAME=""; D_DESC=""; D_MODEL=""; D_EFFORT=""; D_STARTED=""
  safe_name "$id"
  if load_agent "$REPLY"; then
    D_TYPE=$A_TYPE; D_NAME=$A_NAME; D_DESC=$A_DESC; D_MODEL=$A_MODEL; D_EFFORT=$A_EFFORT; D_STARTED=$A_STARTED
  fi
  [ "$D_MODEL" != default ] || D_MODEL=""
  [ "$D_EFFORT" != default ] || D_EFFORT=""
  if [ -f "$meta" ]; then
    m=$(jq -r '[.agentType // "", .name // "", .model // "", .effort // "", .description // ""] | join("\u001f")' "$meta" 2>/dev/null)
    IFS=$US read -r mt mn mm me md <<< "$m"
    [ -n "$D_TYPE" ] || D_TYPE=$mt
    [ -n "$D_NAME" ] || D_NAME=$mn
    [ -n "$D_MODEL" ] || D_MODEL=$mm
    [ -n "$D_EFFORT" ] || D_EFFORT=$me
    [ -n "$D_DESC" ] || D_DESC=$md
  fi
  [ -n "$D_MODEL" ] || D_MODEL=$(agent_frontmatter "$D_TYPE" model)
  [ -n "$D_EFFORT" ] || D_EFFORT=$(agent_frontmatter "$D_TYPE" effort)
  oneline "$D_NAME"; D_NAME=$REPLY
  oneline "$D_TYPE"; D_TYPE=$REPLY
  model_alias "$D_MODEL"; m=${REPLY:-$D_MODEL}
  if [ -n "$D_NAME" ]; then D_LABEL="$D_NAME (${D_TYPE:-subagent} · ${m:-?} · ${D_EFFORT:-?})"
  else D_LABEL="${D_TYPE:-subagent} (${m:-?} · ${D_EFFORT:-?})"; fi
}

# lead_model SID: sets LM_MODEL LM_ALIAS LM_EFFORT LM_LABEL from what session-start recorded.
lead_model() {
  LM_MODEL=""; LM_ALIAS=""; LM_EFFORT=""; LM_LABEL=lead
  safe_name "$1"
  { read -r LM_MODEL LM_EFFORT < "$STATE/lead-model/$REPLY"; } 2>/dev/null || return 0
  model_alias "$LM_MODEL"; LM_ALIAS=${REPLY:-$LM_MODEL}
  [ -z "$LM_MODEL" ] || LM_LABEL="lead ($LM_ALIAS${LM_EFFORT:+ · $LM_EFFORT})"
}

# remember_transcript SID PATH: keep the main transcript path per session, so commands run
# by the lead (no hook input) can settle compactions too.
remember_transcript() {
  [ -n "$1" ] && [ -n "$2" ] || return 0
  safe_name "$1"
  local f="$STATE/transcripts/$REPLY"
  [ "$(cat "$f" 2>/dev/null)" = "$2" ] || printf '%s\n' "$2" > "$f" 2>/dev/null
}

# last_context PATH -> REPLY: context size (input + cache read + cache write tokens) of the
# newest API response in the transcript, read from its last 400 KB; 0 when none.
last_context() {
  REPLY=$(tail -c 400000 "$1" 2>/dev/null | grep '"type":"assistant"' | grep '"usage":{' | tail -n 1 |
    jq -r '.message.usage | ((.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0))' 2>/dev/null)
  case $REPLY in ''|*[!0-9]*) REPLY=0 ;; esac
}

running_any() { ls "$STATE/running"/* >/dev/null 2>&1; }

# guess_compacting_agent: the compaction hooks do not say which agent is compacting (see the
# header). Pick the transcript whose newest API response carried the largest context: that
# is the one that reached its window. Sets G_KIND (lead | sub | unknown), G_ID, G_LABEL, G_MODEL.
guess_compacting_agent() {
  local f id best=0 second=0 best_kind=lead best_id="" c dir
  G_KIND=lead; G_ID=""; G_LABEL=lead; G_MODEL=""
  lead_model "$J_SESSION"; G_LABEL=$LM_LABEL; G_MODEL=$LM_MODEL
  running_any || return 0
  [ -n "$J_TRANSCRIPT" ] && [ -f "$J_TRANSCRIPT" ] || { G_KIND=unknown; return 0; }
  dir="${J_TRANSCRIPT%.jsonl}/subagents"
  last_context "$J_TRANSCRIPT"; best=$REPLY
  for f in "$STATE/running"/*; do
    [ -e "$f" ] || continue
    id=${f##*/}
    [ -f "$dir/agent-$id.jsonl" ] || continue
    last_context "$dir/agent-$id.jsonl"; c=$REPLY
    if [ "$c" -gt "$best" ]; then second=$best; best=$c; best_kind=sub; best_id=$id
    elif [ "$c" -gt "$second" ]; then second=$c; fi
  done
  # Ambiguous when the runner-up is within 15% of the best, or nothing was readable.
  if [ "$best" -le 0 ] || [ $((second * 100)) -gt $((best * 85)) ]; then G_KIND=unknown; return 0; fi
  G_KIND=$best_kind; G_ID=$best_id
  if [ "$G_KIND" = sub ]; then describe_agent "$G_ID" "$dir"; G_LABEL=$D_LABEL; G_MODEL=$D_MODEL; fi
}

# live_indexes: prints the main-checkout index files without a Closed: line.
live_indexes() {
  local f rec closed
  for f in "$CREW_DIR"/tasks/*/index.md; do
    [ -f "$f" ] || continue
    rec=$(parse_index summary "$f" 2>/dev/null)
    IFS=$US read -r _ _ _ closed _ _ <<< "$rec"
    [ -z "$closed" ] && printf '%s\n' "$f"
  done
}

# in_flight_rows -> REPLY: "T07 in progress, T08 in review" over the live indexes; "" when none.
in_flight_rows() {
  local f id key
  REPLY=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    while IFS=$US read -r id key _; do
      case $key in
        progress|review|rework) status_look "$key"; REPLY="${REPLY:+$REPLY, }$id $WORD" ;;
      esac
    done <<EOF
$(parse_index rows "$f" 2>/dev/null)
EOF
  done <<EOF
$(live_indexes)
EOF
}

# spec_path_for AGENT_ID -> REPLY: the spec of the task named by the agent's description
# ("T07 …"), relative to the project root; "" when unknown.
spec_path_for() {
  local f id spec tnum re='^[Tt]0*([0-9]+)([^0-9]|$)' want
  REPLY=""
  [ -n "$1" ] || return 0
  safe_name "$1"
  load_agent "$REPLY" || return 0
  [[ $A_DESC =~ $re ]] || return 0
  want=${BASH_REMATCH[1]}
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    while IFS=$US read -r id _ _ _ _ spec; do
      tnum=$(printf '%s' "$id" | tr -cd '0-9' | sed 's/^0*//')
      if [ "$tnum" = "$want" ] && [ -n "$spec" ]; then
        spec=${spec//\`/}
        REPLY="${f%/index.md}/$spec"; REPLY=${REPLY#"$ROOT"/}
        return 0
      fi
    done <<EOF
$(parse_index rows "$f" 2>/dev/null)
EOF
  done <<EOF
$(live_indexes)
EOF
}

# compact_instructions KIND ID: custom compaction instructions for the summarizer (PreCompact
# stdout). Phrased for the role when it is known, for both roles when it is not.
compact_instructions() {
  local lead sub agents="" f id idx
  if [ "$1" != sub ]; then
    for f in "$STATE/running"/*; do
      [ -e "$f" ] || continue
      id=${f##*/}
      load_agent "$id" || continue
      agents="${agents:+$agents; }${A_NAME:-$A_TYPE} [$id]: ${A_DESC:-?}"
    done
    idx=$(live_indexes | sed "s#^$ROOT/##" | tr '\n' ' ')
  fi
  lead="You are the lead of a crew of subagents, working under the crew skill. Keep in the summary: 1) the crew rules in force, above all that every founder request becomes a queue entry (.crew/bin/crew request) before anything else and is never added to a running agent; 2) the active task set and each task's status${idx:+ (index: ${idx% })}; 3) every live subagent with its name, id, task and what you are waiting for from it${agents:+ (now: $agents)}; 4) founder requests or questions not yet in .crew/queue.md, and decisions not yet in the decisions log; 5) the exact next step. Keep file paths verbatim."
  sub="You are a subagent of a crew. Keep in the summary: your task id and the spec path, each acceptance criterion with whether it is verified and the evidence, every file you changed, the report format your brief requires (its first line is the status keyword), decisions and deviations so far, and your exact next step. Keep file paths verbatim."
  case $1 in
    lead) printf '%s\n' "Crew: $lead" ;;
    sub) printf '%s\n' "Crew: $sub" ;;
    *) printf '%s\n' "Crew: if you are the main session: $lead If you are a subagent: $sub" ;;
  esac
}

# compact_reminder KIND SPEC: the post-compaction reminder (SessionStart compact stdout),
# conditional so that nothing already in context is re-read.
compact_reminder() {
  local lead sub
  lead="If any of these are no longer in your context, read them: CREW.md (path in the CLAUDE.md or AGENTS.md pointer), .crew/queue.md, the active index under .crew/tasks/, and the state file. Run ListAgents (or \`.crew/bin/crew running\`) if you are not sure which subagents are live. If the crew skill's rules are no longer in your context, invoke the crew skill again. Founder messages are still governed by the request rules: queue first (\`.crew/bin/crew request\`), never add scope to a running agent."
  sub="If your task spec or brief is no longer in your context, re-read it${2:+ (spec: $2)}, then continue from your last verified step and report in the format your brief asked for."
  case $1 in
    lead) printf '%s\n' "Crew: context was compacted. $lead" ;;
    sub) printf '%s\n' "Crew: context was compacted. $sub" ;;
    *) printf '%s\n' "Crew: context was compacted. If you are a subagent: $sub If you are the lead (the main session): $lead" ;;
  esac
}

# turns_in PATH FROM [TO] -> REPLY: distinct assistant message ids (API requests) in the byte range.
turns_in() {
  local from=$2 to=${3:-}
  if [ -n "$to" ] && [ "$to" -gt "$from" ]; then
    REPLY=$(tail -c +$((from + 1)) "$1" 2>/dev/null | head -c $((to - from)) | grep '"type":"assistant"' | grep -o '"id":"msg_[A-Za-z0-9]*"' | sort -u | wc -l | tr -d ' ')
  else
    REPLY=$(tail -c +$((from + 1)) "$1" 2>/dev/null | grep '"type":"assistant"' | grep -o '"id":"msg_[A-Za-z0-9]*"' | sort -u | wc -l | tr -d ' ')
  fi
  case $REPLY in ''|*[!0-9]*) REPLY=0 ;; esac
}

# The compaction log: one TAB-separated line per compaction in $STATE/compactions.tsv:
#   1 epoch  2 iso  3 kind  4 id  5 label  6 model  7 effort  8 pre  9 post  10 durationMs
#   11 trigger  12 cost_usd  13 transcript  14 boundary_offset  15 turns_after ("-" = open)
#   16 agent_started_epoch
COMPACTIONS=""
set_compactions_path() { COMPACTIONS="$STATE/compactions.tsv"; }

# freeze_previous PATH NEW_OFFSET: the previous compaction of this transcript is now closed;
# count the API requests made between the two boundaries.
freeze_previous() {
  local tmp="$COMPACTIONS.new" n
  [ -f "$COMPACTIONS" ] || return 0
  n=$(awk -F'\t' -v p="$1" '$13 == p && $15 == "-" { print NR ":" $14 }' "$COMPACTIONS" | tail -n 1)
  [ -n "$n" ] || return 0
  turns_in "$1" "${n#*:}" "$2"
  awk -F'\t' -v OFS='\t' -v line="${n%%:*}" -v t="$REPLY" 'NR == line { $15 = t } { print }' "$COMPACTIONS" > "$tmp" && mv -f "$tmp" "$COMPACTIONS"
}

# record_compaction PATH SID OFFSET RECORD: log one compact_boundary record (journal + tsv).
record_compaction() {
  local path=$1 sid=$2 boff=$3 ts="" trig="" pre=0 post=0 dur=0 epoch kind id label model effort started="" cost text prek postk durs
  eval "$(printf '%s' "$4" | jq -r '
    def s: if . == null then "" else tostring end;
    @sh "ts=\(.timestamp | s)",
    @sh "trig=\(.compactMetadata.trigger | s)",
    @sh "pre=\(.compactMetadata.preTokens | s)",
    @sh "post=\(.compactMetadata.postTokens | s)",
    @sh "dur=\(.compactMetadata.durationMs | s)"' 2>/dev/null)" || return 0
  case $pre in ''|*[!0-9]*) pre=0 ;; esac
  case $post in ''|*[!0-9]*) post=0 ;; esac
  case $dur in ''|*[!0-9]*) dur=0 ;; esac
  [ -n "$trig" ] || trig=auto
  now_parts
  iso_to_epoch "$ts"; epoch=${REPLY:-$NOW_EPOCH}
  transcript_kind "$path"; kind=$T_KIND
  if [ "$kind" = sub ]; then
    id=$T_ID
    describe_agent "$id" "$(dirname "$path")"
    label=$D_LABEL; model=$D_MODEL; effort=$D_EFFORT; started=$D_STARTED
  else
    id=lead
    lead_model "$sid"
    label=$LM_LABEL; model=$LM_MODEL; effort=$LM_EFFORT
  fi
  compact_cost "$pre" "$post" "$model"; cost=$REPLY
  freeze_previous "$path" "$boff"
  oneline "$label"; label=$REPLY
  printf '%s\n' "$epoch$TAB$ts$TAB$kind$TAB$id$TAB$label$TAB$model$TAB$effort$TAB$pre$TAB$post$TAB$dur$TAB$trig$TAB$cost$TAB$path$TAB$boff$TAB-$TAB$started" >> "$COMPACTIONS"
  fmt_k "$pre"; prek=$REPLY
  fmt_k "$post"; postk=$REPLY
  text="Context compacted · $label · $prek → $postk"
  if [ "$dur" -gt 0 ]; then fmt_secs $(((dur + 500) / 1000)); text="$text · $REPLY"; fi
  text="$text · $trig"
  fmt_usd "$cost"; [ -z "$REPLY" ] || text="$text · $REPLY"
  JOURNAL_AT=$epoch journal_append "system" "$text"
}

# settle_transcript PATH SID: log the compact_boundary records appended since the last scan.
# Only the new bytes are read; a partial last line is left for the next scan.
settle_transcript() {
  local path=$1 sid=$2 key off size out line start last_start end
  safe_name "$path"; key=$REPLY
  off=$(cat "$STATE/compact/scan/$key" 2>/dev/null)
  case $off in ''|*[!0-9]*) off=0 ;; esac
  size=$(file_size "$path") || return 0
  if [ "$size" -lt "$off" ]; then off=0; fi
  [ "$size" -gt "$off" ] || return 0
  out=$(tail -c +$((off + 1)) "$path" 2>/dev/null | LC_ALL=C awk -v base="$off" '
    { start = base + pos; pos += length($0) + 1; last = start
      if (index($0, "\"compact_boundary\"") && index($0, "\"type\":\"system\"")) print start "\t" $0 }
    END { print "END\t" last "\t" base + pos }')
  last_start=""; end=""
  while IFS=$TAB read -r start line; do
    case $start in
      END) last_start=${line%%$TAB*}; end=${line#*$TAB} ;;
      *[!0-9]*|'') ;;
      *) record_compaction "$path" "$sid" "$start" "$line" ;;
    esac
  done <<EOF
$out
EOF
  [ -n "$end" ] || return 0
  # A file not ending in a newline has a partial last line: rescan it next time.
  if [ "$(tail -c 1 "$path" 2>/dev/null | wc -l | tr -d ' ')" = 1 ]; then off=$end; else off=$last_start; fi
  printf '%s\n' "$off" > "$STATE/compact/scan/$key" 2>/dev/null
}

# freeze_open_rows: close the "turns after" count of compactions whose agent has stopped, or
# whose session is no longer registered, so renders only count turns for live transcripts.
freeze_open_rows() {
  local rows nr path boff kind id tmp="$COMPACTIONS.new"
  [ -s "$COMPACTIONS" ] || return 0
  rows=$(awk -F'\t' '$15 == "-" { print NR "\t" $13 "\t" $14 "\t" $3 "\t" $4 }' "$COMPACTIONS")
  [ -n "$rows" ] || return 0
  while IFS=$TAB read -r nr path boff kind id; do
    [ -n "$nr" ] || continue
    if [ "$kind" = sub ]; then
      [ -e "$STATE/running/$id" ] && continue
    else
      # The lead's row stays open while its transcript is alive (modified within the hour).
      [ -f "$path" ] && [ -z "$(find "$path" -mmin +60 2>/dev/null)" ] && continue
    fi
    if [ -f "$path" ]; then turns_in "$path" "$boff"; else REPLY=0; fi
    awk -F'\t' -v OFS='\t' -v line="$nr" -v t="$REPLY" 'NR == line { $15 = t } { print }' "$COMPACTIONS" > "$tmp" && mv -f "$tmp" "$COMPACTIONS"
  done <<EOF
$rows
EOF
}

# settle_compactions: scan the transcripts of every known session (main, then the subagent
# transcripts modified since the last scan) and log new compactions. Runs on every crew
# event and command, under the lock.
settle_compactions() {
  local f sid main dir sub mark="$STATE/compact/last-scan" newmark="$STATE/compact/last-scan.new"
  command -v jq >/dev/null 2>&1 || return 0
  set_compactions_path
  lock_take
  freeze_open_rows
  for f in "$STATE/transcripts"/*; do
    [ -f "$f" ] || continue
    sid=${f##*/}
    session_registered "$sid" || continue
    main=$(cat "$f" 2>/dev/null)
    [ -n "$main" ] && [ -f "$main" ] || continue
    settle_transcript "$main" "$sid"
    dir="${main%.jsonl}/subagents"
    [ -d "$dir" ] || continue
    : > "$newmark"
    if [ -f "$mark" ]; then
      while IFS= read -r sub; do
        [ -n "$sub" ] || continue
        settle_transcript "$sub" "$sid"
      done <<EOF
$(find "$dir" -maxdepth 1 -name 'agent-*.jsonl' -newer "$mark" 2>/dev/null)
EOF
    else
      for sub in "$dir"/agent-*.jsonl; do
        [ -f "$sub" ] || continue
        settle_transcript "$sub" "$sid"
      done
    fi
    mv -f "$newmark" "$mark" 2>/dev/null
  done
}

# check_index_additions PATH: when the lead adds task rows to an index that already had rows,
# flag any new row whose spec has no "Requests:" line (scope added without a queue entry).
# Sets REPLY to the note for the lead ("" when nothing to flag).
check_index_additions() {
  local path=$1 rel key stored now id spec dir flagged="" line
  REPLY=""
  rel=${path#"$ROOT"/.crew/}
  safe_name "$rel"; key=$REPLY
  now=$(parse_index rows "$path" 2>/dev/null | cut -d"$US" -f1,6)
  stored=$(cat "$STATE/index-rows/$key" 2>/dev/null)
  if [ -n "$stored" ] && [ -z "$J_AGENT_TYPE" ]; then
    dir=$(dirname "$path")
    while IFS=$US read -r id spec; do
      [ -n "$id" ] || continue
      printf '%s\n' "$stored" | grep -q -x -F "$id" && continue
      spec=${spec//\`/}
      if [ -n "$spec" ] && [ -f "$dir/$spec" ] && ! grep -q -i -E '(^[[:space:]]*(-[[:space:]]*)?|· )(\*\*)?Requests:' "$dir/$spec"; then
        flagged="${flagged:+$flagged, }$id"
      fi
    done <<EOF
$now
EOF
  fi
  printf '%s\n' "$now" | cut -d"$US" -f1 > "$STATE/index-rows/$key" 2>/dev/null
  [ -n "$flagged" ] || return 0
  line="$flagged added to $rel without a Requests: line in the spec. If it comes from a founder request, queue it first (.crew/bin/crew request) and add \"Requests: R<n>\" to the spec; if it is planned work, add \"Requests: none\"."
  journal_append "system" "$line"
  REPLY=$line
}

# ---------------------------------------------------------------------------
# Dashboard rendering (D-J2 to D-J5)
# ---------------------------------------------------------------------------

# status_look KEY: sets GLYPH and WORD for a canonical status key.
status_look() {
  case $1 in
    accepted) GLYPH='☑'; WORD='accepted' ;;
    progress) GLYPH='◔'; WORD='in progress' ;;
    review) GLYPH='◑'; WORD='in review' ;;
    rework) GLYPH='↻'; WORD='rework' ;;
    blocked) GLYPH='⊘'; WORD='blocked' ;;
    *) GLYPH='☐'; WORD='pending' ;;
  esac
}

# Mermaid-safe label text: no double quotes, no newlines, no angle brackets, 40 chars.
mm_text() {
  oneline "$1"
  REPLY=${REPLY//\"/\'}
  REPLY=${REPLY//</‹}
  REPLY=${REPLY//>/›}
  trunc "$REPLY" 40
}

# Markdown table cell: one line, pipes escaped, "—" when empty.
md_cell() {
  oneline "$1"
  REPLY=${REPLY//|/\\|}
  [ -n "$REPLY" ] || REPLY='—'
}

# Mermaid node id from a task or request id.
mm_id() { REPLY=$(printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9_' '_'); }

# Parse an index file. mode=summary prints one record:
#   title US total US accepted US closed US stage US branch
# mode=rows prints one record per task:
#   id US status-key US title US flags US deps (space-separated ids) US spec
# Column order fixed by the scaffold template: #, Status, Task, Flags, Depends on, Spec.
parse_index() {
  awk -v mode="$1" '
    function trim(s) { gsub(/^[ \t]+|[ \t\r]+$/, "", s); return s }
    function key(s,  l) {
      l = tolower(s)
      if (l ~ /accept/) return "accepted"
      if (l ~ /review/) return "review"
      if (l ~ /rework/) return "rework"
      if (l ~ /block/) return "blocked"
      if (l ~ /progress/) return "progress"
      return "pending"
    }
    function field(s, label) {
      sub("^.*" label ":[ \t]*", "", s); gsub(/\*\*/, "", s); gsub(/`/, "", s)
      return trim(s)
    }
    BEGIN { FS = "|"; OFS = "\037" }
    title == "" && /^# / {
      title = substr($0, 3); sub(/[ \t]+(—|-)[ \t]+tasks[ \t]*$/, "", title); title = trim(title)
    }
    /^[ \t]*(-[ \t]+)?(\*\*)?Closed:/ { closed = field($0, "Closed"); if (closed == "") closed = "yes" }
    /^[ \t]*(-[ \t]+)?(\*\*)?Stage:/ { stage = field($0, "Stage"); if (stage ~ /^</) stage = "" }
    /^[ \t]*(-[ \t]+)?(\*\*)?Branch:/ { branch = field($0, "Branch") }
    /^[ \t]*\|/ {
      if (NF < 8) next
      id = trim($2)
      if (id !~ /^[A-Za-z]*[0-9]+$/) next
      n++; ids[n] = id; st[n] = key(trim($3)); ti[n] = trim($4); fl[n] = trim($5)
      dp[n] = trim($6); sp[n] = trim($7)
      num[n] = id; gsub(/[^0-9]/, "", num[n]); num[n] += 0
    }
    END {
      if (mode == "summary") {
        acc = 0
        for (i = 1; i <= n; i++) if (st[i] == "accepted") acc++
        print title, n + 0, acc, closed, stage, branch
        exit
      }
      for (i = 1; i <= n; i++) {
        deps = ""; d = dp[i]
        # Dependencies may be written T01, 01 or 1: match them by number.
        while (match(d, /[0-9]+/)) {
          k = substr(d, RSTART, RLENGTH) + 0; d = substr(d, RSTART + RLENGTH)
          for (j = 1; j <= n; j++) if (num[j] == k && j != i) { deps = deps (deps == "" ? "" : " ") ids[j]; break }
        }
        f = fl[i]; if (f == "—" || f == "-" || tolower(f) == "none") f = ""
        gsub(/\t/, " ", ti[i])
        print ids[i], st[i], ti[i], f, deps, sp[i]
      }
    }' "$2"
}

# Parse queue entries of one kind (R or F). Prints per entry:
#   R: id US date US request US affects US slot US status
#   F: id US date US question US default US status
parse_queue() {
  awk -v kind="$1" '
    function trim(s) { gsub(/^[ \t]+|[ \t\r]+$/, "", s); return s }
    BEGIN { OFS = "\037" }
    $0 ~ ("^[ \t]*- \\[" kind "[0-9]+\\]") {
      line = $0; sub(/^[ \t]*- \[/, "", line)
      id = substr(line, 1, index(line, "]") - 1); line = substr(line, index(line, "]") + 1)
      n = split(line, p, " · ")
      date = trim(p[1]); text = ""; aff = ""; slot = ""; status = ""; def = ""
      for (i = 2; i <= n; i++) {
        v = trim(p[i])
        if (v ~ /^affects:/) { sub(/^affects:[ \t]*/, "", v); aff = v }
        else if (v ~ /^slot:/) { sub(/^slot:[ \t]*/, "", v); slot = v }
        else if (v ~ /^status:/) { sub(/^status:[ \t]*/, "", v); status = tolower(v) }
        else if (v ~ /^default taken:/) { sub(/^default taken:[ \t]*/, "", v); def = v }
        else text = text (text == "" ? "" : " · ") v
      }
      if (kind == "R") print id, date, text, aff, slot, status
      else print id, date, text, def, status
    }' "$2"
}

# List worktrees: "path US branch" per line, main checkout first.
list_worktrees() {
  git -C "$ROOT" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { if (p != "") print p "\037" b; p = substr($0, 10); b = ""; next }
    /^branch / { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    END { if (p != "") print p "\037" b }'
}

# Percent-encode the characters that break a Markdown link destination.
md_url() {
  REPLY=${1// /%20}
  REPLY=${REPLY//(/%28}
  REPLY=${REPLY//)/%29}
}

# compaction_counts -> REPLY "lead 1 · subagents 8" ("" when none).
compaction_counts() {
  local l=0 s=0
  REPLY=""
  set_compactions_path
  [ -s "$COMPACTIONS" ] || return 0
  l=$(awk -F'\t' '$3 == "lead"' "$COMPACTIONS" | wc -l | tr -d ' ')
  s=$(awk -F'\t' '$3 == "sub"' "$COMPACTIONS" | wc -l | tr -d ' ')
  [ "$((l + s))" -gt 0 ] || return 0
  REPLY="lead $l · subagents $s"
}

# render_compactions: the "## Compactions" section: a summary line, the last 12 compactions
# with the estimated overhead and savings of each, and the model behind the numbers.
# Overhead ≈ pre × cache-read price + post × output price (the summarization request).
# Savings so far ≈ turns since × (pre − post) × cache-read price: what the API requests made
# after the compaction would have paid to carry the dropped context.
render_compactions() {
  local n epoch iso kind id label model effort pre post dur trig cost path boff turns started
  local aug="" when read_price day
  set_compactions_path
  [ -s "$COMPACTIONS" ] || return 0
  now_parts
  n=0
  while IFS=$TAB read -r epoch iso kind id label model effort pre post dur trig cost path boff turns started; do
    [ -n "$epoch" ] || continue
    n=$((n + 1))
    if [ "$turns" = "-" ]; then
      if [ -f "$path" ]; then turns_in "$path" "$boff"; turns=$REPLY; else turns=0; fi
    fi
    price_for "$model" "$pre"; read_price=${P_READ:-0}
    epoch_to_hm "$epoch"; when=$REPLY
    epoch_to_day "$epoch"; day=$REPLY
    [ "$day" = "$NOW_DAY" ] || when="$day $when"
    aug="$aug$epoch$TAB$kind$TAB$label$TAB$pre$TAB$post$TAB$dur$TAB$trig$TAB${cost:-}$TAB$turns$TAB$read_price$TAB${started:-0}$TAB$when$NL"
  done < "$COMPACTIONS"
  [ "$n" -gt 0 ] || return 0
  printf '## Compactions\n\n'
  printf '%s' "$aug" | awk -F'\t' -v rows=12 '
    function span(s,  h, m) {
      s = int(s + 0.5)
      if (s < 100) return s " s"
      if (s < 3600) return int(s / 60) " min"
      h = int(s / 3600); m = int((s % 3600) / 60)
      return h " h " m " min"
    }
    function k(n) { return (n >= 1000) ? int(n / 1000 + 0.5) "k" : n }
    function usd(c) { if (c == "") return "—"; c += 0; if (c < -0.005) return sprintf("≈−$%.2f", -c); return (c < 0.005) ? "<$0.01" : sprintf("≈$%.2f", c) }
    function cell(t) { gsub(/\|/, "\\|", t); return t }
    {
      n++
      epoch[n] = $1; kind[n] = $2; label[n] = $3; pre[n] = $4 + 0; post[n] = $5 + 0; dur[n] = $6 + 0
      trig[n] = $7; cost[n] = $8; turns[n] = $9 + 0; rp[n] = $10 + 0; started[n] = $11 + 0; when[n] = $12
      saved[n] = turns[n] * (pre[n] - post[n]) * rp[n] / 1000000
      cnt[kind[n]]++; presum[kind[n]] += pre[n]
      if (cost[n] != "") { over += cost[n]; overknown = 1 }
      if (rp[n] > 0) { savesum += saved[n]; saveknown = 1 }
      if (kind[n] == "lead") { if (lastlead > 0) { gapsum += epoch[n] - lastlead; gaps++ } lastlead = epoch[n] }
      else if (started[n] > 0 && epoch[n] >= started[n]) { subgap += epoch[n] - started[n]; subgaps++ }
    }
    END {
      line = ""
      if (cnt["lead"] > 0) {
        line = "lead: " cnt["lead"] " (at ~" k(presum["lead"] / cnt["lead"]) " tokens"
        if (gaps > 0) line = line ", every ~" span(gapsum / gaps)
        line = line ")"
      }
      if (cnt["sub"] > 0) {
        line = line (line == "" ? "" : " · ") "subagents: " cnt["sub"] " (at ~" k(presum["sub"] / cnt["sub"]) " tokens"
        if (subgaps > 0) line = line ", ~" span(subgap / subgaps) " after start"
        line = line ")"
      }
      if (overknown) line = line " · est. overhead " usd(over)
      if (saveknown) line = line " · est. saved so far " usd(savesum) " · net " usd(savesum - over)
      print line "\n"
      print "| When | Agent | Before → after | Took | Trigger | Turns since | Est. overhead | Est. saved | Net |"
      print "|---|---|---|---|---|---|---|---|---|"
      s = n - rows + 1; if (s < 1) s = 1
      for (i = s; i <= n; i++) {
        netc = (cost[i] == "" || rp[i] <= 0) ? "" : saved[i] - cost[i]
        sv = (rp[i] > 0) ? usd(saved[i]) : "—"
        printf "| %s | %s | %s → %s | %s | %s | %s | %s | %s | %s |\n", when[i], cell(label[i]), k(pre[i]), k(post[i]),
          (dur[i] > 0 ? span(dur[i] / 1000) : "—"), trig[i], turns[i], usd(cost[i]), sv, (netc == "" ? "—" : usd(netc))
      }
      print ""
      print "*Estimates at Anthropic list prices (2026-10-20), warm cache. Overhead: the summarization request; saved: what later requests would have paid to carry the dropped context. Not measured: re-reads after a compaction and lost detail. Tune windows with `/autocompact <size>`, `modelSettings`, or `autoCompactWindow` in an agent definition (see `.crew/README.md`).*\n"
    }'
}

# Write the dashboard to stdout. Run in a subshell by render_locked.
render_body() {
  local repo branch sha lead_state lead_hm lead_line nrun f id
  local -a RUN_TYPE RUN_DESC RUN_ME RUN_NAME RUN_SINCE
  now_parts
  repo=$(basename "$ROOT")
  branch=$(git -C "$ROOT" symbolic-ref --short -q HEAD 2>/dev/null) || branch=""
  sha=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null) || sha=""
  [ -n "$branch" ] || branch="detached"
  [ -n "$sha" ] || { branch="no git history"; sha="—"; }

  # Running agents.
  nrun=0
  for f in "$STATE/running"/*; do
    [ -e "$f" ] || continue
    id=${f##*/}
    load_agent "$id" || A_TYPE="unknown"
    RUN_TYPE[nrun]=$A_TYPE; RUN_DESC[nrun]=$A_DESC
    RUN_ME[nrun]="${A_MODEL:-default} · ${A_EFFORT:-default}"
    RUN_NAME[nrun]=$A_NAME; RUN_SINCE[nrun]=$A_SINCE
    nrun=$((nrun + 1))
  done

  # Lead state.
  lead_state=""; lead_hm=""
  if [ -f "$STATE/lead" ]; then
    read -r lead_state lead_hm < "$STATE/lead"
  fi
  if [ "$lead_state" = stopped ]; then
    lead_line="⏹ stopped by you since $lead_hm"
    [ "$nrun" -eq 0 ] || lead_line="$lead_line · $nrun agent(s) still finishing"
  elif [ "$lead_state" = working ]; then
    lead_line="▶ working since $lead_hm"
  elif [ "$nrun" -gt 0 ]; then
    lead_line="▶ agents working, lead idle"
  elif [ -n "$lead_hm" ]; then
    lead_line="⏸ waiting for you since $lead_hm"
  else
    lead_line="⏸ waiting for you"
  fi

  printf '# Crew status — %s\n\n' "$repo"
  printf '*Updated %s %s · %s @ %s · %s*\n\n' "$NOW_DAY" "$NOW_HM" "$branch" "$sha" "$lead_line"

  # Collect indexes: main checkout first, then linked worktrees. A worktree index whose
  # path also exists in the main checkout is a committed copy of it and is skipped.
  local -a IDX_FILE IDX_WHERE IDX_REL IDX_TITLE IDX_TOTAL IDX_ACC IDX_CLOSED IDX_STAGE IDX_BRANCH
  local nidx=0 wt wtb rel rec t_title t_total t_acc t_closed t_stage t_branch
  add_index() {  # file where rel
    rec=$(parse_index summary "$1" 2>/dev/null)
    IFS=$US read -r t_title t_total t_acc t_closed t_stage t_branch <<< "$rec"
    IDX_FILE[nidx]=$1; IDX_WHERE[nidx]=$2; IDX_REL[nidx]=$3
    IDX_TITLE[nidx]=${t_title:-${3%/index.md}}; IDX_TOTAL[nidx]=${t_total:-0}; IDX_ACC[nidx]=${t_acc:-0}
    IDX_CLOSED[nidx]=$t_closed; IDX_STAGE[nidx]=$t_stage; IDX_BRANCH[nidx]=$t_branch
    nidx=$((nidx + 1))
  }
  for f in "$CREW_DIR"/tasks/*/index.md; do
    [ -f "$f" ] || continue
    add_index "$f" "" "${f#"$CREW_DIR"/}"
  done
  while IFS=$US read -r wt wtb; do
    [ -n "$wt" ] || continue
    wt=$(cd "$wt" 2>/dev/null && pwd -P) || continue
    [ "$wt" != "$ROOT" ] || continue
    [ -d "$wt/.crew/tasks" ] || continue
    for f in "$wt"/.crew/tasks/*/index.md; do
      [ -f "$f" ] || continue
      rel=${f#"$wt"/.crew/}
      [ -f "$CREW_DIR/$rel" ] && continue
      add_index "$f" "${wtb:-$(basename "$wt")}" "$rel"
    done
  done <<EOF
$(list_worktrees)
EOF

  # Pick the current set: a live main-checkout index on the current branch, else the
  # newest live main-checkout index, else the newest live worktree index.
  local cur=-1 i newest_main="" newest_wt=""
  local -a live_main live_wt
  for ((i = 0; i < nidx; i++)); do
    [ -z "${IDX_CLOSED[i]}" ] || continue
    if [ -z "${IDX_WHERE[i]}" ]; then
      live_main[${#live_main[@]}]=${IDX_FILE[i]}
      if [ "$cur" -lt 0 ] && [ -n "${IDX_BRANCH[i]}" ] && [ "${IDX_BRANCH[i]}" = "$branch" ]; then cur=$i; fi
    else
      live_wt[${#live_wt[@]}]=${IDX_FILE[i]}
    fi
  done
  if [ "$cur" -lt 0 ]; then
    # ls -t is the portable way to sort by mtime; these paths come from our own glob.
    # shellcheck disable=SC2012
    if [ ${#live_main[@]} -gt 0 ]; then
      newest_main=$(ls -t "${live_main[@]}" 2>/dev/null | head -n 1)
    elif [ ${#live_wt[@]} -gt 0 ]; then
      newest_wt=$(ls -t "${live_wt[@]}" 2>/dev/null | head -n 1)
    fi
    for ((i = 0; i < nidx; i++)); do
      if [ -n "$newest_main$newest_wt" ] && [ "${IDX_FILE[i]}" = "$newest_main$newest_wt" ]; then cur=$i; break; fi
    done
  fi

  # Queue.
  local queue="$CREW_DIR/queue.md" qopen=0 rqueued=0 s
  local -a REQ_ID REQ_TEXT REQ_AFF REQ_SLOT REQ_STATUS Q_ID Q_TEXT Q_DEF Q_STATUS
  local nreq=0 nq=0 r_id r_text r_aff r_slot r_status q_def
  if [ -f "$queue" ]; then
    while IFS=$US read -r r_id _ r_text r_aff r_slot r_status; do
      [ -n "$r_id" ] || continue
      REQ_ID[nreq]=$r_id; REQ_TEXT[nreq]=$r_text; REQ_AFF[nreq]=$r_aff
      REQ_SLOT[nreq]=$r_slot; REQ_STATUS[nreq]=$r_status
      case $r_status in queued*) rqueued=$((rqueued + 1)) ;; esac
      nreq=$((nreq + 1))
    done <<EOF
$(parse_queue R "$queue" 2>/dev/null)
EOF
    while IFS=$US read -r r_id _ r_text q_def r_status; do
      [ -n "$r_id" ] || continue
      Q_ID[nq]=$r_id; Q_TEXT[nq]=$r_text; Q_DEF[nq]=$q_def; Q_STATUS[nq]=$r_status
      case $r_status in open*) qopen=$((qopen + 1)) ;; esac
      nq=$((nq + 1))
    done <<EOF
$(parse_queue F "$queue" 2>/dev/null)
EOF
  fi

  # ---- Now and Tasks ----
  local -a T_ID T_KEY T_TITLE T_FLAGS T_DEPS T_AGENT
  local nt=0 t_id t_key t_ti t_fl t_dp cur_task=-1 j re='^[Tt]0*([0-9]+)([^0-9]|$)' tnum
  if [ "$cur" -ge 0 ]; then
    while IFS=$US read -r t_id t_key t_ti t_fl t_dp _; do
      [ -n "$t_id" ] || continue
      T_ID[nt]=$t_id; T_KEY[nt]=$t_key; T_TITLE[nt]=$t_ti; T_FLAGS[nt]=$t_fl; T_DEPS[nt]=$t_dp
      # The agent on a task: a running agent whose description starts with the task id.
      T_AGENT[nt]=""
      tnum=$(printf '%s' "$t_id" | tr -cd '0-9' | sed 's/^0*//')
      for ((j = 0; j < nrun; j++)); do
        if [[ ${RUN_DESC[j]} =~ $re ]] && [ "${BASH_REMATCH[1]}" = "$tnum" ]; then
          s="${RUN_TYPE[j]} (${RUN_ME[j]})"
          [ -z "${RUN_NAME[j]}" ] || s="$s [${RUN_NAME[j]}]"
          T_AGENT[nt]="${T_AGENT[nt]:+${T_AGENT[nt]}, }$s"
        fi
      done
      nt=$((nt + 1))
    done <<EOF
$(parse_index rows "${IDX_FILE[cur]}" 2>/dev/null)
EOF
    # Current task: the first one in progress, in review or in rework; else the first pending.
    for ((i = 0; i < nt; i++)); do
      case ${T_KEY[i]} in progress|review|rework) cur_task=$i; break ;; esac
    done
    if [ "$cur_task" -lt 0 ]; then
      for ((i = 0; i < nt; i++)); do
        if [ "${T_KEY[i]}" = pending ]; then cur_task=$i; break; fi
      done
    fi
  fi

  printf '## Now\n\n'
  if [ "$cur" -lt 0 ]; then
    printf 'No task set in progress.\n\n'
  else
    local where_note="" bar="" filled acc=${IDX_ACC[cur]} total=${IDX_TOTAL[cur]}
    [ -z "${IDX_WHERE[cur]}" ] || where_note=" (worktree \`${IDX_WHERE[cur]}\`)"
    # The backticks are Markdown code spans, not command substitution.
    # shellcheck disable=SC2016
    printf '**%s** · `%s`%s\n\n' "${IDX_TITLE[cur]}" "${IDX_REL[cur]}" "$where_note"
    filled=0
    [ "$total" -gt 0 ] && filled=$(((acc * 12 + total / 2) / total))
    for ((i = 0; i < 12; i++)); do
      if [ "$i" -lt "$filled" ]; then bar="${bar}█"; else bar="${bar}░"; fi
    done
    printf '%s %s/%s accepted\n\n' "$bar" "$acc" "$total"
    if [ "$cur_task" -ge 0 ]; then
      status_look "${T_KEY[cur_task]}"
      printf -- '- **Current task:** %s %s %s — %s — %s\n' "$GLYPH" "${T_ID[cur_task]}" \
        "${T_TITLE[cur_task]}" "$WORD" "${T_AGENT[cur_task]:-no agent on it}"
    else
      printf -- '- **Current task:** none open\n'
    fi
  fi
  printf -- '- **Open founder questions:** %s · **Queued requests:** %s\n' "$qopen" "$rqueued"
  compaction_counts
  [ -z "$REPLY" ] || printf -- '- **Compactions:** %s\n' "$REPLY"
  printf '\n'

  if [ "$cur" -ge 0 ]; then
    printf '## Tasks\n\n'
    if [ "$nt" -eq 0 ]; then
      printf 'The index has no task rows yet.\n\n'
    elif [ "$nt" -gt 60 ]; then
      printf '*Diagram omitted: more than 60 tasks.*\n\n'
    else
      local dep nid did label
      printf '```mermaid\nflowchart LR\n'
      for ((i = 0; i < nt; i++)); do
        status_look "${T_KEY[i]}"
        mm_text "${T_TITLE[i]}"; label=$REPLY
        mm_id "${T_ID[i]}"; nid=$REPLY
        printf '  %s["%s %s %s"]:::%s\n' "$nid" "$GLYPH" "$nid" "$label" "${T_KEY[i]}"
      done
      for ((i = 0; i < nt; i++)); do
        mm_id "${T_ID[i]}"; nid=$REPLY
        for dep in ${T_DEPS[i]}; do
          mm_id "$dep"; did=$REPLY
          printf '  %s --> %s\n' "$did" "$nid"
        done
      done
      printf '  classDef accepted fill:#dcfce7,stroke:#16a34a,color:#14532d\n'
      printf '  classDef progress fill:#fef3c7,stroke:#d97706,color:#78350f\n'
      printf '  classDef review fill:#dbeafe,stroke:#2563eb,color:#1e3a8a\n'
      printf '  classDef rework fill:#fee2e2,stroke:#dc2626,color:#7f1d1d\n'
      printf '  classDef blocked fill:#f3f4f6,stroke:#6b7280,color:#374151,stroke-dasharray:5 5\n'
      printf '  classDef pending fill:#ffffff,stroke:#9ca3af,color:#111827\n'
      printf '```\n\n'
    fi
    if [ "$nt" -gt 0 ]; then
      local c_ti c_fl c_dp c_ag
      printf '| # | Status | Task | Flags | Depends on | Agent now |\n'
      printf '|---|---|---|---|---|---|\n'
      for ((i = 0; i < nt; i++)); do
        status_look "${T_KEY[i]}"
        md_cell "${T_TITLE[i]}"; c_ti=$REPLY
        md_cell "${T_FLAGS[i]}"; c_fl=$REPLY
        md_cell "${T_DEPS[i]// /, }"; c_dp=$REPLY
        md_cell "${T_AGENT[i]}"; c_ag=$REPLY
        printf '| %s | %s %s | %s | %s | %s | %s |\n' "${T_ID[i]}" "$GLYPH" "$WORD" "$c_ti" "$c_fl" "$c_dp" "$c_ag"
      done
      printf '\n'
    fi

    # Newest 3 screenshots of the current task, linked relative to .crew/.
    if [ "$cur_task" -ge 0 ]; then
      local -a shots
      local d img n=0
      for d in "$CREW_DIR/task-data/${T_ID[cur_task]}"-*/screenshots "$CREW_DIR/task-data/${T_ID[cur_task]}"/screenshots; do
        [ -d "$d" ] || continue
        for img in "$d"/*; do
          case $(printf '%s' "$img" | tr '[:upper:]' '[:lower:]') in
            *.png|*.jpg|*.jpeg|*.gif|*.webp|*.svg) shots[${#shots[@]}]=$img ;;
          esac
        done
      done
      if [ ${#shots[@]} -gt 0 ]; then
        printf '**Newest screenshots of %s:**\n\n' "${T_ID[cur_task]}"
        while IFS= read -r img; do
          [ -n "$img" ] || continue
          n=$((n + 1)); [ "$n" -le 3 ] || break
          md_url "${img#"$CREW_DIR"/}"
          printf -- '- ![%s](%s)\n' "${img##*/}" "$REPLY"
        done <<EOF
$(ls -t "${shots[@]}" 2>/dev/null)
EOF
        printf '\n'
      fi
    fi
  fi

  # ---- Requests and questions ----
  printf '## Requests and questions\n\n'
  local nnodes=0 group gname
  for ((i = 0; i < nreq; i++)); do
    case ${REQ_STATUS[i]} in queued*|scheduled*|done*) nnodes=$((nnodes + 1)) ;; esac
  done
  if [ "$nnodes" -gt 0 ] && [ "$nnodes" -le 60 ]; then
    local rt rs empty
    printf '```mermaid\nflowchart LR\n'
    for group in queued scheduled 'done'; do
      case $group in queued) gname=Queued ;; scheduled) gname=Scheduled ;; *) gname=Done ;; esac
      printf '  subgraph %s\n' "$gname"
      empty=1
      for ((i = 0; i < nreq; i++)); do
        case ${REQ_STATUS[i]} in "$group"*) ;; *) continue ;; esac
        empty=0
        mm_text "${REQ_TEXT[i]}"; rt=$REPLY
        mm_text "${REQ_SLOT[i]:-no slot}"; rs=$REPLY
        mm_id "${REQ_ID[i]}"
        printf '    %s["%s · %s · %s"]\n' "$REPLY" "${REQ_ID[i]}" "$rt" "$rs"
      done
      [ "$empty" = 0 ] || printf '    %s_none["none"]\n' "$gname"
      printf '  end\n'
    done
    printf '```\n\n'
  elif [ "$nnodes" -gt 60 ]; then
    printf '*Diagram omitted: more than 60 requests.*\n\n'
  fi
  if [ "$nreq" -gt 0 ]; then
    local c1 c2 c3 c4
    printf '| ID | Request | Affects | Slot | Status |\n|---|---|---|---|---|\n'
    for ((i = 0; i < nreq; i++)); do
      md_cell "${REQ_TEXT[i]}"; c1=$REPLY
      md_cell "${REQ_AFF[i]}"; c2=$REPLY
      md_cell "${REQ_SLOT[i]}"; c3=$REPLY
      md_cell "${REQ_STATUS[i]}"; c4=$REPLY
      printf '| %s | %s | %s | %s | %s |\n' "${REQ_ID[i]}" "$c1" "$c2" "$c3" "$c4"
    done
    printf '\n'
  else
    printf 'No requests from the founder.\n\n'
  fi
  if [ "$nq" -gt 0 ]; then
    local c1 c2 c3
    printf '| ID | Question for the founder | Default taken | Status |\n|---|---|---|---|\n'
    for ((i = 0; i < nq; i++)); do
      md_cell "${Q_TEXT[i]}"; c1=$REPLY
      md_cell "${Q_DEF[i]}"; c2=$REPLY
      md_cell "${Q_STATUS[i]}"; c3=$REPLY
      printf '| %s | %s | %s | %s |\n' "${Q_ID[i]}" "$c1" "$c2" "$c3"
    done
    printf '\n'
  else
    printf 'No questions for the founder.\n\n'
  fi

  # ---- Live agents ----
  printf '## Live agents\n\n'
  if [ "$nrun" -eq 0 ]; then
    printf 'No subagent running.\n\n'
  else
    local c1 c2
    printf '| Agent | Model · effort | Name | Doing | Since |\n|---|---|---|---|---|\n'
    for ((i = 0; i < nrun; i++)); do
      md_cell "${RUN_NAME[i]}"; c1=$REPLY
      md_cell "${RUN_DESC[i]}"; c2=$REPLY
      printf '| %s | %s | %s | %s | %s |\n' "${RUN_TYPE[i]}" "${RUN_ME[i]}" "$c1" "$c2" "${RUN_SINCE[i]:-—}"
    done
    printf '\n'
  fi

  # ---- Compactions ----
  render_compactions

  # ---- Recent activity: last 12 journal events, dated when not from today ----
  printf '## Recent activity\n\n'
  if [ -f "$JOURNAL" ] && grep -q '^- ' "$JOURNAL" 2>/dev/null; then
    awk -v today="$NOW_DAY" '
      /^## [0-9][0-9][0-9][0-9]-/ { d = substr($0, 4); next }
      /^- / { n++; l[n % 12] = (d == today || d == "") ? $0 : ("- " d " " substr($0, 3)) }
      END { s = n - 11; if (s < 1) s = 1; for (i = s; i <= n; i++) print l[i % 12] }' "$JOURNAL"
    printf '\n'
  else
    printf 'No activity logged yet.\n\n'
  fi

  # ---- Task sets: live first ----
  printf '## Task sets\n\n'
  if [ "$nidx" -eq 0 ]; then
    printf 'No task sets yet.\n\n'
  else
    local pass loc c1
    printf '| Set | Stage | Tasks | Accepted | Status | Closed |\n|---|---|---|---|---|---|\n'
    for pass in live closed; do
      for ((i = 0; i < nidx; i++)); do
        if [ "$pass" = live ] && [ -n "${IDX_CLOSED[i]}" ]; then continue; fi
        if [ "$pass" = closed ] && [ -z "${IDX_CLOSED[i]}" ]; then continue; fi
        loc="\`${IDX_REL[i]}\`"
        [ -z "${IDX_WHERE[i]}" ] || loc="$loc in worktree \`${IDX_WHERE[i]}\`"
        md_cell "${IDX_TITLE[i]}"; c1=$REPLY
        md_cell "${IDX_STAGE[i]}"
        printf '| %s · %s | %s | %s | %s | %s | %s |\n' "$c1" "$loc" "$REPLY" "${IDX_TOTAL[i]}" \
          "${IDX_ACC[i]}" "$([ "$pass" = live ] && printf 'live' || printf 'closed')" "${IDX_CLOSED[i]:-—}"
      done
    done
    printf '\n'
  fi

  # ---- Handoff ----
  if [ -f "$CREW_DIR/handoff.md" ]; then
    local h_date h_where h_next
    h_date=$(sed -n 's/^# Crew handoff[[:space:]]*—[[:space:]]*//p' "$CREW_DIR/handoff.md" | head -n 1)
    h_where=$(grep -m 1 'Where we are:' "$CREW_DIR/handoff.md" | sed 's/^.*Where we are:[*[:space:]]*//')
    h_next=$(grep -m 1 'Next step:' "$CREW_DIR/handoff.md" | sed 's/^.*Next step:[*[:space:]]*//')
    printf '## Handoff\n\n'
    printf -- '- **Written:** %s\n' "${h_date:-unknown}"
    printf -- '- **Where we are:** %s\n' "${h_where:-—}"
    printf -- '- **Next step:** %s\n' "${h_next:-—}"
  fi
  return 0
}

# Render the dashboard: temp file, then mv into place. Never fails the caller.
# Call with the lock held (or after failing to get it).
render_locked() {
  local tmp="$TMP_DIR/status.md.tmp" err="$TMP_DIR/status.err" reason
  mkdir -p "$TMP_DIR" 2>/dev/null || return 0
  if (render_body) > "$tmp" 2> "$err" && [ -s "$tmp" ]; then
    :
  else
    reason=$(grep -v '^[[:space:]]*$' "$err" 2>/dev/null | tail -n 1)
    printf '# Crew status\n\nDashboard rendering failed: %s\n' "${reason:-unknown error}" > "$tmp" 2>/dev/null
  fi
  mv -f "$tmp" "$STATUS" 2>/dev/null || true
  rm -f "$err" 2>/dev/null
  return 0
}

render_with_lock() {
  ensure_dirs
  lock_take
  render_locked
  lock_release
}

# ---------------------------------------------------------------------------
# Hook modes
# ---------------------------------------------------------------------------

session_registered() {
  [ -e "$STATE/sessions/any" ] && return 0
  [ -n "$1" ] || return 1
  safe_name "$1"
  [ -e "$STATE/sessions/$REPLY" ]
}

# Parse the hook input with one jq call; sets the J_* variables.
read_hook_json() {
  local out
  J_SESSION=""; J_CWD=""; J_TOOL=""; J_AGENT_TYPE=""; J_AGENT_ID=""; J_SUBTYPE=""; J_DESC=""
  J_MODEL=""; J_EFFORT=""; J_NAME=""; J_ISO=""; J_TO=""; J_SUMMARY=""; J_MESSAGE=""; J_FILE=""
  J_LAST=""; J_TRANSCRIPT=""; J_SOURCE=""; J_TRIGGER=""; J_HOOK_MODEL=""; J_EFFORT_LVL=""
  out=$(printf '%s' "$INPUT" | jq -r '
    def s: if . == null then "" elif type == "string" then . else tostring end;
    ((.tool_input | objects) // {}) as $t |
    @sh "J_SESSION=\(.session_id | s)",
    @sh "J_CWD=\(.cwd | s)",
    @sh "J_TOOL=\(.tool_name | s)",
    @sh "J_AGENT_TYPE=\(.agent_type | s)",
    @sh "J_AGENT_ID=\(.agent_id | s)",
    @sh "J_TRANSCRIPT=\(.transcript_path | s)",
    @sh "J_SOURCE=\(.source | s)",
    @sh "J_TRIGGER=\(.trigger | s)",
    @sh "J_HOOK_MODEL=\(.model | s)",
    @sh "J_EFFORT_LVL=\((.effort | if type == "object" then .level else . end) | s)",
    @sh "J_SUBTYPE=\($t.subagent_type | s)",
    @sh "J_DESC=\($t.description | s)",
    @sh "J_MODEL=\($t.model | s)",
    @sh "J_EFFORT=\($t.effort | s)",
    @sh "J_NAME=\($t.name | s)",
    @sh "J_ISO=\($t.isolation | s)",
    @sh "J_TO=\($t.to | s)",
    @sh "J_SUMMARY=\($t.summary | s)",
    @sh "J_MESSAGE=\($t.message | s)",
    @sh "J_FILE=\($t.file_path | s)",
    @sh "J_LAST=\(.last_assistant_message | s | split("\n")[0:5] | join("\n"))"
  ' 2>/dev/null) || return 1
  [ -n "$out" ] || return 1
  eval "$out"
}

# Without jq: warn once per day in the journal (only for a registered session).
hook_without_jq() {
  local sid
  sid=$(printf '%s' "$INPUT" | tr '\n' ' ' | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  session_registered "$sid" || return 0
  now_parts
  if [ "$(cat "$STATE/jq-warned" 2>/dev/null)" = "$NOW_DAY" ]; then return 0; fi
  ensure_dirs
  lock_take
  printf '%s\n' "$NOW_DAY" > "$STATE/jq-warned"
  WRITER_CWD=$PWD
  journal_append "system" "jq not found; subagent logging is off. Run /crew setup."
}

hook_agent_start() {
  local type model effort desc head text
  [ "$J_TOOL" = Agent ] || return 0
  type=${J_SUBTYPE:-general-purpose}
  model=$J_MODEL; effort=$J_EFFORT
  [ -n "$model" ] || model=$(agent_frontmatter "$type" model)
  [ -n "$effort" ] || effort=$(agent_frontmatter "$type" effort)
  oneline "${model:-default}"; model=$REPLY
  oneline "${effort:-default}"; effort=$REPLY
  oneline "$J_DESC"; trunc "$REPLY" 120; desc=$REPLY
  oneline "$J_NAME"; local name=$REPLY

  head="→ $type ($model · $effort)"
  [ -z "$J_AGENT_TYPE" ] || head="$J_AGENT_TYPE $head"
  text=$desc
  [ -z "$name" ] || text="$text [$name]"
  [ -z "$J_ISO" ] || text="$text ($J_ISO)"

  ensure_dirs
  lock_take
  now_parts
  safe_name "$type"
  printf '%s\n' "$NOW_EPOCH$TAB$desc$TAB$model$TAB$effort$TAB$name" >> "$STATE/pending/$REPLY"
  journal_append "$head" "$text"
}

hook_agent_resume() {
  local text
  [ "$J_TOOL" = SendMessage ] || return 0
  if [ -n "$J_SUMMARY" ]; then oneline "$J_SUMMARY"; else oneline "$J_MESSAGE"; fi
  trunc "$REPLY" 120; text=$REPLY
  oneline "${J_TO:-?}"
  journal_append "↺ $REPLY" "$text"
}

hook_agent_id() {
  local id pfile rec desc model effort name
  [ -n "$J_AGENT_TYPE" ] && [ -n "$J_AGENT_ID" ] || return 0
  ensure_dirs
  lock_take
  safe_name "$J_AGENT_ID"; id=$REPLY
  if [ -f "$STATE/agents/$id" ]; then
    # A resume: the agent is already known; it is running again.
    : > "$STATE/running/$id"
    render_locked
    return 0
  fi
  now_parts
  safe_name "$J_AGENT_TYPE"; pfile="$STATE/pending/$REPLY"
  rec=""
  if [ -f "$pfile" ]; then
    # Drop stale entries (older than 120 s: spawns that never started), pop the oldest
    # fresh one, keep the rest in order.
    rec=$(awk -F'\t' -v now="$NOW_EPOCH" -v out="$pfile.new" '
      ($1 + 0) < now - 120 { next }
      !done { done = 1; print $1 "\037" $2 "\037" $3 "\037" $4 "\037" $5; next }
      { print > out }' "$pfile")
    if [ -s "$pfile.new" ]; then mv -f "$pfile.new" "$pfile"; else rm -f "$pfile" "$pfile.new"; fi
  fi
  desc=""; model=""; effort=""; name=""
  [ -z "$rec" ] || IFS=$US read -r _ desc model effort name <<< "$rec"
  [ -n "$model" ] || model=$(agent_frontmatter "$J_AGENT_TYPE" model)
  [ -n "$effort" ] || effort=$(agent_frontmatter "$J_AGENT_TYPE" effort)
  oneline "$J_AGENT_TYPE"
  {
    printf 'type=%s\n' "$REPLY"
    printf 'description=%s\n' "$desc"
    printf 'model=%s\n' "${model:-default}"
    printf 'effort=%s\n' "${effort:-default}"
    printf 'name=%s\n' "$name"
    printf 'started=%s\n' "$NOW_EPOCH"
    printf 'since=%s\n' "$NOW_HM"
  } > "$STATE/agents/$id"
  : > "$STATE/running/$id"
  render_locked
}

hook_agent_stop() {
  local status desc="" id
  [ -n "$J_AGENT_TYPE" ] || return 0
  status=$(printf '%s\n' "$J_LAST" | grep -o -w -E 'DONE|PARTIAL|BLOCKED|ACCEPT|CHANGES|RECOMMENDATION' | head -n 1)
  [ -n "$status" ] || status=finished
  ensure_dirs
  lock_take
  if [ -n "$J_AGENT_ID" ]; then
    safe_name "$J_AGENT_ID"; id=$REPLY
    if load_agent "$id"; then desc=$A_DESC; fi
    rm -f "$STATE/running/$id"
  fi
  oneline "$J_AGENT_TYPE"
  journal_append "← $REPLY" "$status${desc:+ · $desc}"
}

hook_file_changed() {
  local path dir base pdir note=""
  path=$J_FILE
  [ -n "$path" ] || return 0
  case $path in /*) ;; *) path="$WRITER_CWD/$path" ;; esac
  base=${path##*/}
  case $base in index.md|queue.md|handoff.md) ;; *) return 0 ;; esac
  dir=$(dirname "$path")
  pdir=$(cd "$dir" 2>/dev/null && pwd -P) || return 0
  case "$pdir/" in "$ROOT/.crew/"*) ;; *) return 0 ;; esac
  ensure_dirs
  lock_take
  if [ "$base" = index.md ]; then
    check_index_additions "$pdir/$base"
    note=$REPLY
  fi
  render_locked
  # PostToolUse: the note reaches the lead as additional context.
  [ -z "$note" ] || jq -nc --arg c "Crew: $note" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $c}}'
}

hook_lead() {  # $1 = working | idle
  [ -z "$J_AGENT_TYPE" ] || return 0
  ensure_dirs
  lock_take
  now_parts
  # "stopped" (crew session stop) sticks until `crew session start` runs again (/crew resume).
  case $(cat "$STATE/lead" 2>/dev/null) in
    stopped*) ;;
    *) printf '%s %s\n' "$1" "$NOW_HM" > "$STATE/lead" ;;
  esac
  render_locked
  [ "$1" = working ] || return 0
  # UserPromptSubmit: while work is in flight, one line keeps founder requests out of running agents.
  in_flight_rows
  local flight=$REPLY n=0
  if running_any; then n=$(ls "$STATE/running" | wc -l | tr -d ' '); fi
  [ -n "$flight" ] || [ "$n" -gt 0 ] || return 0
  printf '%s\n' "Crew: work is in flight (${flight:-no index row in progress}${flight:+; }${n} agent(s) running). Queue any request in this message first (.crew/bin/crew request \"<text>\"), then act on it; never add it to a running agent or edit a spec an agent is working from."
}

# SessionStart startup|resume|clear|fork: remember the lead's model (and effort when given) for
# this session, so a compaction's model can be checked against it. Runs before the session is
# registered, so it has no session guard and writes nothing else.
hook_session_start() {
  [ -n "$J_SESSION" ] && [ -n "$J_HOOK_MODEL" ] || return 0
  ensure_dirs
  safe_name "$J_SESSION"
  printf '%s %s\n' "$J_HOOK_MODEL" "$J_EFFORT_LVL" > "$STATE/lead-model/$REPLY" 2>/dev/null
  remember_transcript "$J_SESSION" "$J_TRANSCRIPT"
}

# PreCompact: guess who is compacting, leave a note for the SessionStart(compact) hook that
# follows, and print custom compaction instructions for that role.
hook_pre_compact() {
  ensure_dirs
  guess_compacting_agent
  now_parts
  printf '%s\n' "$NOW_EPOCH$TAB$G_KIND$TAB$G_ID$TAB$G_LABEL$TAB$G_MODEL$TAB${J_TRIGGER:-auto}" > "$STATE/compact/pending" 2>/dev/null
  compact_instructions "$G_KIND" "$G_ID"
}

# SessionStart compact: the post-compaction reminder, addressed to the role when it is known.
# The journal line and the compaction log follow at the next crew event (see the header).
hook_compact() {
  local kind=unknown id="" pe pk pid _rest alias spec=""
  ensure_dirs
  if [ -f "$STATE/compact/pending" ]; then
    now_parts
    IFS=$TAB read -r pe pk pid _rest < "$STATE/compact/pending"
    rm -f "$STATE/compact/pending"
    case $pe in *[!0-9]*|'') pe=0 ;; esac
    if [ $((NOW_EPOCH - pe)) -le 600 ]; then kind=$pk; id=$pid; fi
  fi
  if [ "$kind" = unknown ] && ! running_any; then kind=lead; fi
  # The compacting agent's model differs from the lead's: a subagent for sure.
  lead_model "$J_SESSION"
  if [ -n "$J_HOOK_MODEL" ] && [ -n "$LM_ALIAS" ]; then
    model_alias "$J_HOOK_MODEL"; alias=$REPLY
    if [ -n "$alias" ] && [ "$alias" != "$LM_ALIAS" ] && [ "$kind" != sub ]; then kind=sub; id=""; fi
  fi
  if [ "$kind" = lead ] && [ -z "$LM_MODEL" ] && [ -n "$J_HOOK_MODEL" ] && ! running_any; then
    safe_name "$J_SESSION"
    printf '%s %s\n' "$J_HOOK_MODEL" "$J_EFFORT_LVL" > "$STATE/lead-model/$REPLY" 2>/dev/null
  fi
  [ "$kind" != sub ] || { spec_path_for "$id"; spec=$REPLY; }
  compact_reminder "$kind" "$spec"
}

run_hook() {
  local mode=${1:-}
  case $mode in
    agent-start|agent-resume|agent-id|agent-stop|file-changed|lead-busy|lead-idle|compact|pre-compact|session-start) ;;
    *) return 0 ;;
  esac
  # Guard 1: this root is a crew project.
  [ -f "$ROOT/.crew/bin/crew" ] || return 0
  INPUT=""
  [ -t 0 ] || INPUT=$(cat 2>/dev/null)
  if ! command -v jq >/dev/null 2>&1; then
    hook_without_jq
    return 0
  fi
  read_hook_json || return 0
  if [ "$mode" = session-start ]; then hook_session_start; return 0; fi
  # Guard 2: a registered crew session (or the wildcard).
  session_registered "$J_SESSION" || return 0
  WRITER_CWD=$PWD
  if [ -n "$J_CWD" ] && [ -d "$J_CWD" ]; then WRITER_CWD=$J_CWD; fi
  remember_transcript "$J_SESSION" "$J_TRANSCRIPT"
  # Guard 3: per-mode checks live at the top of each handler.
  case $mode in
    agent-start) hook_agent_start ;;
    agent-resume) hook_agent_resume ;;
    agent-id) hook_agent_id ;;
    agent-stop) hook_agent_stop ;;
    file-changed) hook_file_changed ;;
    lead-busy) hook_lead working ;;
    lead-idle) hook_lead idle ;;
    pre-compact) hook_pre_compact ;;
    compact) hook_compact ;;
  esac
  # Compactions whose record has appeared since the last event get their journal line now.
  settle_compactions
  return 0
}

# ---------------------------------------------------------------------------
# Other subcommands
# ---------------------------------------------------------------------------

cmd_journal() {
  if [ $# -eq 0 ] || [ -z "$*" ]; then
    printf 'usage: crew journal <one line, past tense>\n' >&2
    return 1
  fi
  WRITER_CWD=$PWD
  settle_compactions
  journal_append "lead" "$*"
}

# queue_field TEXT -> REPLY: one line, with the " · " separator the queue format uses replaced.
queue_field() {
  oneline "$1"
  REPLY=${REPLY// · / - }
  REPLY=${REPLY//|/\/}
}

cmd_request() {
  local text="" affects="" slot="" status="" note="" urgent=0 dry=0 queue="$CREW_DIR/queue.md" n entry tmp line verb
  while [ $# -gt 0 ]; do
    case $1 in
      --affects) affects=${2:-}; shift ;;
      --slot) slot=${2:-}; shift ;;
      --status) status=${2:-}; shift ;;
      --note) note=${2:-}; shift ;;
      --urgent) urgent=1 ;;
      --dry-run) dry=1 ;;
      --*) printf 'crew request: unknown option %s\n' "$1" >&2; return 1 ;;
      *) text="${text:+$text }$1" ;;
    esac
    shift
  done
  WRITER_CWD=$PWD
  settle_compactions
  ensure_dirs
  now_parts
  if [ ! -f "$queue" ]; then
    printf '# Crew queue\n\n## Requests from the founder\n\n## Questions for the founder\n' > "$queue"
  fi
  case $text in
    R[0-9]*)
      # A transition: crew request R<n> --status <status> [--slot …] [--affects …] [--note …]
      case $status in queued|scheduled|done|dropped) ;; *) printf 'usage: crew request R<n> --status queued|scheduled|done|dropped [--slot <y>] [--affects <x>] [--note <text>]\n' >&2; return 1 ;; esac
      grep -q -E "^[[:space:]]*- \[$text\]" "$queue" || { printf 'crew request: no entry %s in %s\n' "$text" "$queue" >&2; return 1; }
      queue_field "$slot"; slot=$REPLY
      queue_field "$affects"; affects=$REPLY
      tmp="$queue.new"
      awk -v id="$text" -v st="$status" -v slot="$slot" -v aff="$affects" '
        !done && $0 ~ ("^[ \t]*- \\[" id "\\]") {
          if ($0 !~ /· status: /) $0 = $0 " · status: queued"
          sub(/· status: [A-Za-z]+/, "· status: " st)
          if (slot != "") {
            if ($0 ~ /· slot: /) sub(/· slot: [^·]*/, "· slot: " slot " "); else sub(/· status: /, "· slot: " slot " · status: ")
          }
          if (aff != "") {
            if ($0 ~ /· affects: /) sub(/· affects: [^·]*/, "· affects: " aff " "); else sub(/· slot: /, "· affects: " aff " · slot: ")
          }
          gsub(/  +·/, " ·"); done = 1
        }
        { print }' "$queue" > "$tmp" && mv -f "$tmp" "$queue"
      line=$(grep -m 1 -E "^[[:space:]]*- \[$text\]" "$queue")
      entry=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*- \[R[0-9]+\] [^·]*· //; s/ · affects:.*$//; s/ · slot:.*$//; s/ · status:.*$//')
      trunc "$entry" 60; entry=$REPLY
      case $status in
        scheduled) verb="Scheduled $text ($entry)${note:+ $note}" ;;
        done) verb="Done $text ($entry)${note:+: $note}" ;;
        dropped) verb="Dropped $text ($entry)${note:+: $note}" ;;
        *) verb="Re-queued $text ($entry)${note:+: $note}" ;;
      esac
      [ "$dry" = 1 ] || journal_append "lead" "$verb"
      printf '%s\n' "$line"
      return 0 ;;
  esac
  [ -n "$text" ] || { printf 'usage: crew request "<request in the founder'"'"'s words>" [--affects <x>] [--slot <y>] [--urgent] [--dry-run]\n' >&2; return 1; }
  [ -z "$status" ] || { printf 'crew request: --status applies to an existing R<n>\n' >&2; return 1; }
  # Next number: real entries only (the scaffold's format comment holds an example id).
  n=$(grep -E '^[[:space:]]*- \[R[0-9]+\]' "$queue" | grep -o -E '\[R[0-9]+\]' | tr -cd '0-9\n' | sort -n | tail -n 1)
  n=$((${n:-0} + 1))
  queue_field "$text"; text=$REPLY
  queue_field "$affects"; affects=$REPLY
  queue_field "$slot"; slot=$REPLY
  if [ -z "$slot" ]; then if [ "$urgent" = 1 ]; then slot="now (urgent)"; else slot="tbd"; fi; fi
  entry="- [R$n] $NOW_DAY · $text · affects: ${affects:-—} · slot: $slot · status: queued"
  if [ "$dry" = 1 ]; then printf '%s\n' "$entry"; return 0; fi
  tmp="$queue.new"
  # Urgent entries go first in the section, others after the last entry; an empty section gets
  # the entry after its heading (and after the format comment, when present).
  awk -v entry="$entry" -v urgent="$urgent" '
    { line[NR] = $0 }
    END {
      sec = 0; send = NR; first = 0; last = 0
      for (i = 1; i <= NR; i++) {
        if (!sec) { if (line[i] ~ /^## Requests from the founder/) sec = i; continue }
        if (line[i] ~ /^## /) { send = i - 1; break }
        if (line[i] ~ /^[ \t]*- \[R[0-9]+\]/) { if (!first) first = i; last = i }
      }
      if (!sec) {
        for (i = 1; i <= NR; i++) print line[i]
        print ""; print "## Requests from the founder"; print ""; print entry
        exit
      }
      if (urgent && first) { at = first - 1; before = 0 }
      else if (last) { at = last; before = 0 }
      else {
        at = sec
        while (at < send && line[at + 1] ~ /^<!--/) { at++; while (at < send && line[at] !~ /-->/) at++ }
        if (at < send && line[at + 1] ~ /^[ \t]*$/) at++
        before = 1
      }
      for (i = 1; i <= NR; i++) {
        print line[i]
        if (i == at) {
          if (before && line[i] !~ /^[ \t]*$/) print ""
          print entry
          if (before && (i == NR || line[i + 1] !~ /^[ \t]*$/)) print ""
        }
      }
      if (at == 0) { print entry }
    }' "$queue" > "$tmp" && mv -f "$tmp" "$queue"
  journal_append "lead" "Queued R$n: $text${slot:+, slot: $slot}"
  printf '%s\n' "$entry"
}

cmd_session() {
  local sid=${2:-}
  ensure_dirs
  case ${1:-} in
    start)
      lock_take
      if [ -n "$sid" ]; then safe_name "$sid"; sid=$REPLY; else sid=any; fi
      touch "$STATE/sessions/$sid"
      # Prune registrations (and per-session notes) older than 30 days.
      find "$STATE/sessions" "$STATE/lead-model" "$STATE/transcripts" -type f -mtime +30 -exec rm -f {} + 2>/dev/null
      rm -f "$STATE/lead" 2>/dev/null
      render_locked
      lock_release
      settle_compactions
      printf 'Crew session registered: %s\n' "$sid" ;;
    stop)
      lock_take
      now_parts
      # Sticky until the next `crew session start`; the hooks leave it alone.
      printf 'stopped %s\n' "$NOW_HM" > "$STATE/lead"
      render_locked
      lock_release
      printf 'Crew marked as stopped at %s\n' "$NOW_HM" ;;
    *) printf 'usage: crew session start [<session-id>] | crew session stop\n' >&2; return 1 ;;
  esac
}

cmd_running() {
  local f id n=0
  for f in "$STATE/running"/*; do
    [ -e "$f" ] || continue
    id=${f##*/}
    load_agent "$id" || A_TYPE=unknown
    printf '%s · %s (%s · %s) · %s · since %s\n' "$id" "$A_TYPE" "${A_MODEL:-default}" \
      "${A_EFFORT:-default}" "${A_DESC:-(no description)}" "${A_SINCE:-?}"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || printf 'No subagent running.\n'
}

cmd_status() {
  settle_compactions
  render_with_lock
  printf 'Rendered %s\n' "$STATUS"
}

# ---------------------------------------------------------------------------
# Worktrees (D-G5, D-G6)
# ---------------------------------------------------------------------------

DRY=0
# step DESCRIPTION COMMAND...: print the step, then run it (or only print on --dry-run).
step() {
  local d=$1
  shift
  if [ "$DRY" = 1 ]; then printf '  would: %s\n' "$d"; return 0; fi
  printf '  %s\n' "$d"
  "$@"
}

# shellcheck disable=SC2317  # invoked indirectly through step()
json_str() {
  REPLY=${1//\\/\\\\}
  REPLY=${REPLY//\"/\\\"}
}

# shellcheck disable=SC2317  # invoked indirectly through step()
write_worktree_json() {  # path main branch
  local p m b t
  json_str "$1"; p=$REPLY
  json_str "$2"; m=$REPLY
  json_str "$3"; b=$REPLY
  t=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  printf '{\n  "main_root": "%s",\n  "worktree": "%s",\n  "branch": "%s",\n  "started_at": "%s"\n}\n' \
    "$m" "$p" "$b" "$t" > "$1/.crew/tmp/worktree.json"
}

# shellcheck disable=SC2317  # invoked indirectly through step()
copy_missing() {  # src dest
  mkdir -p "$(dirname "$2")" && cp -Rp "$1" "$2"
}

# Expand the .worktreeinclude patterns in the main checkout; print matching relative paths.
worktreeinclude_matches() {  # main include-file
  local line pat m
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    pat=$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case $pat in ''|'#'*) continue ;; '!'*) printf 'skip-negation%s%s\n' "$US" "$pat"; continue ;; esac
    pat=${pat#/}; pat=${pat%/}
    [ -n "$pat" ] || continue
    (
      cd "$1" || exit 0
      IFS=$NL
      # Unquoted on purpose: the pattern may be a glob (for example .env*).
      # shellcheck disable=SC2086
      for m in $pat; do
        [ -e "$m" ] && printf 'match%s%s\n' "$US" "$m"
      done
    )
  done < "$2"
}

wt_setup() {
  local path=$1 main branch inc kind rel script rc=0 copied=0
  if [ -z "$path" ]; then
    path=$(git rev-parse --show-toplevel 2>/dev/null) || { printf 'crew worktree setup: not inside a git checkout; pass a path\n' >&2; return 1; }
  fi
  path=$(cd "$path" 2>/dev/null && pwd -P) || { printf 'crew worktree setup: no such directory: %s\n' "$1" >&2; return 1; }
  cd "$path" || return 1
  main=$(main_worktree_of "$path") || main=""
  branch=$(git -C "$path" symbolic-ref --short -q HEAD 2>/dev/null) || branch=$(git -C "$path" rev-parse --short HEAD 2>/dev/null)
  printf 'crew worktree setup%s: %s (branch %s; main checkout %s)\n' \
    "$([ "$DRY" = 1 ] && printf ' (dry run)')" "$path" "${branch:-none}" "${main:-unknown}"

  # 1. Copy the .worktreeinclude files that are missing here from the main checkout.
  if [ -n "$main" ] && [ "$main" != "$path" ]; then
    inc="$main/.worktreeinclude"; [ -f "$inc" ] || inc="$path/.worktreeinclude"
    if [ -f "$inc" ]; then
      while IFS=$US read -r kind rel; do
        [ -n "$kind" ] || continue
        if [ "$kind" = skip-negation ]; then printf '  skip %s (negated patterns are not supported)\n' "$rel"; continue; fi
        [ -e "$path/$rel" ] && continue
        step "copy $rel from the main checkout" copy_missing "$main/$rel" "$path/$rel" || rc=1
        copied=$((copied + 1))
      done <<EOF
$(worktreeinclude_matches "$main" "$inc")
EOF
      [ "$copied" -gt 0 ] || printf '  .worktreeinclude: nothing missing\n'
    else
      printf '  no .worktreeinclude; nothing to copy\n'
    fi
  else
    printf '  this is the main checkout; nothing to copy\n'
  fi

  # 2. Scratch and task-data directories.
  step "create .crew/tmp/ and .crew/task-data/" mkdir -p "$path/.crew/tmp" "$path/.crew/task-data" || rc=1

  # 3. worktree.json for scripts that need to know where they are.
  step "write .crew/tmp/worktree.json" write_worktree_json "$path" "${main:-$path}" "$branch" || rc=1

  # 4. The project's own setup.
  script="$path/.crew/worktree/setup.sh"
  [ -f "$script" ] || { [ -n "$main" ] && script="$main/.crew/worktree/setup.sh"; }
  if [ -f "$script" ]; then
    if ! step "run .crew/worktree/setup.sh $path" "${BASH:-bash}" "$script" "$path"; then
      printf 'crew worktree setup: .crew/worktree/setup.sh failed\n' >&2
      return 1
    fi
  else
    printf '  no .crew/worktree/setup.sh; skipping project setup\n'
  fi
  [ "$rc" = 0 ] && printf 'crew worktree setup: %s\n' "$([ "$DRY" = 1 ] && printf 'dry run, nothing changed' || printf 'ready')"
  return "$rc"
}

# Copy <wt>/.crew/task-data/ into the main checkout: merge per-task dirs, newer file wins.
# shellcheck disable=SC2317  # invoked indirectly through step()
harvest_task_data() {  # src dest
  local rel n=0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    rel=${rel#./}
    if [ ! -e "$2/$rel" ] || [ "$1/$rel" -nt "$2/$rel" ]; then
      mkdir -p "$(dirname "$2/$rel")" && cp -p "$1/$rel" "$2/$rel" && n=$((n + 1))
    fi
  done <<EOF
$(cd "$1" 2>/dev/null && find . -type f)
EOF
  printf '    %s file(s) copied\n' "$n"
}

# Append the event lines of a worktree-local journal to the main journal, with the actor
# suffixed [<branch>]; lines from earlier days carry their date.
# shellcheck disable=SC2317  # invoked indirectly through step()
harvest_journal() {  # wt-journal branch
  local lines
  ensure_dirs
  lock_take
  now_parts
  lines=$(awk -v today="$NOW_DAY" -v sfx=" [$2]" '
    /^## [0-9][0-9][0-9][0-9]-/ { d = substr($0, 4); next }
    /^- / {
      rest = substr($0, 3); i = index(rest, " · ")
      if (i == 0) { print $0 sfx; next }
      time = substr(rest, 1, i - 1); rest = substr(rest, i + 4)
      j = index(rest, " · ")
      if (j == 0) { actor = rest; text = "" } else { actor = substr(rest, 1, j - 1); text = substr(rest, j) }
      if (index(actor, sfx) == 0) actor = actor sfx
      if (d != "" && d != today) time = d " " time
      print "- " time " · " actor text
    }' "$1")
  if [ -n "$lines" ]; then
    journal_open_today
    printf '%s\n' "$lines" >> "$JOURNAL"
    printf '    %s line(s) appended\n' "$(printf '%s\n' "$lines" | wc -l | tr -d ' ')"
  else
    printf '    no journal lines\n'
  fi
  lock_release
}

wt_teardown() {
  local path=$1 abs wt wtb listed="" branch="" p rc=0 script
  if [ -z "$path" ]; then
    printf 'usage: crew worktree teardown <path> [--dry-run]\n' >&2
    return 1
  fi
  case $path in /*) abs=$path ;; *) abs="$PWD/$path" ;; esac
  [ -d "$abs" ] && abs=$(cd "$abs" && pwd -P)
  if [ "$abs" = "$ROOT" ]; then
    printf 'crew worktree teardown: refusing to remove the main checkout\n' >&2
    return 1
  fi
  while IFS=$US read -r wt wtb; do
    [ -n "$wt" ] || continue
    p=$wt; [ -d "$wt" ] && p=$(cd "$wt" && pwd -P)
    if [ "$p" = "$abs" ] || [ "$wt" = "$abs" ]; then listed=$wt; branch=$wtb; break; fi
  done <<EOF
$(list_worktrees)
EOF
  if [ -z "$listed" ]; then
    printf 'crew worktree teardown: %s is not a worktree of %s\n' "$path" "$ROOT" >&2
    return 1
  fi
  printf 'crew worktree teardown%s: %s (branch %s)\n' "$([ "$DRY" = 1 ] && printf ' (dry run)')" "$listed" "${branch:-none}"

  # 1. Harvest task data and worktree-local journal lines (D-G6).
  if [ -d "$abs/.crew/task-data" ]; then
    step "copy .crew/task-data/ into the main checkout (newer file wins)" \
      harvest_task_data "$abs/.crew/task-data" "$CREW_DIR/task-data" || rc=1
  else
    printf '  no task data in the worktree\n'
  fi
  if [ -f "$abs/.crew/journal.md" ] && [ "$abs/.crew/journal.md" != "$JOURNAL" ]; then
    step "append the worktree's journal lines to the main journal" \
      harvest_journal "$abs/.crew/journal.md" "${branch:-detached}" || rc=1
  fi

  # 2. The project's own teardown.
  script="$CREW_DIR/worktree/teardown.sh"
  if [ -f "$script" ] && [ -d "$abs" ]; then
    if ! step "run .crew/worktree/teardown.sh $listed" "${BASH:-bash}" "$script" "$abs"; then
      printf 'crew worktree teardown: teardown.sh failed; continuing with the removal\n' >&2
      rc=1
    fi
  fi

  # 3. Remove the worktree, unlocking it if git refuses, then delete its branch.
  if [ -d "$abs" ]; then
    if ! step "git worktree remove --force $listed" git -C "$ROOT" worktree remove --force "$listed" 2>/dev/null; then
      step "git worktree unlock $listed" git -C "$ROOT" worktree unlock "$listed" 2>/dev/null
      step "git worktree remove --force $listed" git -C "$ROOT" worktree remove --force "$listed" || rc=1
    fi
  else
    step "git worktree prune (the directory is already gone)" git -C "$ROOT" worktree prune || rc=1
  fi
  if [ -n "$branch" ]; then
    step "git branch -D $branch" git -C "$ROOT" branch -D "$branch" || rc=1
  fi
  [ "$DRY" = 1 ] || render_with_lock
  if [ "$rc" = 0 ]; then
    printf 'crew worktree teardown: %s\n' "$([ "$DRY" = 1 ] && printf 'dry run, nothing changed' || printf 'done')"
  fi
  return "$rc"
}

cmd_worktree() {
  local sub=${1:-} path="" a
  [ $# -gt 0 ] && shift
  for a in "$@"; do
    case $a in
      --dry-run) DRY=1 ;;
      -*) printf 'crew worktree: unknown option %s\n' "$a" >&2; return 1 ;;
      *) path=$a ;;
    esac
  done
  case $sub in
    setup) wt_setup "$path" ;;
    teardown) wt_teardown "$path" ;;
    *) printf 'usage: crew worktree setup [<path>] [--dry-run] | crew worktree teardown <path> [--dry-run]\n' >&2; return 1 ;;
  esac
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

resolve_root
set_paths

case ${1:-} in
  hook)
    # Silent unless debugging; always exit 0.
    [ -n "${CREW_DEBUG:-}" ] || exec 2>/dev/null
    shift
    run_hook "$@"
    lock_release
    exit 0
    ;;
  journal) shift; cmd_journal "$@"; rc=$? ;;
  request) shift; cmd_request "$@"; rc=$? ;;
  session) shift; cmd_session "$@"; rc=$? ;;
  running) cmd_running; rc=$? ;;
  status) cmd_status; rc=$? ;;
  worktree) shift; cmd_worktree "$@"; rc=$? ;;
  help|-h|--help) usage; rc=0 ;;
  *) usage >&2; rc=1 ;;
esac
lock_release
exit "$rc"
